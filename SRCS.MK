WSMOKE_RC := TEST/WSMOKE.RC
WSMOKE_WINPASS := ^WSMOKE PASS

# Unit tests built as Windows programs: WENGINE and WPROTO are T_ENGINE
# and T_PROTO, T_WCOMP the test of the Windows variants of SRC/COMPAT/.
# Each runs from the WinMain of TEST/WTEST.C, which writes what the test
# prints into NAME.OUT; TEST/WTESTE.RC, the script of those that link the
# engine or its schema reader, holds the schema data.
WENGINE_MODEL := m
WENGINE_SRCS := $(T_ENGINE_SRCS) SRC/COMPAT/CTIMER.C TEST/WTEST.C
WENGINE_RC := TEST/WTESTE.RC
WENGINE_WINPASS := ^T_ENGINE PASS [0-9]

WPROTO_MODEL := m
WPROTO_SRCS := $(T_PROTO_SRCS) SRC/COMPAT/CTIMER.C TEST/WTEST.C
WPROTO_RC := TEST/WTESTE.RC
WPROTO_WINPASS := ^T_PROTO PASS [0-9]
WPROTO_WINDATA := $(T_PROTO_SCRIPTS)
WPROTO_WINDIR := PDATA
# DOS takes "/" for "\", which would end the line here.
WPROTO_WINARGS := PDATA/
WPROTO_WINTIME := 900

T_WCOMP_MODEL := m
T_WCOMP_SRCS := SRC/COMPAT/T_WCOMP.C SRC/COMPAT/CMEM.C \
	SRC/COMPAT/CTIMER.C SRC/COMPAT/CTEXT.C SRC/COMPAT/CDOS.C \
	SRC/COMPAT/CPRNW.C SRC/ENGINE/SCHEMA.C SRC/COMPAT/CSCHEMA.C \
	SRC/COMPAT/CSCHDAT.C TEST/WTEST.C
T_WCOMP_RC := TEST/WTESTE.RC
T_WCOMP_WINPASS := ^T_WCOMP PASS [0-9]
# The printer driver it prints a job on, for its expanded pitch.
T_WCOMP_WINDATA := OBJ/WINDRV/EPSON9.DRV
# What its job on the test machine's printer prints.
T_WCOMP_WINPRN := TEST/GOLDEN/WIN/T_WCOMP.PRN

# WTDRV, the test of the Windows programs' test driver SRC/WIN/TDRV.C.
WTDRV_MODEL := m
WTDRV_SRCS := TEST/WTDRV.C SRC/WIN/TDRV.C SRC/WIN/WCOLS.C SRC/COMPAT/CDOS.C \
	SRC/COMPAT/CTEXT.C SRC/COMPAT/CMEM.C
WTDRV_RC := TEST/WTDRV.RC
# Its scripts: the main one, P, run with /PLACE, the driver's check
# of where dialogs open, which the main window's place fails, and D, a
# script refused, run with /DROP, which loses the quit of the driver.
WTDRV_WINKEYS := - P D
WTDRV_WINARGSP := /PLACE
WTDRV_WINARGSD := /DROP

# WTDRV2, a second proof of the driver, from its header alone.
WTDRV2_MODEL := m
WTDRV2_SRCS := TEST/WTDRV2.C SRC/WIN/TDRV.C SRC/WIN/WCOLS.C \
	SRC/COMPAT/CDOS.C SRC/COMPAT/CTEXT.C SRC/COMPAT/CMEM.C
WTDRV2_RC := TEST/WTDRV2.RC
# Its scripts: the main one, the format cases and the failures of
# SRC/WIN/TDRV.H; T, the driver finding no timer free, runs with /HOG,
# which takes every timer first; M, the mouse lines, with /MOUSE, which
# adds the pads they click and drag, and Q, their SHIFT-, CTRL- and ALT-
# prefixes, with /MOUSE too; H, I, J, R and S mouse lines refused, N, O
# and P mouse lines whose window or place is not there, X one after the
# program has ended; K a P line refused after an S line; U and V the E
# line, found by td_ahead while the window is busy and reached idle; 1
# the C line, with /BLANK, which adds the row it reports BLANK.
WTDRV2_WINKEYS := - A B C D E F G L T W Y Z H I J M N O P X Q R S K U V 1
WTDRV2_WINARGST := /HOG
WTDRV2_WINARGSM := /MOUSE
WTDRV2_WINARGSQ := /MOUSE
WTDRV2_WINARGS1 := /BLANK

