# Source lists per executable.  Read by MAKEFILE and by the batch
# generators of the Turbo C, Watcom C 6.5 and Watcom C 9.5 builds, so keep
# the format plain: "NAME_VAR := words", continuation lines ending in a
# backslash, comments starting with '#'.  A value, and a name, may use
# "$(VAR)" references to variables defined above it (the generators expand
# them as make does); no other make syntax.  Paths use '/' and are
# relative to the repository root (the C: drive inside DOS).
#
# NAME_MODEL is the memory model letter (s small, m medium).
# A DOS program's list that has SRC/COMPAT/CMEM.C has one near-heap
# module too: SRC/COMPAT/CMEMHN.C, CMEMHT.C for a program on the TCP
# stack, CMEMHI.C for INV, CMEMHR.C for THIN.  A Windows program has none
# (COMPAT.H, cmem_init).
# NAME_MAXNEAR, when set, gives TEST/mapchk.sh the program's near data
# budget in bytes (by default MAX_NEAR of mapchk.sh).
# Files under SRC/COMPAT/ are compiled without the strict-ANSI switch,
# except those of COMPAT_PORTABLE.
#
# The module groups and the lists of programs and tests come first, then
# one block per program in EXES order, one per DOS unit test in DOS_TESTS
# order and one per Windows program in WIN_EXES order, each holding every
# setting of its program or test.

# Module groups shared by many lists below, each in the order the lists
# link them.
ENG_CORE := SRC/ENGINE/SCHEMA.C SRC/COMPAT/CSCHEMA.C SRC/COMPAT/CSCHDAT.C \
	SRC/ENGINE/TABLES.C SRC/ENGINE/IDGEN.C \
	SRC/ENGINE/AUDIT.C SRC/ENGINE/CURSOR.C SRC/ENGINE/EDIT.C SRC/ENGINE/USERS.C \
	SRC/ENGINE/CODES.C SRC/ENGINE/LOCS.C SRC/ENGINE/ITEMS.C SRC/ENGINE/ASSY.C \
	SRC/ENGINE/MAINT.C SRC/ENGINE/LOANS.C SRC/ENGINE/CSV.C \
	SRC/ENGINE/INITDATA.C SRC/ENGINE/ADMIN.C

DBF_CORE := SRC/DBF/DBF.C SRC/DBF/DBT.C SRC/DBF/NDX.C \
	SRC/DBF/KEYEXPR.C SRC/DBF/PACK.C SRC/COMPAT/CZERO.C SRC/COMPAT/CTEXT.C

PROTO_CORE := SRC/PROTO/TOKEN.C SRC/PROTO/RESPONSE.C SRC/PROTO/SESSION.C \
	SRC/PROTO/DISPATCH.C SRC/PROTO/DPSESS.C SRC/PROTO/DPUSER.C \
	SRC/PROTO/DPITEM.C SRC/PROTO/DPLOC.C SRC/PROTO/DPASSY.C \
	SRC/PROTO/DPMAINT.C SRC/PROTO/DPLOAN.C SRC/PROTO/DPCSV.C \
	SRC/PROTO/DPADMIN.C

# The client of SRC/CLIENT/INV.C, its screens and its remote links, but
# not its LOCAL backend: INV links it with SRC/CLIENT/INVLOC.C,
# SRC/CLIENT/LINKLOC.C and the engine, THIN with SRC/CLIENT/INVNOL.C and
# SRC/CLIENT/LINKNOL.C in their place.  Each program links its near-heap
# module (CMEMHI.C, CMEMHR.C) between the two parts: INV_CLIENT, the
# program, the protocol link and its NET backend (LINK.C, LINKNET.C), the
# screens, reports and printing, and SRC/COMPAT/CMEM.C; INV_DEVICES, the
# screen, keyboard, mouse, timer and printer port modules, NetBIOS, the
# serial switches and backend (INVCOM.C, LINKSER.C, SERCLI.C, CUART.C) and
# the response reader RESPRD.C.
INV_CLIENT := SRC/CLIENT/INV.C SRC/CLIENT/LINK.C SRC/CLIENT/LINKNET.C \
	SRC/CLIENT/ARGS.C SRC/CLIENT/INVMENU.C SRC/CLIENT/MSG.C \
	SRC/CLIENT/RQ.C SRC/CLIENT/TUI.C SRC/CLIENT/LISTV.C \
	SRC/CLIENT/RQERR.C SRC/CLIENT/PAGER.C SRC/CLIENT/FORM.C \
	SRC/CLIENT/MEMO.C SRC/CLIENT/MEMOIO.C SRC/CLIENT/KEYSCR.C \
	SRC/CLIENT/FMODEL.C SRC/CLIENT/SESS.C SRC/CLIENT/CFG.C \
	SRC/CLIENT/SCRLOGIN.C SRC/CLIENT/SCRITEM.C SRC/CLIENT/ITEMLS.C \
	SRC/CLIENT/SCRIFORM.C SRC/CLIENT/SCRLFORM.C SRC/CLIENT/SCRMFORM.C \
	SRC/CLIENT/SCRNFORM.C SRC/CLIENT/SCRSFORM.C SRC/CLIENT/SCRAFORM.C \
	SRC/CLIENT/SCRLOC.C SRC/CLIENT/SCRCODE.C SRC/CLIENT/SCRKFORM.C \
	SRC/CLIENT/CODETAB.C SRC/CLIENT/SCRPICK.C SRC/CLIENT/SCRSRCH.C \
	SRC/CLIENT/SCRSET.C \
	SRC/CLIENT/SCRPASS.C SRC/CLIENT/SCRUSER.C SRC/CLIENT/SCRADMIN.C \
	SRC/CLIENT/SCRZFORM.C SRC/CLIENT/SCRMAINT.C SRC/CLIENT/SCRASSY.C \
	SRC/CLIENT/SCRLOAN.C SRC/CLIENT/SCRRPT.C SRC/CLIENT/SCRRFORM.C \
	SRC/CLIENT/SCRCSV.C SRC/CLIENT/SCRCFORM.C SRC/CLIENT/RPT.C \
	SRC/CLIENT/RPTRUN.C SRC/CLIENT/PRINT.C SRC/COMPAT/CMEM.C
INV_DEVICES := SRC/COMPAT/CVIDEO.C SRC/COMPAT/CKEY.C \
	SRC/COMPAT/CMOUSE.C SRC/COMPAT/CTIMER.C SRC/COMPAT/CPRN.C \
	SRC/CLIENT/NBCLI.C SRC/CLIENT/RESPRD.C SRC/COMPAT/CNBNAME.C \
	SRC/COMPAT/CNETB.C SRC/COMPAT/CNBDRAIN.C SRC/CLIENT/INVCOM.C \
	SRC/CLIENT/LINKSER.C SRC/CLIENT/SERCLI.C SRC/COMPAT/CUART.C

# The login tickets' commands and the engine's ticket calls, which only
# the programs that serve a mailbox, and their tests, link.
TICKET_CORE := SRC/PROTO/DPTKT.C SRC/ENGINE/USERTK.C

# The TCP bridge and the modules it calls, without the TCP stack and the
# NetBIOS provider beneath it, which each program links its own of.
BRIDGE_CORE := SRC/TCP/BRIDGE.C SRC/COMPAT/CNBNAME.C SRC/COMPAT/CMEM.C \
	SRC/COMPAT/CTIMER.C SRC/COMPAT/CTEXT.C SRC/COMPAT/CDOS.C

# SRC/COMPAT/CTEXT.C, the txt_ text helpers, and SRC/COMPAT/CZERO.C,
# cf_zero, are linked only into the lists whose sources call them.

# The sources under SRC/COMPAT/ that are portable C89: every build compiles
# and lints them with the strict rules of the code outside SRC/COMPAT/.
COMPAT_PORTABLE := SRC/COMPAT/CTEXT.C SRC/COMPAT/CNBNAME.C SRC/COMPAT/CRUN.C \
	SRC/COMPAT/CNBDRAIN.C SRC/COMPAT/CZERO.C

# WATTCP (DOC/BUILD.md): its kernel modules, which make prepares into
# WATTCP_DIR from the archive (the modules of the KERNEL list of
# SRC/TCP/WATPREP.PY, which make lint checks this list against), and our
# sources that include its headers, which TEST/lint.py lets no other
# source do.  Both are built with WATTCP's byte packing and signed char
# and without the strict-ANSI switch, the kernel modules also without
# warnings.  A list that links the kernel links all of it.
WATTCP_DIR := OBJ/WATTCP
WATTCP_KERNEL := $(WATTCP_DIR)/SRC/PCARP.C $(WATTCP_DIR)/SRC/PCBSD.C \
	$(WATTCP_DIR)/SRC/PCBUF.C $(WATTCP_DIR)/SRC/PCCONFIG.C \
	$(WATTCP_DIR)/SRC/PCICMP.C $(WATTCP_DIR)/SRC/PCSED.C \
	$(WATTCP_DIR)/SRC/PCTCP.C $(WATTCP_DIR)/SRC/UDP_NDS.C
WATTCP_USERS := SRC/TCP/TSWAT.C SRC/COMPAT/CPKT.C SRC/COMPAT/CWATT.C \
	SRC/COMPAT/T_CWATT.C

# The near data budget of INVTCP and of every other program on WATTCP,
# whose sockets and packet buffers must sit in DGROUP; those that link
# CMEM.C take the near heap of SRC/COMPAT/CMEMHT.C.
INVTCP_MAXNEAR := 40960

# The network-only client: INV built without the engine, the dispatcher
# and the DBF layer, for the stations that reach INVSERV over NET or a
# serial line.  Its name is set here.  SRC/CLIENT/INVNOL.C repeats it in
# both usage lines and in inv_tag (TEST/T_INV.SH checks that they do), and
# README.md, DOC/INSTALL.md and DOC/CLIENT.md name the program for their
# readers ("make lint" checks the first two, NAME_LINT_FILES of MAKEFILE);
# everything else, in this file and outside it, says $(THIN).
THIN := INVTHIN

# Executables built by Open Watcom ("make all").
EXES := NBTEST INVTEST INVDUMP DBPACK COMTEST INSTALL INV $(THIN) INVSERV \
	TCPTEST INVTCP

# Host test programs built by gcc and run by "make test".  Each is built
# from its NAME_SRCS; a test built only for the host has no NAME_SRCS and
# lists its sources in NAME_HOST instead.  NAME_HOSTARGS and NAME_HOSTRC
# give the arguments and the exit status the run must produce (default
# 0); NAME_HOSTCWD, when set, is the directory it runs in.  A test that
# creates files takes a scratch directory as its argument, each its own,
# since "make test" runs the tests side by side.
HOST_TESTS := T_COMPAT T_CRUN NBTEST T_CFILE T_CTEXT T_DBF T_DBT T_NDX T_KEYEX \
	T_PACK T_TOKEN T_TABLES T_USERS T_ENGINE T_PROTO T_CURSOR T_EDIT INV \
	$(THIN) T_OPENFT T_CMEM T_VIDEO T_DOSX T_MSG T_RQ T_RQERR T_ARGS \
	T_ARGST T_MENU T_SESS T_CFG T_TUI T_PAGER T_ITEMLS T_CODETB T_MEMOIO \
	T_LISTV T_FORM T_FMODEL T_SCRE T_ASSY T_MAINT T_LOAN T_HEAL \
	T_PRINT T_CSV T_CSVF T_RPT T_RRUN T_SCRR T_SRVCFG T_CONN T_FAKENB \
	T_FAKEU T_TSFAKE T_TNETB T_TSER T_NBCLI T_SERCLI T_LINKS T_NBNONE \
	INVTEST INVUSAGE INVNOSRV T_INVTST T_LINKN T_LINKT T_SRVSCR T_NETE \
	T_SERE T_MBXE T_INVSRV INVSERV SRVUSAGE SRVHELP SRVNOCFG SRVTWOCF SRVBADCF \
	T_BRIDGE T_INVTCP T_TCPE T_ADMIN T_TMBX T_MBXCLI T_NBDRN T_TICKET \
	T_LINKM COMTEST T_MOUSE T_NOLOC T_SCHBIN T_PGSV T_INTL \
	T_FFID T_KEYSET INSTALL T_INST T_SETUP T_LZEXP
# Host tests given BIN/ (where the built INV.MSG is) as an argument.
MSG_TESTS := T_MSG T_RQERR T_MENU T_TUI T_ITEMLS T_LISTV T_FORM T_SCRE T_RPT \
	T_RRUN T_SCRR
# Host tests whose malloc calls TESTFW.H's TF_MALLOC section can fail,
# and T_LINKM, which wraps malloc and free itself.
MALLOC_TESTS := T_NDX T_PRINT T_RPT T_RRUN T_CONN T_FAKENB T_TNETB T_TSER \
	T_NBCLI T_SERCLI T_LINKS T_NBNONE T_BRIDGE T_FORM T_FMODEL T_SCRE \
	T_SCRR T_TMBX T_ADMIN T_LINKT T_LINKM

# Message sources built into BIN/INV.MSG (and checked by TEST/msgchk.py).
INV_MSGS := SRC/CLIENT/TUI.MSG SRC/CLIENT/KEYSCR.MSG SRC/CLIENT/LISTV.MSG \
	SRC/CLIENT/FORM.MSG SRC/CLIENT/MEMO.MSG SRC/CLIENT/INVMENU.MSG \
	SRC/CLIENT/SCRLOGIN.MSG SRC/CLIENT/SCRITEM.MSG SRC/CLIENT/SCRLOC.MSG \
	SRC/CLIENT/SCRADMIN.MSG SRC/CLIENT/SCRSRCH.MSG SRC/CLIENT/SCRCODE.MSG \
	SRC/CLIENT/SCRSET.MSG SRC/CLIENT/SCRVERB.MSG SRC/CLIENT/SCRPASS.MSG \
	SRC/CLIENT/SCRUSER.MSG \
	SRC/CLIENT/SCRMAINT.MSG SRC/CLIENT/SCRASSY.MSG SRC/CLIENT/SCRLOAN.MSG \
	SRC/CLIENT/SCRNFORM.MSG SRC/CLIENT/RPT.MSG SRC/CLIENT/SCRRPT.MSG \
	SRC/CLIENT/SCRCSV.MSG
# Message sources built into BIN/INVSERV.MSG, with the same stamp.
SRV_MSGS := SRC/SERVER/INVSERV.MSG

# DOS unit tests, built by Open Watcom into BIN/TEST/ and run by "make
# dostest" under DOSBox-X and on MS-DOS 3.10, with the settings
# <NAME>_DOS... that DOC/BUILD.md describes.  A test's <NAME>_DOSDATA
# files are copied next to it (and, on MS-DOS 3.10, onto its boot floppy
# and the scratch hard disk it runs from); a test with no file argument
# looks for its data in its own directory.
DOS_TESTS := T_CFILE T_CTEXT T_DBF T_DBT T_NDX T_KEYEX T_PACK T_TOKEN \
	T_TABLES T_USERS T_ENGINE T_PROTO T_CURSOR T_EDIT T_OPENFT T_CMEM \
	T_VIDEO T_DOSX T_MSG T_RQ T_RQERR T_ARGS T_MENU T_SESS T_CFG T_TUI \
	T_ITEMLS T_CODETB T_MEMOIO T_LISTV T_FORM T_SCRE \
	T_ASSY T_MAINT T_LOAN T_HEAL T_PRINT T_PRN T_CSV T_CSVF T_RPT T_SCRR T_DTA \
	T_CLOCK T_SRVCFG T_CONN T_FAKENB T_FAKEU T_TSFAKE T_TNETB T_TSER \
	T_NBCLI T_SERCLI T_LINKS T_NBNONE T_INVTST T_LINKN T_SRVSCR T_NETE \
	T_SERE T_MBXE T_INVSRV T_BRIDGE T_INVTCP T_TCPE T_CWATT T_ADMIN \
	T_TMBX T_MBXCLI T_UART T_NBDRN T_TICKET T_MOUSE T_NHEAP T_NHEAPG \
	T_MSGLO T_LZEXP

# The tests whose runs take longest, longest first, under DOSBox-X and on
# MS-DOS 3.10 (T_INV and T_SCR naming TEST/T_INV.SH and TEST/T_SCR.SH);
# their runs start before the others.
DOSBOX_LONG_TESTS := T_HEAL T_INV T_SCRE T_EDIT T_SCR
DOS_LONG_TESTS := T_HEAL T_OPENFT T_EDIT T_PACK T_TABLES T_NDX T_SCR \
	T_CURSOR T_ASSY

# Run once more on MS-DOS 3.10 with SHARE loaded and the argument SHARE.
DOS_SHARE_TESTS := T_CFILE T_TABLES

# The run cache (MAKEFILE) never stands in for the runs of these tests,
# nor for those of the DOSSERIAL tests: their result can change between
# two runs of the same files.  T_CLOCK races the timer interrupt, and
# the bytes of T_UART and of COMTEST's run of kind com race the serial
# port's.
DOS_NOCACHE_TESTS := T_CLOCK T_UART COMTEST

# Executables built by Turbo C 2.01 ("make tc"), the DOS unit tests
# included so every test also compiles under the period compilers.
TC_EXES := $(EXES) $(DOS_TESTS)

# Executables built by Watcom C 6.5 ("make wc65"), each in the memory
# model of its NAME_MODEL.
WC65_EXES := $(TC_EXES)

# Windows programs, built by Open Watcom for Win16 into BIN/WIN/ ("make
# all"), each from its NAME_SRCS in the memory model of its NAME_MODEL,
# with the resources of its script NAME_RC bound in.  The Turbo C and
# Watcom C 6.5 builds take only the programs of TC_EXES and WC65_EXES.
WIN_EXES := INVWIN WSMOKE WENGINE WPROTO T_WCOMP WTDRV WTDRV2 WLISTT WSOCKT \
	WFORMT WSERT WNET WSKT WTABT WCHRT WSETUP

# Windows programs built as those of WIN_EXES are ("make all"), that
# "make wintest" runs only through the test that drives each: SETUP,
# INVWIN's installer, through WSETUP.
WIN_TOOLS := SETUP

# Windows programs built by Watcom C 9.5 too ("make wc95"), into BIN/WC95/,
# each as the Open Watcom build makes it.
WC95_EXES := INVWIN

# "make wintest" runs every program of WIN_EXES in standard and 386
# enhanced mode on the Windows 3.0 test machine, with the settings
# <NAME>_WIN... that DOC/BUILD.md describes.  The programs whose runs
# take longest, longest first; their runs start before the others.
WIN_LONG_TESTS := WPROTO WENGINE INVWIN

NBTEST_MODEL := s
NBTEST_SRCS := SRC/TOOLS/NBTEST.C \
	SRC/COMPAT/CNETB.C \
	SRC/COMPAT/CNBDRAIN.C \
	SRC/COMPAT/CMEM.C \
	SRC/COMPAT/CMEMHN.C \
	SRC/COMPAT/CKEY.C \
	SRC/COMPAT/CTIMER.C \
	SRC/COMPAT/CEXIT.C \
	SRC/COMPAT/CTEXT.C \
	SRC/COMPAT/CDOS.C
# Without a NetBIOS provider NBTEST must report "not present" (exit 2);
# TEST/T_TOOLS.SH checks the rest of its command line there.
NBTEST_HOSTARGS := SERVER X
NBTEST_HOSTRC := 2

INVTEST_MODEL := s
INVTEST_SRCS := SRC/TOOLS/INVTEST.C \
	SRC/TOOLS/INVSCR.C \
	SRC/CLIENT/NBCLI.C SRC/CLIENT/SERCLI.C SRC/CLIENT/MBXCLI.C \
	SRC/CLIENT/RESPRD.C SRC/COMPAT/CNBNAME.C \
	SRC/COMPAT/CNETB.C \
	SRC/COMPAT/CNBDRAIN.C \
	SRC/COMPAT/CUART.C \
	SRC/COMPAT/CMEM.C \
	SRC/COMPAT/CMEMHN.C \
	SRC/COMPAT/CKEY.C \
	SRC/COMPAT/CTIMER.C \
	SRC/COMPAT/CEXIT.C \
	SRC/COMPAT/CZERO.C \
	SRC/COMPAT/CTEXT.C \
	SRC/COMPAT/CDOS.C
# INVTEST likewise exits with 2 before it reads its script; INVUSAGE,
# the same program, exits with 1 for a usage error, and INVNOSRV, given
# no server, does not look for NetBIOS and exits with 1 for the missing
# script.
INVTEST_HOSTARGS := RISRV NONE.SCR
INVTEST_HOSTRC := 2
INVUSAGE_HOST := $(INVTEST_SRCS)
INVUSAGE_HOSTRC := 1
INVNOSRV_HOST := $(INVTEST_SRCS)
INVNOSRV_HOSTARGS := - NONE.SCR
INVNOSRV_HOSTRC := 1

INVDUMP_MODEL := s
INVDUMP_SRCS := SRC/TOOLS/INVDUMP.C \
	SRC/TOOLS/TOOLSUP.C \
	SRC/DBF/DBF.C \
	SRC/DBF/DBT.C \
	SRC/COMPAT/CZERO.C \
	SRC/COMPAT/CTEXT.C \
	SRC/COMPAT/CDOS.C

DBPACK_MODEL := s
DBPACK_SRCS := SRC/TOOLS/DBPACK.C \
	SRC/TOOLS/TOOLSUP.C \
	SRC/DBF/PACK.C \
	SRC/DBF/NDX.C \
	SRC/DBF/KEYEXPR.C \
	SRC/DBF/DBF.C \
	SRC/DBF/DBT.C \
	SRC/COMPAT/CZERO.C \
	SRC/COMPAT/CTEXT.C \
	SRC/COMPAT/CDOS.C

# COMTEST, the serial port test, must report on the host, which has no
# ports, that COM1 cannot be opened (exit 2); TEST/T_TOOLS.SH checks the
# rest of its command line there.  On MS-DOS 3.10, in its DOS run of kind
# com in MAKEFILE, a 16550A as COM2 must pass the test at the highest
# rate with flow control.
COMTEST_MODEL := s
COMTEST_SRCS := SRC/TOOLS/COMTEST.C SRC/TOOLS/PORTCHK.C SRC/COMPAT/CUART.C \
	SRC/COMPAT/CUARTSV.C SRC/COMPAT/CMEM.C SRC/COMPAT/CMEMHN.C \
	SRC/COMPAT/CTIMER.C SRC/COMPAT/CTEXT.C SRC/COMPAT/CDOS.C
COMTEST_HOSTRC := 2
COMTEST_COMARGS := /COM2 /BAUD:38400 /RTSCTS
COMTEST_COMPASS := ^COMTEST 38400 baud, RTS/CTS: 256 bytes back in order

# INSTALL, the installer of the release disks.  Its run here checks that
# a bad command line is a usage error (1) before anything is asked;
# T_INST tests its decisions, INSTPLAN.C, on the host, and
# REL/distchk.sh installs with it from the disks.
INSTALL_MODEL := s
INSTALL_SRCS := SRC/TOOLS/INSTALL.C SRC/TOOLS/INSTPLAN.C SRC/TOOLS/LZEXP.C \
	SRC/TOOLS/LZCOPY.C SRC/COMPAT/CLABEL.C SRC/COMPAT/CTEXT.C SRC/COMPAT/CDOS.C
INSTALL_HOSTARGS := /BOGUS
INSTALL_HOSTRC := 1
T_INST_HOST := TEST/T_INST.C SRC/TOOLS/INSTPLAN.C SRC/TOOLS/LZEXP.C \
	SRC/TOOLS/LZCOPY.C TEST/T_FILES.C SRC/COMPAT/CLABEL.C SRC/COMPAT/CTEXT.C \
	SRC/COMPAT/CDOS.C
T_INST_HOSTARGS := OBJ/HOST/INST/

INV_MODEL := m
INV_SRCS := $(INV_CLIENT) SRC/COMPAT/CMEMHI.C $(INV_DEVICES) \
	SRC/CLIENT/INVLOC.C SRC/CLIENT/LINKLOC.C \
	$(ENG_CORE) $(PROTO_CORE) $(DBF_CORE) SRC/COMPAT/CDOS.C
# INV is run by TEST/T_INV.SH; the run here checks that a usage error
# exits with 1 before any input is read.
INV_HOSTARGS := /CMD /BOGUS
INV_HOSTRC := 1

# THIN, the network-only client.  Its run here checks that a line naming
# no connection is a usage error (1), LOCAL being none of its own, before
# any input is read; TEST/T_INV.SH checks the rest of its start-up.
$(THIN)_MODEL := m
$(THIN)_SRCS := $(INV_CLIENT) SRC/COMPAT/CMEMHR.C $(INV_DEVICES) \
	SRC/CLIENT/INVNOL.C SRC/CLIENT/LINKNOL.C \
	SRC/PROTO/TOKEN.C SRC/COMPAT/CTEXT.C SRC/COMPAT/CDOS.C
$(THIN)_HOSTARGS := /CMD
$(THIN)_HOSTRC := 1

INVSERV_MODEL := m
INVSERV_SRCS := SRC/SERVER/INVSERV.C SRC/SERVER/SRVRUN.C SRC/SERVER/TNETB.C \
	SRC/SERVER/TSERIAL.C SRC/SERVER/TMBOX.C SRC/SERVER/TICKET.C \
	SRC/SERVER/THROTL.C SRC/SERVER/CONN.C SRC/SERVER/SRVSCR.C \
	SRC/SERVER/SRVCFG.C SRC/CLIENT/MSG.C SRC/COMPAT/CNETB.C \
	SRC/COMPAT/CNBDRAIN.C SRC/COMPAT/CUART.C SRC/COMPAT/CUARTSV.C \
	SRC/COMPAT/CMEM.C SRC/COMPAT/CMEMHN.C SRC/COMPAT/CVIDEO.C SRC/COMPAT/CKEY.C \
	SRC/COMPAT/CTIMER.C SRC/COMPAT/CFINE.C SRC/COMPAT/CRUN.C $(ENG_CORE) \
	$(PROTO_CORE) $(TICKET_CORE) $(DBF_CORE) SRC/COMPAT/CDOS.C
# INVSERV with the default settings, which serve NetBIOS, refuses to start
# without a NetBIOS provider (SRV_EXIT_NONB, SRVRUN.H) before it opens
# the data, and so it must when booted without one on MS-DOS 3.10, in
# its DOS run of kind nonb in MAKEFILE.  The same program, under the
# names below, exits with 1 for an unknown switch, an empty /CFG: and a
# second /CFG:, with 0 for /?, and with 8 for a settings file that is
# not one (-CFG: given with '-').
INVSERV_HOSTRC := 5
INVSERV_NONBRC := $(INVSERV_HOSTRC)
SRVUSAGE_HOST := $(INVSERV_SRCS)
SRVUSAGE_HOSTARGS := /BOGUS
SRVUSAGE_HOSTRC := 1
SRVHELP_HOST := $(INVSERV_SRCS)
SRVHELP_HOSTARGS := /?
SRVNOCFG_HOST := $(INVSERV_SRCS)
SRVNOCFG_HOSTARGS := /CFG:
SRVNOCFG_HOSTRC := 1
SRVTWOCF_HOST := $(INVSERV_SRCS)
SRVTWOCF_HOSTARGS := /CFG:A /cfg:B
SRVTWOCF_HOSTRC := 1
SRVBADCF_HOST := $(INVSERV_SRCS)
SRVBADCF_HOSTARGS := -CFG:SRCS.MK
SRVBADCF_HOSTRC := 8

# TCPTEST, the TCP probe, links the bridge's sockets on WATTCP's kernel
# as INVTCP does.
TCPTEST_MODEL := m
TCPTEST_SRCS := SRC/TOOLS/TCPTEST.C SRC/TCP/TSWAT.C $(WATTCP_KERNEL) \
	SRC/COMPAT/CPKT.C SRC/COMPAT/CWATT.C SRC/COMPAT/CFINE.C \
	SRC/COMPAT/CTIMER.C SRC/COMPAT/CTEXT.C SRC/COMPAT/CDOS.C
TCPTEST_MAXNEAR := $(INVTCP_MAXNEAR)

INVTCP_MODEL := m
INVTCP_SRCS := SRC/TCP/TCPMAIN.C SRC/TCP/INVTCP.C $(BRIDGE_CORE) \
	SRC/TCP/TSWAT.C $(WATTCP_KERNEL) SRC/COMPAT/CPKT.C SRC/COMPAT/CWATT.C \
	SRC/COMPAT/CFINE.C SRC/COMPAT/CNETB.C SRC/COMPAT/CNBDRAIN.C \
	SRC/COMPAT/CMEMHT.C SRC/COMPAT/CKEY.C SRC/COMPAT/CRUN.C
# Booted without a NetBIOS provider on MS-DOS 3.10, in its DOS run of
# kind nonb in MAKEFILE, given INVTCP_NONBARGS, INVTCP must exit with
# TCP_EXIT_NONB (INVTCP.H).
INVTCP_NONBARGS := RISRV
INVTCP_NONBRC := 5
# Only the change of SRC/TCP/WATTCP.DIF to the kernel's tcp_handler calls
# wt_isn, and INVTCP links only what is called (WC_ELIM of MAKEFILE), so
# its map lists wt_isn only while the kernel starts each connection at
# wt_isn's number: the link fails without it.
INVTCP_MAPSYMS := wt_isn

