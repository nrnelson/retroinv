WATTCP.DIF - our changes to the WATTCP sources of 14 Sep 1994.

WATPREP.PY applies this diff to the files as the archive holds them,
before its mechanical changes; the changed lines keep the archive's
CR LF ends.  Each change but the last is one that the three compilers,
or the calls between WATTCP's modules, need:

- WATTCP.H includes WTSHIM.H before its own declarations, and types the
  IP header's two 4-bit fields WT_BF4, without which Watcom makes the
  header 21 bytes with tos at offset 2.
- The declarations without a return type get int, which Open Watcom
  warns about in every file that includes WATTCP.H.  A block of
  prototypes covers the calls made without one: the kernel's calls
  between its modules, and the TCP back end's calls into the API.
  Without one an argument of the wrong type is passed as it is:
  _tcp_cancel's last parameter is a longword, which three of its
  callers give as an int 0.
- _arp_resolve takes its address buffer as void *: Watcom C 6.5 reads
  &array as a pointer to the element and refuses the callers'
  arguments.
- Casts and the union member where a call passes a pointer of another
  type, which Watcom refuses; two of these calls had the members
  swapped.  A string literal in a ?: is cast to the char * of the other
  branch, and no token follows #endif, both for Watcom C 6.5.
- tcp_handler starts the connection a listening socket takes at
  wt_isn's number (WTSHIM.H), not at the one tcp_listen made from the
  socket's address, which is the same for every connection and lets a
  host forge one from an address whose replies it cannot see.

--- a/INCLUDE/WATTCP.H
+++ b/INCLUDE/WATTCP.H
@@ -3,6 +3,7 @@
 #define _wattcp_wattcp_h
 
 #define WATTCPH
+#include "WTSHIM.H"
 
 #define SOCKESTABLISHED 1
 #define SOCKDATAREADY   2
@@ -92,8 +93,8 @@
 
 /* The Internet Header: */
 typedef struct {
-    unsigned	    hdrlen  : 4;
-    unsigned	    ver     : 4;
+    WT_BF4	    hdrlen  : 4;
+    WT_BF4	    ver     : 4;
     byte	    tos;
     word            length;
     word            identification;
@@ -357,9 +358,9 @@
  *
  */
 
-extern _ip_delay0( sock_type *s, int timeoutseconds, procref fn, int *statusptr );
-extern _ip_delay1( sock_type *s, int timeoutseconds, procref fn, int *statusptr );
-extern _ip_delay2( sock_type *s, int timeoutseconds, procref fn, int *statusptr );
+extern int _ip_delay0( sock_type *s, int timeoutseconds, procref fn, int *statusptr );
+extern int _ip_delay1( sock_type *s, int timeoutseconds, procref fn, int *statusptr );
+extern int _ip_delay2( sock_type *s, int timeoutseconds, procref fn, int *statusptr );
 
 #define sock_wait_established( s, seconds, fn, statusptr ) \
     if (_ip_delay0( s, seconds, fn, statusptr )) goto sock_err;
@@ -395,7 +396,19 @@
 #define _ping( h, c ) _send_ping( h, c, 250, 0, NULL )
 extern longword _chk_ping( longword host , longword *ptr);
 extern void _arp_register( longword use, longword instead_of );
-extern int _arp_resolve( longword ina, eth_address *ethap, int nowait);
+extern int _arp_resolve( longword ina, void *ethap, int nowait);
+extern void _arp_add_gateway( char *data, longword ip );
+extern int _arp_handler( arp_Header *in );
+extern void _tcp_cancel( in_Header *ip, int code, char *msg, longword dummyip );
+extern void _udp_cancel( in_Header *ip );
+extern void tcp_init( void );
+extern void tcp_shutdown( void );
+extern int tcp_config( char *path );
+extern int tcp_tick( sock_type *s );
+extern int tcp_established( tcp_Socket *s );
+extern word sock_dataready( sock_type *s );
+extern int sock_tbused( tcp_Socket *s );
+extern int sock_tbleft( tcp_Socket *s );
 
 extern void * _pkt_eth_init( void );
 extern void pkt_release( void );
@@ -409,14 +422,14 @@
 extern void _add_server( int *counter, int max, longword *array, longword value );
 extern word debug_on;
 extern char *rip( char *s);
-extern _chk_socket( tcp_Socket *s );
+extern int _chk_socket( tcp_Socket *s );
 extern char *inet_ntoa( char *s, longword x );
 extern void psocket( tcp_Socket *s );
 extern longword inet_addr( char *s );
 extern char *sockerr( tcp_Socket *s );
 extern char *sockstate( tcp_Socket *s );
-extern getpeername( tcp_Socket *s, void *dest, int *len );
-extern getsockname(  tcp_Socket *s, void *dest, int *len );
+extern int getpeername( tcp_Socket *s, void *dest, int *len );
+extern int getsockname(  tcp_Socket *s, void *dest, int *len );
 extern longword gethostid( void );
 extern longword sethostid( longword ip );
 extern char *getdomainname( char *name, int length );
