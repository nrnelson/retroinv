/*
 * INVWIN.RC - the resources of the Windows client, SRC/WIN/INVWIN.C: its
 * icon, its drag cursor, its tool bar's glyphs, its dialogs and its own
 * texts, in the Windows character set, the strings of the form dialog,
 * the file name dialog, the dialogs and strings of the reports, the help
 * of the menu entries, and the engine's schema data.  The icon, named as
 * the window class, is the file SRC/WIN/INVICON.PY writes at build time,
 * the cursor the file SRC/WIN/INVDRAG.PY writes, the glyphs, named as
 * the tool bar's class (WTOOL.H), the file SRC/WIN/INVTOOL.PY writes, the
 * schema data the file of SRC/COMPAT/CSCHBIN.C.
 */
#include <windows.h>
#include "CSCHDAT.H"
#include "INVWIN.H"
#include "WFORM.RC"
#include "WFILE.RC"
#include "WRPT.RC"
#include "WROWS.RC"

INVWIN ICON INVWIN.ICO
IW_R_DRAG CURSOR INVDRAG.CUR
WTOOL BITMAP INVTOOL.BMP
CSCH_RES CSCH_TYPE DISCARDABLE CSCHDAT.BIN

IW_R_ABOUT DIALOG 0, 0, 160, 56
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About RETROINV"
FONT 8, "Helv"
BEGIN
    CTEXT "", IW_C_VERSION, 8, 10, 144, 8
    CTEXT "Retro Hardware Inventory", -1, 8, 20, 144, 8
    DEFPUSHBUTTON "OK", IDOK, 56, 36, 48, 14
END

IW_R_LOGIN DIALOG 0, 0, 176, 86
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "RETROINV"
FONT 8, "Helv"
BEGIN
    LTEXT "&User name:", -1, 8, 10, 56, 8
    EDITTEXT IW_C_USER, 68, 8, 64, 12, ES_UPPERCASE | ES_AUTOHSCROLL
    LTEXT "&Password:", -1, 8, 26, 56, 8
    EDITTEXT IW_C_PASS, 68, 24, 64, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "", IW_C_MSG, 8, 42, 160, 16
    DEFPUSHBUTTON "OK", IDOK, 32, 64, 48, 14
    PUSHBUTTON "Cancel", IDCANCEL, 96, 64, 48, 14
END

IW_R_PASSWD DIALOG 0, 0, 176, 102
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Change password"
FONT 8, "Helv"
BEGIN
    LTEXT "&Old password:", -1, 8, 10, 76, 8
    EDITTEXT IW_C_OLD, 88, 8, 80, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "&New password:", -1, 8, 26, 76, 8
    EDITTEXT IW_C_NEW, 88, 24, 80, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "&Repeat new password:", -1, 8, 42, 76, 8
    EDITTEXT IW_C_REPEAT, 88, 40, 80, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "", IW_C_MSG, 8, 58, 160, 16
    DEFPUSHBUTTON "OK", IDOK, 32, 80, 48, 14
    PUSHBUTTON "Cancel", IDCANCEL, 96, 80, 48, 14
END

IW_R_SESS DIALOG 0, 0, 288, 124
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
FONT 8, "Helv"
BEGIN
    LTEXT "", IW_C_SHDR, 8, 6, 272, 8, SS_NOPREFIX
    CONTROL "", IW_C_SROWS, "LISTBOX", WS_CHILD | WS_VISIBLE | WS_BORDER |
        WS_VSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED |
        LBS_HASSTRINGS | LBS_WANTKEYBOARDINPUT, 8, 16, 272, 84
    PUSHBUTTON "&Refresh", IW_C_REFRESH, 168, 104, 48, 14
    DEFPUSHBUTTON "Close", IDOK, 224, 104, 48, 14
END

IW_R_CODES DIALOG 0, 0, 216, 124
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
FONT 8, "Helv"
BEGIN
    LTEXT "", IW_C_CHDR, 8, 6, 144, 8, SS_NOPREFIX
    CONTROL "", IW_C_CROWS, "LISTBOX", WS_CHILD | WS_VISIBLE | WS_BORDER |
        WS_VSCROLL | WS_TABSTOP | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT |
        LBS_WANTKEYBOARDINPUT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS, 8, 16,
        144, 100
    DEFPUSHBUTTON "&Edit...", IW_C_CEDIT, 160, 16, 48, 14
    PUSHBUTTON "&New...", IW_C_CNEW, 160, 34, 48, 14
    PUSHBUTTON "&Delete", IW_C_CDEL, 160, 52, 48, 14
    PUSHBUTTON "Close", IDCANCEL, 160, 102, 48, 14
END

IW_R_HELP DIALOG 0, 0, 280, 160
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "RETROINV Help"
FONT 8, "Helv"
BEGIN
    EDITTEXT IW_C_HELP, 0, 0, 280, 160, ES_MULTILINE | ES_AUTOVSCROLL |
        WS_VSCROLL
END

STRINGTABLE
BEGIN
    IW_S_TITLE, "RETROINV"
