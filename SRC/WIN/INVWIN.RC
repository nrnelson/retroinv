    IW_G_DONE + IW_S_RINTO, "%u items installed"
    IW_G_DONE + IW_S_ROUT, "%u items taken out"
    IW_G_DONE + IW_S_RRET, "%u loans and holds ended"
    IW_G_DONE + IW_S_RLEND, "%u loans added"
    IW_G_DONE + IW_S_RRES, "%u reservations added"
    IW_G_DONE + IW_S_RUSE, "%u uses added"
    IW_G_DONE + IW_S_RDEL, "%u items deleted"
END

/* The menu entries' help (IW_H_MENU), in the order of the menu bar. */
STRINGTABLE
BEGIN
    IW_H_MENU + MN_LOGOUT, "Log out, then log in again as any user"
    IW_H_MENU + IW_S_MEXIT, "End RETROINV"
    IW_H_MENU + MN_BYID, "List every item in order of its ID"
    IW_H_MENU + MN_BYLOC, "List every item in order of its location"
    IW_H_MENU + MN_BYMFR, "List every item in order of maker and model"
    IW_H_MENU + MN_BYSER, "List every item in order of serial number"
    IW_H_MENU + IW_S_MBYCAT, "List the categories, each one's items beside it"
    IW_H_MENU + MN_NEWITEM, "Add an item"
    IW_H_MENU + MN_ASSY, "List the items built of others"
    IW_H_MENU + MN_MAINT, "List the service records, newest first"
    IW_H_MENU + MN_LOANS, "List the open loans, reservations and uses"
    IW_H_MENU + MN_CATS, "Show, add, change or delete the item categories"
    IW_H_MENU + MN_LOCS, "Show the locations as a tree"
    IW_H_MENU + MN_NEWLOC, "Add a location at the top level"
    IW_H_MENU + MN_LTYPES, "Show, add, change or delete the location types"
    IW_H_MENU + MN_FIND, "Find the items whose text holds what you type"
    IW_H_MENU + MN_SERIAL, "Find the items by their serial number"
    IW_H_MENU + MN_FILTER, "List the items that match the filters you give"
    IW_H_MENU + MN_RLIST, "Report the items, by location, ID or maker"
    IW_H_MENU + MN_RVALUE, "Report the value of the active items"
    IW_H_MENU + MN_RLOANS, "Report the loans out, or only the overdue ones"
    IW_H_MENU + MN_RLABEL, "Make a label for each item, or for one"
    IW_H_MENU + MN_RBIN, "Make a label for each location"
    IW_H_MENU + MN_USERS, "List the users and their access levels"
    IW_H_MENU + MN_BACKUP, "Copy the data files to a directory"
    IW_H_MENU + MN_RESTORE, "Copy the data files back from a backup"
    IW_H_MENU + MN_PACK, "Remove the deleted records from the data files"
    IW_H_MENU + MN_REINDEX, "Rebuild every index of the data files"
    IW_H_MENU + MN_AUDIT, "Show the changes and failed logins logged"
    IW_H_MENU + MN_SESSIONS, "Show the sessions open on the server"
    IW_H_MENU + MN_EXPORT, "Write a table to a CSV file"
    IW_H_MENU + MN_IMPORT, "Add the records of a CSV file to the items or locations"
    IW_H_MENU + MN_SETTINGS, "Change the settings of this program"
    IW_H_MENU + MN_PASSWD, "Change your password"
    IW_H_MENU + IW_S_MHELPON, "Show the help of the list or dialog in use"
    IW_H_MENU + IW_S_MSTART, "Show how to begin with RETROINV"
    IW_H_MENU + IW_S_MKEYS, "Show the keys that work everywhere"
    IW_H_MENU + IW_S_MABOUT, "Show the program's version"
    IW_H_MENU + IW_S_ROPEN, "Show the selected record; a location's or category's items"
    IW_H_MENU + IW_S_REDIT, "Change the selected record"
    IW_H_MENU + IW_S_RNEW, "Add a record to this list"
    IW_H_MENU + IW_S_RDEL, "Delete the selected record"
    IW_H_MENU + IW_S_RCOPY, "Duplicate the selected item and edit the copy"
    IW_H_MENU + IW_S_RMOVE, "Move the selected item or location to another location"
    IW_H_MENU + IW_S_RINTO, "Install the selected item in another item"
    IW_H_MENU + IW_S_ROUT, "Take the selected item out of its assembly"
    IW_H_MENU + IW_S_RPART, "Install another item in this one as a part"
    IW_H_MENU + IW_S_RRET, "End the selected loan, reservation or use"
    IW_H_MENU + IW_S_RPARTS, "List the parts of the selected item"
    IW_H_MENU + IW_S_RSVC, "List the service records of the selected item"
    IW_H_MENU + IW_S_RLOANS, "List the loans and holds of the selected item"
    IW_H_MENU + IW_S_RUSED, "List what is reserved for or used with the item"
    IW_H_MENU + IW_S_RBELOW, "Show the items of the locations inside this one too"
    IW_H_MENU + IW_S_RNEXT, "Show the next view of the loans and holds"
    IW_H_MENU + IW_S_RORDER, "Sort the list in its next order"
    IW_H_MENU + IW_S_RBACK, "Go back to the list shown before"
    IW_H_MENU + IW_S_RSPLIT, "Split units off the selected item into a new item"
    IW_H_MENU + IW_S_RTOP, "Show only the items not installed in another"
    IW_H_MENU + IW_S_RLEND, "Lend an item"
    IW_H_MENU + IW_S_RRES, "Reserve an item for someone or for another item"
    IW_H_MENU + IW_S_RUSE, "Mark an item in use with another item or a place"
    IW_H_MENU + IW_S_RITEM, "Show the item of the selected row"
    IW_H_MENU + IW_S_RPANE, "Move to the other side of the split view"
    IW_H_MENU + IW_S_VPANE, "Show or hide the pane beside this list"
    IW_H_MENU + IW_S_VREFRESH, "Fetch the list or the preview again"
    IW_H_MENU + IW_S_RALL, "Select every row of the list, on every page"
END
