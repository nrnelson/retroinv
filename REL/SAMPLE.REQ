# SAMPLE.REQ - the protocol requests that make the sample data directory
# of the release, played by INV /CMD /LOCAL on a new, empty directory
# with the clock fixed (REL/mkdist.sh).  Lines starting with # and empty
# lines are removed before the requests are sent; every request must be
# answered +OK or +DATA.
#
# The seeded ADMIN gets a working password for the session and is reset
# at the end, so that every user, ADMIN, OPER and READER, starts with its
# first password, the user name in lower case, and must change it at its
# first login.  Items are numbered from 1 in the order they are added; the
# assembly, service, loan, reservation and in-use requests name them by
# those numbers.  LOAN RETURN names a loan, numbered from 1 in the order
# the loans, reservations and in-use rows are made.

HELLO SETUP
LOGIN ADMIN admin
PASSWD admin Setup1986

USER ADD OPER LEVEL=2 FULLNAME="Collection Operator" GROUP=STAFF PASSWORD=oper
USER ADD READER LEVEL=1 FULLNAME="Guest Reader" GROUP=GUEST PASSWORD=reader

# The places, a tree: the office, with two shelves, three bins on the
# first, a cabinet and a workbench with its drawer; the garage, with a
# rack holding a box, and a bucket on its floor.  Locations get LOC_IDs
# from 1 in the order they are added; a location with a code is named by
# it, one without (the drawer, the bucket) by its LOC_ID.  The workbench
# is of a type added to the seeded list.  A capacity counts the items a
# place holds, the parts installed in a system included.
LTYPE ADD BENCH LT_NAME=Workbench SORTORD=9
LOC ADD LOC_NAME=Office LTYPE=ROOM LOC_CODE=OFF
LOC ADD LOC_NAME="Shelf A" LTYPE=SHELF PARENT_ID=OFF LOC_CODE=A CAPACITY=8
LOC ADD LOC_NAME="Bin 1" LTYPE=BIN PARENT_ID=A LOC_CODE=A1 CAPACITY=40
LOC ADD LOC_NAME="Bin 2" LTYPE=BIN PARENT_ID=A LOC_CODE=A2 CAPACITY=20
LOC ADD LOC_NAME="Bin 3" LTYPE=BIN PARENT_ID=A LOC_CODE=A3 CAPACITY=50
LOC ADD LOC_NAME="Shelf B" LTYPE=SHELF PARENT_ID=OFF LOC_CODE=B CAPACITY=10
LOC ADD LOC_NAME=Cabinet LTYPE=CABINET PARENT_ID=OFF LOC_CODE=CAB CAPACITY=60
LOC ADD LOC_NAME=Workbench LTYPE=BENCH PARENT_ID=OFF LOC_CODE=DESK CAPACITY=3
LOC ADD LOC_NAME="Top drawer" LTYPE=DRAWER PARENT_ID=DESK
LOC ADD LOC_NAME=Garage LTYPE=ROOM LOC_CODE=GAR
LOC ADD LOC_NAME="Rack 1" LTYPE=RACK PARENT_ID=GAR LOC_CODE=R1 CAPACITY=12
LOC ADD LOC_NAME="Box 3" LTYPE=BOX PARENT_ID=R1 LOC_CODE=BOX3 CAPACITY=10
LOC ADD LOC_NAME="Spares bucket" LTYPE=BUCKET PARENT_ID=GAR

# COND is an item's cosmetic grade, WORKS whether it was found to work
# (Y, I for intermittently, N); the rest are not tested yet.  TAGS name
# the collections an item belongs to (retro, modern, a project).
#
