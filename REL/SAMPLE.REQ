MAINT ADD 1 MTYPE=RC SUMMARY="Recapped the 63W power supply" MDATE=20250412 COST=12.50 DONE_BY=OPER NOTES="Replaced the two 470uF filter capacitors; ripple now under 50 mV."
MAINT ADD 7 MTYPE=CL SUMMARY="Cleaned heads, lubricated the rails" MDATE=20250412 DONE_BY=OPER
MAINT ADD 13 MTYPE=TS SUMMARY="Surface scan, no new bad sectors" MDATE=20260115 DONE_BY=ADMIN
MAINT ADD 21 MTYPE=IN SUMMARY="Stuck heads; needs a bench repair" MDATE=20260320 DONE_BY=OPER

LOAN OUT 16 HOLDER="Retro Computing Club" CONTACT=555-0142 DATE=20260905 DUE=20261031 NOTES="For the club's CGA versus Hercules demo"
LOAN OUT 28 HOLDER="Jane Smith" CONTACT=555-0101 DATE=20260801 DUE=20260915
LOAN OUT 24 HOLDER="Ed Brown" CONTACT=555-0177 DATE=20260310 DUE=20260410
LOAN RETURN 3 DATE=20260402

# The colour monitor is in use with the 5150 on the desk, and two of the
# Ethernet cards are reserved for the club's network evening.
LOAN USE 23 HOST=1 NOTES="Its everyday screen"
LOAN RESERVE 17 QTY=2 HOLDER="Club network evening" CONTACT=555-0142 DUE=20261114

