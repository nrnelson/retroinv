.SUFFIXES:
.DELETE_ON_ERROR:

all: $(foreach e,$(EXES),$(BIN)/$(e).EXE) $(foreach e,$(WIN_EXES) $(WIN_TOOLS),$(BIN)/WIN/$(e).EXE) \
	$(BIN)/QEXIT.COM
wsmoke: $(BIN)/WIN/WSMOKE.EXE

# Objects live under OBJ/WC/<model>/ so a source shared by executables of
# different memory models is compiled once per model.  The programs of
# WC_ELIM (the tools INVDUMP, DBPACK, COMTEST and INSTALL, the test programs
# NBTEST, INVTEST and TCPTEST, and INVTCP) take theirs from
# OBJ/WC/<model>z/, compiled with each function in a segment of its own
# (-zm), and are linked with "option eliminate", which drops every
# function nothing references: they use only part of the modules they
# link.  INV, THIN and INVSERV call most of what they link, and -zm makes
# them larger (THIN by 1.6 KB).  Each object gets a .D file listing the
# headers it read, so header edits rebuild it; objects also depend on
# the build files so a flag change rebuilds everything.
WC_ELIM := NBTEST INVTEST INVDUMP DBPACK COMTEST INSTALL TCPTEST INVTCP
$(if $(filter-out $(EXES),$(WC_ELIM)),$(error WC_ELIM names $(filter-out $(EXES),$(WC_ELIM)), not in EXES))
wc_dir = $($(1)_MODEL)$(if $(filter $(1),$(WC_ELIM)),z)
WC_DIRS := s m $(addsuffix z,s m)
WDEPS = -ad=$(@:.OBJ=.D) -adt=$@ -add=$<
BUILDFILES := MAKEFILE SRCS.MK

# $(call wc_rule,BUILD,DIR,FLAGS): compile into $(OBJ)/BUILD/DIR/ with
# the target flags FLAGS, DIR being a model letter, z added for -zm.
define wc_rule
$(OBJ)/$(1)/$(2)/%.OBJ: %.C $(BUILDFILES)
	@mkdir -p $$(dir $$@)
	$$(WCC) $$(WCFLAGS_BASE) $(3) $$(call wc_inc,$$<) -m$(2:z=)$(if $(filter %z,$(2)), -zm) $$(call wc_ansi,$$<) $$(call wc_wattcp,$$<) $$(WDEPS) -fo=$$@ $$<
endef
$(foreach d,$(WC_DIRS),$(eval $(call wc_rule,WC,$(d),$(WCFLAGS_DOS))))

# WATTCP's build tree, WATTCP_DIR: SRC/TCP/WATPREP.PY prepares it from the
# archive WATTCP_ZIP, under RETRO_DL (the period downloads, exported to
# every script the rules run; unset or empty means ~/retro-dl, as in
# TEST/shlib.sh), and writes its stamp .ok last.  The kernel
# modules are targets of the same rule and the objects of our sources
# that include WATTCP's headers depend on the stamp, so only what
# compiles them waits for the tree, and all of them are built again when
# it is prepared again, after a change of the archive, of our changes or
# of the script.  WATPREP extracts the modules of its KERNEL list, which
# make lint holds to those of WATTCP_KERNEL.  A missing archive fails the
# build: its rule runs WATPREP, which names the path and the SHA-256 the
# archive must have.
override RETRO_DL := $(or $(strip $(RETRO_DL)),$(HOME)/retro-dl)
export RETRO_DL
# The help compiler of winhelp (HC/install.sh).  Where it is installed,
# wintest adds INVWIN's runs with Windows Help, which need its file; the
# gate's machines need no SDK.
HC_DIR ?= $(RETRO_DL)/win30hc
export HC_DIR
ifneq ($(wildcard $(HC_DIR)/HC.EXE),)
INVWIN_WINKEYS += $(INVWIN_WINHLPKEYS)
endif
WATTCP_ZIP := $(RETRO_DL)/wattcp/dl/retropc/source.zip
WATPREP := python3 -I SRC/TCP/WATPREP.PY $(WATTCP_ZIP) SRC/TCP/WATTCP.DIF $(WATTCP_DIR)

# Two makes in one tree (make tc beside make wc65) can both find the tree
# out of date, and the second's WATPREP would replace or, failing, delete
# the tree the first one's build is reading.  So WATPREP runs under the
# lock $(WATTCP_DIR).LCK, and only when, once the lock is had, a target
# is still missing or not newer than every prerequisite.  The targets are
# precious, so a make stopped or failing here never deletes them: they
# may be the other make's, and WATPREP itself leaves the tree whole.
WATTCP_TARGETS := $(WATTCP_DIR)/.ok $(WATTCP_KERNEL)
.PRECIOUS: $(WATTCP_TARGETS)
$(WATTCP_TARGETS) &: $(WATTCP_ZIP) SRC/TCP/WATTCP.DIF SRC/TCP/WATPREP.PY
	@mkdir -p $(dir $(WATTCP_DIR))
	@flock $(WATTCP_DIR).LCK sh -c 'for p in $^; do for t in $(WATTCP_TARGETS); do \
		[ "$$t" -nt "$$p" ] || { echo "$(WATPREP)"; exec $(WATPREP); }; done; done'

$(foreach d,$(WC_DIRS),$(patsubst %.C,$(OBJ)/WC/$(d)/%.OBJ,$(WATTCP_USERS))): $(WATTCP_DIR)/.ok

$(WATTCP_ZIP):
	@echo "WATTCP's archive is missing; RETRO_DL names the directory of the period downloads" >&2
	@$(WATPREP)

# The stamp of the build tree when one of the programs $(1) links WATTCP.
wattcp_for = $(if $(filter $(WATTCP_KERNEL),$(foreach e,$(1),$($(e)_SRCS))),$(WATTCP_DIR)/.ok)

# wlink has no warnings-as-errors switch, so wlink_run keeps its output
# in a log, shows it and fails on a warning as on an error: $(call
# wlink_run,LOG,NAME,DIRECTIVES) links program NAME.  For a DOS program
# the map is then checked against the segment budgets and for the
# functions it must link, <NAME>_MAPSYMS of SRCS.MK, and the
# objects of the programs in NEAR_EXES against their near data budgets in
# TEST/NEARBUD.TXT and the near data limit MAX_NEAR of TEST/mapchk.sh;
# .DELETE_ON_ERROR removes the EXE of a link or check that fails.
# Every DOS program gets the stack of the Turbo C build, _stklen of
# SRC/COMPAT/CDOS.C, which TEST/mapchk.sh counts in DGROUP.  $(call
# mapchk_args,NAME,BUILD) gives TEST/mapchk.sh the program's near data
# budget, <NAME>_MAXNEAR of SRCS.MK, when it is set, and for a program of
# LOAD_EXES, those with free-memory floors, the build (OW, TC or WC65)
# whose load size budget in TEST/LOADBUD.TXT the map must keep.
LOAD_EXES := INV $(THIN) INVSERV INVTEST INVTCP
mapchk_args = $(if $($(1)_MAXNEAR),-n $($(1)_MAXNEAR)) \
	$(if $(and $(2),$(filter $(1),$(LOAD_EXES))),-l $(2))
wlink_run = $(WLINK) option quiet $(3) >$(1) 2>&1; rc=$$?; cat $(1); \
	if [ $$rc -ne 0 ] || grep -qi warning $(1); then \
		echo "wlink: $(2) failed or warned" >&2; exit 1; fi
NEAR_EXES := INV $(THIN)
NEARCHK := python3 -I TEST/OMFNEAR.PY -q --max-near TEST/mapchk.sh TEST/NEARBUD.TXT
DOS_STACK := $(shell sed -n 's/^unsigned _stklen = \([0-9][0-9]*\);.*/\1/p' SRC/COMPAT/CDOS.C)
ifeq ($(DOS_STACK),)
$(error _stklen not found in SRC/COMPAT/CDOS.C)
endif
define exe_rule
$$(if $$(filter s m,$$($(1)_MODEL)),,$$(error $(1)_MODEL must be s or m))
$(1)_OBJS := $$(patsubst %.C,$(OBJ)/WC/$$(call wc_dir,$(1))/%.OBJ,$$($(1)_SRCS))
ALL_OBJS += $$($(1)_OBJS)
$(2)/$(1).EXE: $$($(1)_OBJS) TEST/mapchk.sh $$(if $$(filter $(1),$(NEAR_EXES)),TEST/OMFNEAR.PY TEST/NEARBUD.TXT) \
	$$(if $$(filter $(1),$(LOAD_EXES)),TEST/LOADBUD.TXT)
	@mkdir -p $(2)
	@$$(call wlink_run,$(OBJ)/$(1).LNK,$(1),system dos option map=$(2)/$(1).MAP \
		option stack=$(DOS_STACK) $(if $(filter $(1),$(WC_ELIM)),option eliminate) \
		name $$@ $$(foreach o,$$($(1)_OBJS),file $$(o)))
	@sh TEST/mapchk.sh $(call mapchk_args,$(1),OW) $(2)/$(1).MAP
	$$(if $$($(1)_MAPSYMS),@$$(foreach s,$$($(1)_MAPSYMS),grep -qw $$(s)_ $(2)/$(1).MAP || \
		{ echo "$(1): $$(s) is not linked" >&2; exit 1; };))
	$$(if $$(filter $(1),$(NEAR_EXES)),@$(NEARCHK) $$($(1)_OBJS))
	@echo "linked $$@"
endef
$(foreach e,$(EXES),$(eval $(call exe_rule,$(e),$(BIN))))
$(foreach e,$(DOS_TESTS),$(eval $(call exe_rule,$(e),$(BIN)/TEST)))

# Windows programs (WIN_EXES of SRCS.MK), built by Open Watcom for Win16:
# each object goes to OBJ/WIN/<model>/<source path>.OBJ, apart from the
# DOS objects of the same source, and the program and its map to BIN/WIN/.
# -zW gives every function declared __export, a WCALLBACK of
# SRC/COMPAT/CWIN.H, the entry code that loads DS from AX; wlink exports
# each of them.  That entry code works only in an exported function: the
# loader patches out its first instructions, which copy DS into AX, for
# exported entries alone, so that DS comes from the AX that Windows or a
# MakeProcInstance thunk sets.  -zw gives the same code to every FAR
# PASCAL function, which buys nothing without the export and costs bytes
# in WinMain.  -zW also gives every far function that calls another an
# odd saved BP, the mark of the frames real-mode Windows walks to mend
# the return addresses on the stack when it moves or discards a code
# segment.  That walk also keeps a return offset in each frame's BP-2,
# where it expects the saved DS, which -zW saves only in exported
# functions; hence the mark for protected mode only below.  WINVER 0x0300
# leaves out of windows.h what Windows 3.0 lacks, so a later call does
# not compile; STRICT gives each kind of handle a type of its own, so that
# a handle passed for another does not compile either.  Without -zc,
# constants stay in DGROUP rather than in a code segment Windows may
# discard.
WCFLAGS_WIN := -bt=windows -zW -dWINVER=0x0300 -dSTRICT -i=$(WATCOM)/h/win
$(foreach d,$(WC_DIRS),$(eval $(call wc_rule,WIN,$(d),$(WCFLAGS_WIN))))
# The Windows programs of WIN_ELIM are compiled and linked as those of
# WC_ELIM are, to drop what they do not call: SETUP, which must fit
# beside INVWIN on the release disks and calls few of CDOS.C's functions.
WIN_ELIM := SETUP

# The resource script NAME_RC is compiled into OBJ/WIN/NAME.RES, again when
# a header or resource script beside it changes (it may include those),
# and bound into the program by wrc -30 -t:
# -30 marks it for Windows 3.0 (3.10 otherwise) and -t for protected mode
# only, so that Windows 3.0 refuses to start it in real mode, whose stack
# walk our frames would mislead (DOC/DESIGN.md).  wlink makes a Win16
# segment fixed and preloaded unless told, and its TYPE CODE and TYPE
# DATA forms set the other kind's segments, so WIN_SEGMENTS names
# classes: CODE moveable, discardable and loaded on its first call, and
# the four classes of DGROUP, each moveable, as the group stays fixed
# while one of them is.  The code is packed into segments of at most
# WIN_PACKCODE bytes, units that Windows can drop and load again on their
# own.  A program has WIN_STACK bytes of stack, or <NAME>_WINSTACK of
# SRCS.MK when its deepest calls need more (win_stack), and starts with a
# local heap of WIN_HEAP bytes, which Windows grows inside DGROUP on
# demand.  Its module description is "RETROINV NAME", not wlink's
# default, the path it was built at; it is passed as two words, each
# carrying one quote, since wlink re-quotes an argument with a blank.
# TEST/mapchk.sh -w checks the map with that stack and the program's near
# data budget, and TEST/NECHK.PY then checks the header: Windows 3.00,
# protected mode only, those sizes, and every import one that
# TEST/W30EXP.TXT lists as a function of Windows 3.0.
WIN_STACK := 8192
WIN_HEAP := 1024
WIN_PACKCODE := 16384
WIN_SEGMENTS := segment class CODE moveable discardable loadoncall \
	segment class BEGDATA moveable segment class DATA moveable \
	segment class BSS moveable segment class STACK moveable
win_stack = $(or $($(1)_WINSTACK),$(WIN_STACK))
WIN_LINKOPTS := option heapsize=$(WIN_HEAP) option packcode=$(WIN_PACKCODE) \
	$(WIN_SEGMENTS)
WRCFLAGS := -q -bt=windows
NECHK := python3 -I TEST/NECHK.PY --heap $(WIN_HEAP) --imports TEST/W30EXP.TXT
define win_rule
$$(if $$(filter s m,$$($(1)_MODEL)),,$$(error $(1)_MODEL must be s or m))
$$(if $$($(1)_RC),,$$(error $(1)_RC must name its resource script))
$(1)_WINOBJS := $$(patsubst %.C,$(OBJ)/WIN/$$($(1)_MODEL)$(if $(filter $(1),$(WIN_ELIM)),z)/%.OBJ,$$($(1)_SRCS))
ALL_OBJS += $$($(1)_WINOBJS)
$(OBJ)/WIN/$(1).RES: $$($(1)_RC) $$(wildcard $$(dir $$($(1)_RC))*.H $$(dir $$($(1)_RC))*.RC) $(BUILDFILES)
	@mkdir -p $(OBJ)/WIN
	$(WRC) $(WRCFLAGS) -r -i=$(WATCOM)/h/win $$(call wc_inc,$$<) -fo=$$@ $$<
$(BIN)/WIN/$(1).EXE: $$($(1)_WINOBJS) $(OBJ)/WIN/$(1).RES TEST/mapchk.sh TEST/NECHK.PY \
	TEST/W30EXP.TXT
	@mkdir -p $(BIN)/WIN
	@$$(call wlink_run,$(OBJ)/WIN/$(1).LNK,$(1),system windows option map=$(BIN)/WIN/$(1).MAP \
		option stack=$(call win_stack,$(1)) $(WIN_LINKOPTS) \
		$(if $(filter $(1),$(WIN_ELIM)),option eliminate) option description \'RETROINV $(1)\' \
		name $$@ $$(foreach o,$$($(1)_WINOBJS),file $$(o)))
	$(WRC) $(WRCFLAGS) -30 -t $(OBJ)/WIN/$(1).RES $$@
	@sh TEST/mapchk.sh -w $(call win_stack,$(1)) $(call mapchk_args,$(1)) \
		$(BIN)/WIN/$(1).MAP
	@$(NECHK) --stack $(call win_stack,$(1)) $$(NECHK_ICON_$(1)) $$@
	@echo "linked $$@"
endef
# WSMOKE, the test machines' boot check (TEST/WIN/mkwin.sh), has its rule
# whatever WIN_EXES names.
$(foreach e,$(sort $(WIN_EXES) $(WIN_TOOLS) WSMOKE),$(eval $(call win_rule,$(e))))
# WFORMT's resource script includes the form dialog's strings, whose
# labels (SRC/WIN/WLABEL.RC) name messages, as INVWIN's does
# (MSG_NAMESH, below).
$(OBJ)/WIN/WFORMT.RES: SRC/WIN/WFORM.RC SRC/WIN/WLABEL.RC SRC/WIN/WFSTR.H
# INVWIN's icon is drawn as text in SRC/WIN/INVICON.PY, which writes the
