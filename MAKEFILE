WIN_ICON := $(OBJ)/WIN/INVWIN.ICO
NECHK_ICON_INVWIN := --icon INVWIN
$(WIN_ICON): SRC/WIN/INVICON.PY
	@mkdir -p $(OBJ)/WIN
	python3 -I SRC/WIN/INVICON.PY $@
$(OBJ)/WIN/INVWIN.RES: $(WIN_ICON)
# The cursor of an item dragged onto the location tree is drawn as text in
