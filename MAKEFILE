$(OBJ)/WIN/INVWIN.RES $(OBJ)/WIN/WCHRT.RES: $(WIN_TOOLBMP)
# A Windows program keeps the engine's schema data out of DGROUP as its
# resource CSCH_RES (SRC/COMPAT/CSCHDAT.H), which the host tool
