# A header named in a .D file that has since been deleted only forces a
# rebuild instead of stopping make.
%.H: ;

# Host tests: lint, then every program in HOST_TESTS is built from its
# <NAME>_SRCS (<NAME>_HOST for one built for the host alone) under the
# strict host flags and run, as goal hostrun/<NAME>; it must exit with
# <NAME>_HOSTRC (default 0) when given <NAME>_HOSTARGS, whose scratch
# directories (arguments under $(OBJ)/ ending in /) are created first.  A
# test with <NAME>_HOSTCWD runs in that directory (created too), its
# arguments then naming paths from there.  A test in MALLOC_TESTS links
# with malloc and free wrapped, for TESTFW.H's TF_MALLOC section, and
# one with <NAME>_HOSTWRAP with each function it names wrapped.  Each
# program is killed after HOST_TIMEOUT seconds (600 unless set on the
# command line or in the environment), far above the slowest one, so a
# test that hangs fails the run instead of blocking it.
# TEST/T_DUMP.SH builds INVDUMP and DBPACK and compares what they print
# on sample tables with TEST/GOLDEN/INVDUMP.TXT, TEST/T_INV.SH runs the
# host INV /CMD against TEST/GOLDEN/INVCMD.TXT and checks the start-up of
# INV and THIN, and TEST/T_SCR.SH runs the full-screen client's key
# scripts against the golden screens in TEST/GOLDEN/SCR/;
# TEST/T_RCACHE.SH checks the keys and the store of the run cache,
# TEST/T_WATPR.SH and TEST/T_UNPACK.SH check SRC/TCP/WATPREP.PY and
# TEST/INTEG/unpack.sh on synthetic archives,
# TEST/T_ASMCK.SH checks TEST/ASMCHK.PY on small source pairs,
# TEST/T_NECHK.SH checks TEST/NECHK.PY on synthetic Windows programs,
# TEST/T_SHLIB.SH checks helpers of TEST/shlib.sh, TEST/T_VMGATE.SH the
# failure reports of the two-VM gates and the screen gate's runs with
# stand-ins for the VMs, and TEST/T_TOOLS.SH the command lines, output
# and exit statuses of the host NBTEST and COMTEST.
# TEST/szddchk.py compresses files of its own and the sample tables of
# TEST/GOLDEN/DB3/ with REL/szdd.py and has T_LZEXP expand them.
# After lint all of these run side by side in a sub-make, each one's
# output kept together (-Otarget): under an outer "make -j" in its jobs,
# otherwise HOST_JOBS at a time (by default the host's logical CPU
# count).  Every test has a scratch directory of its own and the scripts
# make theirs with mktemp, so no two share a file.
# "make asan" makes test again in a sub-make with HOST_SAN set and
# HOSTOBJ $(OBJ)/ASAN, so that a stray memory access, a leak or undefined
# behaviour fails the test that does it; the scratch directories are
# those of test.  Each report goes to $(OBJ)/ASAN/SAN.<pid>, as some tests
# take over their standard error, and the link-order check is off for
# TEST/T_INV.SH's LD_PRELOAD shim.
ifndef HOST_JOBS
HOST_JOBS := $(shell nproc 2>/dev/null || echo 1)
endif
HOST_TIMEOUT ?= 600

test: lint
	@$(MAKE) --no-print-directory -Otarget $(if $(filter --jobserver%,$(MAKEFLAGS)),,-j$(HOST_JOBS)) testrun

asan:
	@mkdir -p $(OBJ)/ASAN && rm -f $(OBJ)/ASAN/SAN.*
	@ASAN_OPTIONS=verify_asan_link_order=0:log_path=$(CURDIR)/$(OBJ)/ASAN/SAN \
	UBSAN_OPTIONS=print_stacktrace=1:log_path=$(CURDIR)/$(OBJ)/ASAN/SAN \
		$(MAKE) --no-print-directory HOSTOBJ=$(OBJ)/ASAN \
		HOST_SAN='-g -fsanitize=address,undefined -fno-sanitize-recover=all' test

testrun: $(HOST_RUNS) $(HOST_CHECKS)
testrun/dump:
	CFLAGS="$(HOSTCFLAGS) $(call host_inc,TEST/MKITEMS.C)" sh TEST/T_DUMP.SH
testrun/inv: $(HOSTOBJ)/INV.bin $(HOSTOBJ)/$(THIN).bin $(if $(INV_MSGS),$(BIN)/INV.MSG)
	sh TEST/T_INV.SH $(HOSTOBJ)/INV.bin $(HOSTOBJ)/$(THIN).bin
testrun/scr: $(HOSTOBJ)/INV.bin $(if $(INV_MSGS),$(BIN)/INV.MSG) $(BIN)/INV.HLP
	sh TEST/T_SCR.SH $(HOSTOBJ)/INV.bin
testrun/chkdbf:
	python3 -I TEST/CHKDBF.PY --strict $(wildcard TEST/GOLDEN/DB3/*.DBF TEST/GOLDEN/DB3/*.DBT TEST/GOLDEN/DB3/*.NDX)
testrun/chkbad:
	python3 -I TEST/DBASE/chkbad.py
# The backup T_ADMIN leaves of its packed and reindexed data.
testrun/admchk: hostrun/T_ADMIN
	python3 -I TEST/CHKDBF.PY --strict $(OBJ)/HOST/ADMB/*
testrun/rcache:
	sh TEST/T_RCACHE.SH
testrun/watpr:
