# RETROINV build.  GNU make; see DOC/BUILD.md for the toolchain.
#
#   make all    Open Watcom cross-build of every DOS EXE into BIN/ and of
#               every Windows program into BIN/WIN/
#   make wsmoke  the Windows smoke test, BIN/WIN/WSMOKE.EXE, alone
#   make test   gcc host unit tests (strict C89), after lint
#   make dostest  the unit tests as Watcom DOS programs, run in DOSBox-X
#   make dbcheck  sample tables checked by CHKDBF and opened in dBASE III Plus
#   make lint   reject constructs the compilers let through
#   make tc     Turbo C 2.01 build in headless DOSBox-X
#   make wc65   Watcom C 6.5 build in headless DOSBox-X
#   make wc95   Watcom C 9.5 build of the Windows programs of WC95_EXES
#               in headless DOSBox-X
#   make tctest, wc65test  a period build's DOS tests in DOSBox-X
#   make wc95test  the wc95 build's Windows programs on the Windows 3.0
#               test machine, as wintest
#   make tc310, wc65310    a period build's DOS tests on MS-DOS 3.10 (QEMU)
#   make integ  the image shell check, the two-VM NetBIOS, server, screen
#               and starvation gates, winser, winnb, winmbx, the Samba mailbox
#               gate and the Workgroup Add-On gate under QEMU (builds the
#               VM images once), as its parts nbgate, winser, winnb, winmbx,
#               integow, integtc and integwc65
#   make nbgate  integ's image shell check and NetBIOS gates alone
#   make integow, integtc, integwc65  integ's gates of one build alone
#   make stvgate  integ's starvation gate alone
#   make smbgate  integ's Samba mailbox gate alone
#   make wgagate  the image shell check, then integ's Workgroup Add-On
#               gate alone
#   make shellgate  the check of the images' shell patch alone
#   make tcp    the TCP probe of every build on MS-DOS 3.30 and 3.10, and
#               the two-VM TCP gate of every build, under QEMU
#   make dostest1  dostest with each stage's runs one after another (the
#               boot checks of TEST/T_BOOT.SH still side by side)
#   make wintest  the Windows programs on the Windows 3.0 test machine, in
#               standard and 386 enhanced mode under QEMU
#   make winhelp  INVWIN's Windows Help file, compiled by the Windows 3.0
#               SDK's HC.EXE in DOSBox-X (HC/install.sh); not part of gate
#   make winhelpchk  winhelp, then two more compiles of it, which must
#               give the same file; not part of gate
#   make winimg  the test machine's disk alone (TEST/WIN/mkwin.sh)
#   make wintcp  the Winsock test on the Windows for Workgroups 3.11
#               test machine through INVTCP into INVSERV, under QEMU
#   make wfwimg  that machine's disk alone (TEST/WIN/mkwin.sh -w wfw311)
#   make winser  the Windows programs' serial link to INVSERV on MS-DOS
#               3.10, in every mode, under QEMU
#   make winnb  the NET link of the Windows programs against INVSERV on
#               another machine, in both modes, under QEMU
#   make winmbx  the MBOX link of the Windows client against INVSERV's
#               mailbox on a Workgroup Add-On share, in both modes, under
#               QEMU
#   make gate   the commit gate: the targets of GATE_TARGETS side by side
#   make fullgate  the full gate: the commit gate, then dostest1
#   make dist   the release floppy images in DIST/, from the Watcom C 6.5
#               build and the Windows client, with sample data, and the
#               zip of the 1.44 MB disk's files
#   make distcheck  make dist, then check the images and the zip, install
#               from them under QEMU and run the installed DOS programs
#   make lzcheck  make dist, then round trips of every file of the disks
#               through REL/szdd.py and the expander, msexpand too
#   make clean

include SRCS.MK

WATCOM ?= /opt/watcom
export WATCOM
WBIN := $(firstword $(wildcard $(WATCOM)/binl64) $(WATCOM)/binl)
export PATH := $(WBIN):$(PATH)

WCC   := wcc
WLINK := wlink
WRC   := wrc
# The flags of every Open Watcom compile: 8086 code, optimised for size,
# without stack checks; -we turns every warning into an error so "make
# all" is warning-free.  WCFLAGS_DOS adds the DOS target and WCFLAGS_WIN
# (below) the Windows one.
WCFLAGS_BASE := -0 -os -s -zq -wx -we -i=$(WATCOM)/h
WCFLAGS_DOS := -bt=dos -zc
WCFLAGS_ANSI := -za
# Sources under SRC/COMPAT/, the Windows sources of WIN_NOANSI, which
# include windows.h, WATTCP's kernel modules (WATTCP_KERNEL) and our
# sources that include its headers (WATTCP_USERS), the patterns of
# NOANSI, are built without -za, except the portable ones of
# COMPAT_PORTABLE (SRCS.MK), held to strict C89 like the rest.  The
# WATTCP files take its byte packing and signed char, -zp1 -j, as its
# structs are laid out only so; the kernel modules also -w0, as WATTCP's
# 1994 C is changed only as WATTCP.DIF needs, not for its warnings.
WIN_NOANSI := SRC/WIN/% TEST/WSMOKE.C TEST/WTEST.C TEST/WTDRV.C \
	TEST/WTDRV2.C TEST/WLISTT.C TEST/WSOCKT.C TEST/WFORMT.C \
	TEST/WSERT.C TEST/WNET.C TEST/WSKT.C TEST/WTABT.C \
	TEST/WCHRT.C TEST/WSETUP.C
NOANSI := SRC/COMPAT/% $(WIN_NOANSI) $(WATTCP_KERNEL) $(WATTCP_USERS)
wc_ansi = $(if $(filter-out $(COMPAT_PORTABLE),$(filter $(NOANSI),$(1))),,$(WCFLAGS_ANSI))
WCFLAGS_WATTCP := -zp1 -j
wc_wattcp = $(if $(filter $(1),$(WATTCP_KERNEL)),$(WCFLAGS_WATTCP) -w0,$(if $(filter $(1),$(WATTCP_USERS)),$(WCFLAGS_WATTCP)))

HOSTCC := gcc
# The sanitizer switches given to every host compile and link; empty except
# under "make asan" (see test below).
HOST_SAN :=
HOSTCFLAGS := -std=c89 -pedantic -Wall -Wextra -Wconversion -Werror -DHOST_LINUX $(HOST_SAN)
# Upper-case .C means C++ to gcc, so each source is wrapped in
# -x c ... -x none.
HOSTC = -x c $(1) -x none
# The link flags that send a host test's malloc and free calls through
# the wrappers of TESTFW.H's TF_MALLOC section.
HOST_WRAPMEM := -Wl,--wrap=malloc,--wrap=free

BIN := BIN
OBJ := OBJ
# The host build's objects and programs.
HOSTOBJ := $(OBJ)/HOST

# The header directories a source may include from, by the directory it
# is in (INC_<dir>), and those a single source adds (INC_<path>): each
# layer reads its own headers and those of the layers it is built on, so
# that a header of a layer above is not found.  The client reaches the
# engine only through the protocol of LINK.C and its LOCAL backend
# LINKLOC.C; LINKNOL.C, LINKLOC.C's stand-in in a program without the
# engine, reads the engine's text numbers; SRC/COMPAT/ holds the schema
# tables of the engine, the host tool that writes them as a resource
# (CSCHBIN.C) and three DOS-only tests; MSG.C also reads the
# generated $(OBJ)/MSGSTMP.H.  The server is built on the protocol, and
# its main module and status screen use the client's message module;
# INVTEST's script interpreter drives the client's NetBIOS, serial and
# mailbox sessions, and TCPTEST reads the TCP bridge's sockets.  The TCP
# bridge is built on COMPAT alone, the Windows client on the client's
# protocol modules, and its installer SETUP reads the list of INSTALL's
# SRC/TOOLS/INSTPLAN.H.  The tests read them all, and the tests of the
# Windows programs' own modules (WTDRV, WTDRV2, WLISTT, WFORMT, WTABT,
# WCHRT) and SETUP's (WSETUP, T_SETUP) those of SRC/WIN/ too, WFORMT's
# resource script as well.  The resource
# scripts of the Windows programs that link the engine read its schema
# data from $(OBJ)/WIN (CSCH_BLOB, below), INVWIN's its icon too, WCHRT's
# the tool bar's glyphs, and those of INVWIN and WFORMT the message names
# (MSG_NAMESH).  A source in a
# directory without an INC_<dir> stops make.
INC_SRC/COMPAT := SRC/COMPAT
INC_SRC/COMPAT/CSCHEMA.C := SRC/DBF SRC/ENGINE
INC_SRC/COMPAT/CSCHDAT.C := SRC/DBF SRC/ENGINE
INC_SRC/COMPAT/CSCHBIN.C := SRC/DBF SRC/ENGINE
INC_SRC/COMPAT/T_DTA.C := TEST
INC_SRC/COMPAT/T_CLOCK.C := TEST
INC_SRC/COMPAT/T_NHEAP.C := TEST
INC_SRC/COMPAT/T_MSGLO.C := TEST SRC/CLIENT
INC_SRC/COMPAT/T_WCOMP.C := TEST SRC/DBF SRC/ENGINE
INC_SRC/COMPAT/T_UART.C := TEST
INC_SRC/COMPAT/T_CWATT.C := TEST
INC_SRC/DBF := SRC/COMPAT SRC/DBF
INC_SRC/ENGINE := SRC/COMPAT SRC/DBF SRC/ENGINE
INC_SRC/PROTO := SRC/COMPAT SRC/DBF SRC/ENGINE SRC/PROTO
INC_SRC/CLIENT := SRC/COMPAT SRC/CLIENT
INC_SRC/CLIENT/LINK.C := SRC/DBF SRC/ENGINE SRC/PROTO
INC_SRC/CLIENT/LINKLOC.C := SRC/DBF SRC/ENGINE SRC/PROTO
INC_SRC/CLIENT/LINKNOL.C := SRC/DBF SRC/ENGINE
INC_SRC/CLIENT/MSG.C := $(OBJ)
INC_SRC/SERVER := SRC/COMPAT SRC/DBF SRC/ENGINE SRC/PROTO SRC/SERVER
INC_SRC/SERVER/SRVRUN.C := SRC/CLIENT
INC_SRC/SERVER/SRVSCR.C := SRC/CLIENT
INC_SRC/TOOLS := SRC/COMPAT SRC/DBF SRC/TOOLS
INC_SRC/TOOLS/INVSCR.C := SRC/CLIENT
INC_SRC/TOOLS/TCPTEST.C := SRC/TCP
INC_SRC/TCP := SRC/COMPAT SRC/TCP
INC_SRC/WIN := SRC/COMPAT SRC/CLIENT SRC/WIN
INC_SRC/WIN/SETUP.C := SRC/TOOLS
INC_SRC/WIN/SETUPL.C := SRC/TOOLS
INC_TEST := SRC/COMPAT SRC/DBF SRC/ENGINE SRC/PROTO SRC/SERVER SRC/CLIENT \
	SRC/TOOLS SRC/TCP TEST
INC_TEST/WTDRV.C := SRC/WIN
INC_TEST/WTDRV2.C := SRC/WIN
INC_TEST/WLISTT.C := SRC/WIN
INC_TEST/WFORMT.C := SRC/WIN
INC_TEST/WTABT.C := SRC/WIN
INC_TEST/WCHRT.C := SRC/WIN
INC_TEST/WSETUP.C := SRC/WIN
INC_TEST/T_SETUP.C := SRC/WIN
INC_TEST/WFORMT.RC := SRC/WIN $(OBJ)/WIN
INC_TEST/WLISTT.RC := $(OBJ)/WIN
INC_TEST/WCHRT.RC := $(OBJ)/WIN
INC_TEST/WTESTE.RC := $(OBJ)/WIN
INC_SRC/WIN/INVWIN.RC := $(OBJ)/WIN
# WATTCP's kernel modules read its headers and SRC/COMPAT/WTSHIM.H, and our
# sources that include its headers read them too.
INC_$(WATTCP_DIR)/SRC := $(WATTCP_DIR)/INCLUDE SRC/COMPAT
inc_dir = $(patsubst %/,%,$(dir $(1)))
inc_dirs = $(or $(INC_$(inc_dir)), \
	$(error $(1): no INC_$(inc_dir) in MAKEFILE)) $(INC_$(1)) \
	$(if $(filter $(1),$(WATTCP_USERS)),$(WATTCP_DIR)/INCLUDE)
wc_inc = $(patsubst %,-i=%,$(call inc_dirs,$(1)))
host_inc = $(patsubst %,-I%,$(call inc_dirs,$(1)))

# The goals of "make test" (see test below): one run per program of
# HOST_TESTS and the script checks.
HOST_RUNS := $(addprefix hostrun/,$(HOST_TESTS))
HOST_CHECKS := testrun/dump testrun/inv testrun/scr testrun/chkdbf testrun/chkbad testrun/rcache \
	testrun/watpr testrun/unpack testrun/asmck testrun/nechk testrun/shlib testrun/vmgate \
	testrun/admchk testrun/tools testrun/colchk testrun/cbochk testrun/tabchk \
