	testrun/framchk testrun/splitchk testrun/headchk testrun/dlgchk testrun/mousechk \
	testrun/rtfchk testrun/dragchk testrun/selchk testrun/szdd

.PHONY: all wsmoke test asan lint tc wc65 wc95 tctest wc65test wc95test tc310 wc65310 integ nbgate integow integtc integwc65 stvgate smbgate wgagate shellgate tcp dostest dostest1 wintest winhelp winhelpchk winimg winser \
	wintcp wfwimg winnb winmbx dbcheck \
	gate fullgate dist distcheck lzcheck clean \
