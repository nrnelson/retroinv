/*
 * WTABT.RC - the resources of the tab strip's test, TEST/WTABT.C: the
 * strip's tabs and the dialog it opens in, which leaves room above the
 * edit control for the strip.
 */
#include <windows.h>
#include "WTABT.H"

STRINGTABLE
BEGIN
    WTT_S_TABS, "Overview|Technical|Ac&quisition|Notes"
END

WTT_D_MAIN DIALOG 0, 0, 220, 76
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "WTABT"
BEGIN
    EDITTEXT WTT_EDIT, 8, 24, 120, 12, ES_AUTOHSCROLL
    LTEXT "SEEN 0 CUR 0", WTT_SEEN, 8, 42, 120, 8
    DEFPUSHBUTTON "OK", IDOK, 40, 56, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 130, 56, 50, 14
END
