# LTYPES.SCR - LTYPE commands: the seeded list, every success and error
# response, ordering, a type kept while a live location has it, and the
# fixed-size table that reuses deleted rows.  The commands share their
# code with CAT (CATS.SCR); what differs is the table, its wider code,
# its texts and what keeps a type in use.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK

> LTYPE LIST
< +DATA
< F LT_CODE LT_NAME SORTORD
< R ROOM Room 1
< R SHELF Shelf 2
< R RACK Rack 3
< R CABINET Cabinet 4
< R DRAWER Drawer 5
< R BOX Box 6
< R BIN Bin 7
< R BUCKET Bucket 8
< .
> LTYPE LIST X
< -ERR 100 too many arguments
> LTYPE LIST SORTORD=1
< -ERR 102 unexpected key FIELD=SORTORD

# LTYPE ADD: codes of 1 to ENG_LTYPELEN letters and digits.
> LTYPE ADD crate LT_NAME=Crates SORTORD=6
< +OK
> LTYPE ADD LOCKER LT_NAME=Lockers
< +OK
> LTYPE ADD CABINET2 LT_NAME="Tall cabinets" SORTORD=0
< +OK
> LTYPE LIST
< +DATA
< F LT_CODE LT_NAME SORTORD
< R CABINET2 "Tall cabinets" 0
< R ROOM Room 1
< R SHELF Shelf 2
< R RACK Rack 3
< R CABINET Cabinet 4
< R DRAWER Drawer 5
< R BOX Box 6
< R CRATE Crates 6
< R BIN Bin 7
< R BUCKET Bucket 8
< R LOCKER Lockers 50
< .
> LTYPE ADD CRATE LT_NAME=Again
< -ERR 201 location type already exists FIELD=LT_CODE
> LTYPE ADD ROOM LT_NAME=Again
< -ERR 201 location type already exists FIELD=LT_CODE
> LTYPE ADD CABINET22 LT_NAME=x
< -ERR 102 bad location type code FIELD=LT_CODE
> LTYPE ADD A-B LT_NAME=x
< -ERR 102 bad location type code FIELD=LT_CODE
> LTYPE ADD ""
< -ERR 102 bad location type code FIELD=LT_CODE
> LTYPE ADD NEW
< -ERR 102 value required FIELD=LT_NAME
> LTYPE ADD NEW LT_NAME=""
< -ERR 102 value required FIELD=LT_NAME
> LTYPE ADD NEW LT_NAME=x SORTORD=-1
< -ERR 102 negative value FIELD=SORTORD
> LTYPE ADD NEW LT_NAME=x SORTORD=100
< -ERR 102 bad value FIELD=SORTORD
> LTYPE ADD NEW LT_NAME="123456789012345678901"
< -ERR 102 value too long FIELD=LT_NAME
> LTYPE ADD NEW LT_NAME=x LT_CODE=NEW
< -ERR 102 field not settable FIELD=LT_CODE
> LTYPE ADD NEW LT_NAME=x FOO=1
< -ERR 102 field not settable FIELD=FOO
> LTYPE ADD NEW OLD LT_NAME=x
< -ERR 100 too many arguments
> LTYPE ADD LT_NAME=x
< -ERR 102 missing argument FIELD=LT_CODE

# LTYPE SET.
> LTYPE SET LOCKER LT_NAME="Lockers and safes" SORTORD=99
< +OK
> LTYPE SET locker SORTORD=
< -ERR 102 sort order required FIELD=SORTORD
> LTYPE SET LOCKER LT_NAME=
< -ERR 102 value required FIELD=LT_NAME
> LTYPE SET LOCKER LT_CODE=SAFE
< -ERR 102 field not settable FIELD=LT_CODE
> LTYPE SET LOCKER SORTORD=x
< -ERR 102 not a number FIELD=SORTORD
> LTYPE SET NONE LT_NAME=x
< -ERR 200 no such location type
> LTYPE SET
< -ERR 102 missing argument FIELD=LT_CODE
> LTYPE SET LOCKER CRATE SORTORD=1
< -ERR 100 too many arguments
> LTYPE LIST
< +DATA
< F LT_CODE LT_NAME SORTORD
< R CABINET2 "Tall cabinets" 0
< R ROOM Room 1
< R SHELF Shelf 2
< R RACK Rack 3
< R CABINET Cabinet 4
< R DRAWER Drawer 5
< R BOX Box 6
< R CRATE Crates 6
< R BIN Bin 7
< R BUCKET Bucket 8
< R LOCKER "Lockers and safes" 99
< .

# LTYPE DEL: refused while a live location has the type, which a
# location cannot take once it is deleted.
> LOC ADD LOC_NAME=Garage LTYPE=crate
< +OK ID=1
> LTYPE DEL CRATE
< -ERR 202 locations still use this location type
> LOC DEL 1
< +OK
> LTYPE DEL CRATE
< +OK
> LTYPE DEL CRATE
< -ERR 200 no such location type
> LTYPE DEL NONE
< -ERR 200 no such location type
> LTYPE DEL
< -ERR 102 missing argument FIELD=LT_CODE
> LTYPE DEL LOCKER CABINET2
< -ERR 100 too many arguments
> LTYPE DEL LOCKER X=1
< -ERR 102 unexpected key FIELD=X
> LOC ADD LOC_NAME=Garage LTYPE=CRATE
< -ERR 202 unknown location type FIELD=LTYPE
> LTYPE ADD CRATE LT_NAME="Crates again"
< +OK
> LOC ADD LOC_NAME=Garage LTYPE=CRATE
< +OK ID=2
> LTYPE LIST
< +DATA
< F LT_CODE LT_NAME SORTORD
< R CABINET2 "Tall cabinets" 0
< R ROOM Room 1
< R SHELF Shelf 2
< R RACK Rack 3
< R CABINET Cabinet 4
< R DRAWER Drawer 5
< R BOX Box 6
< R BIN Bin 7
< R BUCKET Bucket 8
< R CRATE "Crates again" 50
< R LOCKER "Lockers and safes" 99
< .

# LTYPES.DBF holds at most ENG_MAXCODES records: 8 seeded and 4 added so
# far, one of them deleted.  T01 to T38 fill it, T39 takes the deleted
# row, T40 is refused until a delete frees a row, which the next ADD
# then reuses.
> LTYPE ADD T01 LT_NAME=x SORTORD=90
< +OK
> LTYPE ADD T02 LT_NAME=x SORTORD=90
< +OK
> LTYPE ADD T03 LT_NAME=x SORTORD=90
< +OK
