< +OK
> LTYPE ADD T12 LT_NAME=x SORTORD=90
< +OK
> LTYPE ADD T13 LT_NAME=x SORTORD=90
< +OK
> LTYPE ADD T14 LT_NAME=x SORTORD=90
< +OK
> LTYPE ADD T15 LT_NAME=x SORTORD=90
< +OK
