# CAT commands: the seeded list, every success and error response,
# ordering, and the fixed-size table that reuses deleted rows.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK

> CAT LIST
< +DATA
< F CAT_CODE CAT_NAME SORTORD
< R SYS Systems 1
< R MOBO Motherboards 2
< R CPU Processors 3
< R CARD "Expansion cards" 4
< R DRV Drives 5
< R PERI Peripherals 6
< R SW Software 7
< R MAN Manuals 8
< R CBL Cables 9
< R PART Parts 10
< .
> CAT LIST X
< -ERR 100 too many arguments
> CAT LIST SORTORD=1
< -ERR 102 unexpected key FIELD=SORTORD

# CAT ADD.
> CAT ADD tape CAT_NAME="Tape drives" SORTORD=5
< +OK
> CAT ADD GAME CAT_NAME=Games
< +OK
> CAT ADD AAA CAT_NAME=First SORTORD=0
< +OK
> CAT LIST
< +DATA
< F CAT_CODE CAT_NAME SORTORD
< R AAA First 0
< R SYS Systems 1
< R MOBO Motherboards 2
< R CPU Processors 3
< R CARD "Expansion cards" 4
< R DRV Drives 5
< R TAPE "Tape drives" 5
< R PERI Peripherals 6
< R SW Software 7
< R MAN Manuals 8
< R CBL Cables 9
< R PART Parts 10
< R GAME Games 50
< .
> CAT ADD TAPE CAT_NAME=Again
< -ERR 201 category already exists FIELD=CAT_CODE
> CAT ADD SYS CAT_NAME=Again
< -ERR 201 category already exists FIELD=CAT_CODE
> CAT ADD TOOLONG CAT_NAME=x
< -ERR 102 bad category code FIELD=CAT_CODE
> CAT ADD A-B CAT_NAME=x
< -ERR 102 bad category code FIELD=CAT_CODE
> CAT ADD ""
< -ERR 102 bad category code FIELD=CAT_CODE
> CAT ADD NEW
< -ERR 102 value required FIELD=CAT_NAME
> CAT ADD NEW CAT_NAME=""
< -ERR 102 value required FIELD=CAT_NAME
> CAT ADD NEW CAT_NAME=x SORTORD=-1
< -ERR 102 negative value FIELD=SORTORD
> CAT ADD NEW CAT_NAME=x SORTORD=100
< -ERR 102 bad value FIELD=SORTORD
> CAT ADD NEW CAT_NAME="123456789012345678901"
< -ERR 102 value too long FIELD=CAT_NAME
> CAT ADD NEW CAT_NAME=x CAT_CODE=NEW
< -ERR 102 field not settable FIELD=CAT_CODE
> CAT ADD NEW CAT_NAME=x FOO=1
< -ERR 102 field not settable FIELD=FOO
> CAT ADD NEW OLD CAT_NAME=x
< -ERR 100 too many arguments
> CAT ADD CAT_NAME=x
< -ERR 102 missing argument FIELD=CAT_CODE

# CAT SET.
> CAT SET GAME CAT_NAME="Games and toys" SORTORD=99
< +OK
> CAT SET game SORTORD=
< -ERR 102 sort order required FIELD=SORTORD
> CAT SET GAME CAT_NAME=
< -ERR 102 value required FIELD=CAT_NAME
> CAT SET GAME CAT_CODE=GAMZ
< -ERR 102 field not settable FIELD=CAT_CODE
> CAT SET GAME SORTORD=x
< -ERR 102 not a number FIELD=SORTORD
> CAT SET NONE CAT_NAME=x
< -ERR 200 no such category
> CAT SET
< -ERR 102 missing argument FIELD=CAT_CODE
> CAT SET GAME AAA SORTORD=1
< -ERR 100 too many arguments
> CAT LIST
< +DATA
< F CAT_CODE CAT_NAME SORTORD
< R AAA First 0
< R SYS Systems 1
< R MOBO Motherboards 2
< R CPU Processors 3
< R CARD "Expansion cards" 4
< R DRV Drives 5
< R TAPE "Tape drives" 5
< R PERI Peripherals 6
< R SW Software 7
< R MAN Manuals 8
< R CBL Cables 9
< R PART Parts 10
< R GAME "Games and toys" 99
< .

# CAT DEL: refused while a live item uses the code.
> ITEM ADD CATEGORY=TAPE MFR=Colorado
< +OK ID=1
> CAT DEL TAPE
< -ERR 202 items still use this category
> ITEM DEL 1
< +OK
> CAT DEL TAPE
< +OK
> CAT DEL TAPE
< -ERR 200 no such category
> CAT DEL NONE
< -ERR 200 no such category
> CAT DEL
< -ERR 102 missing argument FIELD=CAT_CODE
> CAT DEL AAA GAME
< -ERR 100 too many arguments
> CAT DEL AAA X=1
< -ERR 102 unexpected key FIELD=X
> ITEM ADD CATEGORY=TAPE
< -ERR 202 unknown category FIELD=CATEGORY
> ITEM UNDEL 1
< -ERR 202 category not live FIELD=CATEGORY
> CAT ADD TAPE CAT_NAME="Tape again"
< +OK
> ITEM UNDEL 1
< +OK
> CAT LIST
< +DATA
< F CAT_CODE CAT_NAME SORTORD
< R AAA First 0
< R SYS Systems 1
< R MOBO Motherboards 2
< R CPU Processors 3
< R CARD "Expansion cards" 4
< R DRV Drives 5
< R PERI Peripherals 6
< R SW Software 7
< R MAN Manuals 8
< R CBL Cables 9
< R PART Parts 10
< R TAPE "Tape again" 50
< R GAME "Games and toys" 99
< .

# CATS.DBF holds at most ENG_MAXCODES records: 10 seeded and 4 added so
# far, one of them deleted.  C01 to C36 fill it, C37 takes the deleted
# row, C38 is refused until a delete frees a row, which the next ADD then
# reuses.
> CAT ADD C01 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C02 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C03 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C04 CAT_NAME=x SORTORD=90
< +OK
