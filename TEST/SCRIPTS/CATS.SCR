< +OK
> CAT ADD C10 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C11 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C12 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C13 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C14 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C15 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C16 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C17 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C18 CAT_NAME=x SORTORD=90
< +OK
> CAT ADD C19 CAT_NAME=x SORTORD=90
< +OK
