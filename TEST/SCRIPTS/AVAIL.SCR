< +DATA
< F ITEM_ID
< R 2
< .
> ITEM FIND intel CAT=CARD FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< .
> ITEM FIND ibm LOC=A1 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 2
< .
> ITEM FIND ibm LOC=b2 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 5
< R 10
