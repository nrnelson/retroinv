# AVAIL=1 on ITEM LIST and ITEM FIND (live, STATUS A, top level, units
# not all lent, reserved or in use) and AVAIL=0 (every other live item),
# ITEM FIND with CAT=, LOC= and STATUS= (ANDed with the text match,
# record order kept) and with ALL=1 (the tree below LOC=), and LOC
# CONTENTS TOP=1 (installed parts left out).
#
# Fixture (A = available):
#   1 SYS  Compaq Portable      A1  qty 1                 A
#   2 MOBO IBM 64-256K          A1  installed in 1
#   3 CPU  Intel 8088           A1  qty 4, all 4 on loan
#   4 CPU  Intel 8087           B2  qty 4, 2 on loan, zz  A
#   5 CARD IBM CGA              B2  qty 2, STATUS D
#   6 DRV  Seagate ST-225       --  qty 1, zz             A
#   7 CARD Hercules Graphics    B2  deleted
#   8 CARD Hercules MDA         A1  qty 1, zz             A
#   9 PART Acme Screw           A1  installed in 2
#  10 CARD IBM MDA              B2  qty 2, zz             A
# C3 is an empty location.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK
> LOC ADD LOC_NAME=A1 LTYPE=BIN LOC_CODE=A1
< +OK ID=1
> LOC ADD LOC_NAME=B2 LTYPE=BIN LOC_CODE=B2
< +OK ID=2
> LOC ADD LOC_NAME=C3 LTYPE=BIN LOC_CODE=C3
< +OK ID=3
> ITEM ADD CATEGORY=SYS MFR=Compaq MODEL=Portable LOC_ID=A1
< +OK ID=1
> ITEM ADD CATEGORY=MOBO MFR=IBM MODEL="64-256K"
< +OK ID=2
> ITEM ADD CATEGORY=CPU MFR=Intel MODEL=8088 QTY=4 LOC_ID=A1
< +OK ID=3
> ITEM ADD CATEGORY=CPU MFR=Intel MODEL=8087 QTY=4 LOC_ID=B2 TAGS=zz
< +OK ID=4
> ITEM ADD CATEGORY=CARD MFR=IBM MODEL=CGA QTY=2 LOC_ID=B2 STATUS=D
< +OK ID=5
> ITEM ADD CATEGORY=DRV MFR=Seagate MODEL=ST-225 TAGS=zz
< +OK ID=6
> ITEM ADD CATEGORY=CARD MFR=Hercules MODEL=Graphics LOC_ID=B2
< +OK ID=7
> ITEM ADD CATEGORY=CARD MFR=Hercules MODEL=MDA LOC_ID=A1 TAGS=zz
< +OK ID=8
> ITEM ADD CATEGORY=PART MFR=Acme MODEL=Screw
< +OK ID=9
> ITEM ADD CATEGORY=CARD MFR=IBM MODEL=MDA QTY=2 LOC_ID=B2 TAGS=zz
< +OK ID=10
> ITEM DEL 7
< +OK
> ASSY INSTALL 2 1
< +OK
> ASSY INSTALL 9 2
< +OK
> LOAN OUT 3 QTY=4 HOLDER=Al DUE=20261231
< +OK ID=1
> LOAN OUT 4 QTY=2 HOLDER=Bo DUE=20261231
< +OK ID=2

# AVAIL=1 on ITEM LIST: installed, fully loaned, STATUS D and deleted
# items are out; a partly loaned item stays.
> ITEM LIST AVAIL=1 FIELDS=ITEM_ID,QTY,ON_LOAN
< +DATA
< F ITEM_ID QTY ON_LOAN
< R 1 1 0
< R 4 4 2
< R 6 1 0
< R 8 1 0
< R 10 2 0
< .
> item list avail=1 fields=item_id
< +DATA
< F ITEM_ID
< R 1
< R 4
< R 6
< R 8
< R 10
< .

# AVAIL=0 keeps the live items AVAIL=1 leaves out; AVAIL= is no filter.
> ITEM LIST AVAIL=0 FIELDS=ITEM_ID,QTY,ON_LOAN
< +DATA
< F ITEM_ID QTY ON_LOAN
< R 2 1 0
< R 3 4 4
< R 5 2 0
< R 9 1 0
< .
> ITEM LIST AVAIL= FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< R 2
< R 3
< R 4
< R 5
< R 6
< R 8
< R 9
< R 10
< .
> ITEM LIST FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< R 2
< R 3
< R 4
< R 5
< R 6
< R 8
< R 9
< R 10
< .

# Combined with CAT, LOC and STATUS (AND), in the filters' own orders.
> ITEM LIST AVAIL=1 CAT=CARD FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 8
< R 10
< .
> ITEM LIST AVAIL=0 CAT=CARD FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 5
< .
> ITEM LIST AVAIL=1 CAT=cpu FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 4
< .
> ITEM LIST AVAIL=1 CAT=MOBO FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< .
> ITEM LIST AVAIL=1 CAT=PART FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< .
> ITEM LIST AVAIL=1 CAT=NONE FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< .
> ITEM LIST AVAIL=1 LOC=A1 ORDER=ID FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< R 8
< .
> ITEM LIST AVAIL=1 LOC=b2 ORDER=ID FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 4
< R 10
< .
> ITEM LIST AVAIL=0 LOC=B2 ORDER=ID FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 5
< .
> ITEM LIST AVAIL=1 LOC=C3 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< .
> ITEM LIST AVAIL=1 STATUS=A FIELDS=ITEM_ID
< -ERR 102 bad or missing argument FIELD=STATUS
> ITEM LIST AVAIL=1 STATUS=D FIELDS=ITEM_ID
< -ERR 102 bad or missing argument FIELD=STATUS
> ITEM LIST AVAIL=1 STATUS= CAT=CARD LOC=B2 ORDER=ID FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 10
< .
> ITEM LIST AVAIL=0 STATUS=D FIELDS=ITEM_ID
< -ERR 102 bad or missing argument FIELD=STATUS
> ITEM LIST AVAIL=0 STATUS= FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 2
< R 3
< R 5
< R 9
< .
> ITEM LIST AVAIL=1 CAT=CARD LOC=B2 STATUS=A ORDER=ID FIELDS=ITEM_ID
< -ERR 102 bad or missing argument FIELD=STATUS
> ITEM LIST AVAIL=1 CAT=CPU LOC=A1 ORDER=ID FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< .
> ITEM LIST AVAIL=1 ORDER=LOC FIELDS=ITEM_ID,LOC_ID
< +DATA
< F ITEM_ID LOC_ID
< R 6 0
< R 1 1
< R 8 1
< R 4 2
< R 10 2
< .

# Paging: the filter applies before the page is cut.
> ITEM LIST AVAIL=1 PAGE=2 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< R 4
< C ITEMS1:2020202020202034:4
< .
> ITEM LIST AVAIL=1 PAGE=2 FIELDS=ITEM_ID AFTER=ITEMS1:2020202020202034:4
< +DATA
< F ITEM_ID
< R 6
< R 8
< C ITEMS1:2020202020202038:8
< .
> ITEM LIST AVAIL=1 PAGE=2 FIELDS=ITEM_ID AFTER=ITEMS1:2020202020202038:8
< +DATA
< F ITEM_ID
< R 10
< .

# Bad AVAIL values.
> ITEM LIST AVAIL=2
< -ERR 102 bad or missing argument FIELD=AVAIL
> ITEM LIST AVAIL=x
< -ERR 102 bad or missing argument FIELD=AVAIL
> ITEM LIST AVAIL=yes
< -ERR 102 bad or missing argument FIELD=AVAIL
> ITEM LIST AVAIL=01
< -ERR 102 bad or missing argument FIELD=AVAIL
> ITEM LIST AVAIL=-1
< -ERR 102 bad or missing argument FIELD=AVAIL
> ITEM LIST AVAIL=1 AVAIL=0
< -ERR 102 bad or missing argument FIELD=AVAIL

# ITEM FIND: AVAIL=1 and the filters of ITEM LIST.  The text alone first.
