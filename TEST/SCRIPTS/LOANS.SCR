# LOAN commands: every success and error response, FIELD= reporting,
# the DUE and DATE aliases, ON_LOAN upkeep, the LATE column, list
# orders, overdue dates, paging with cursors, the rules shared with
# assemblies, and the audit rows; then LOAN RESERVE and LOAN USE, the
# counters they keep, the rules of a host and the lists by host, kind
# and holder.  The clock is 2026-10-08 until the LATE check moves it.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK
> ITEM ADD CATEGORY=CPU MFR=Intel MODEL=8088 QTY=3
< +OK ID=1
> ITEM ADD CATEGORY=CARD MFR=Hercules MODEL="Graphics Card"
< +OK ID=2
> ITEM ADD CATEGORY=DRV MFR=Seagate MODEL=ST-225 STATUS=D
< +OK ID=3

# No loans yet.
> LOAN LIST
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .
> LOAN OVERDUE
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .
> LOAN GET 1
< -ERR 200 not found FIELD=ID

# LOAN OUT: QTY defaults to 1 and OUT_DATE to today.
> LOAN OUT 1 HOLDER="Jane Smith" DUE=20261022
< +OK ID=1
> LOAN GET 1
< +DATA
< K LOAN_ID=1
< K ITEM_ID=1
< K KIND=L
< K QTY=1
< K HOLDER="Jane Smith"
< K HOST_ID=0
< K CONTACT=""
< K OUT_DATE=20261008
< K DUE_DATE=20261022
< K RET_DATE=""
< K NOTES=""
< .
> ITEM GET 1
< +DATA
<*
> ITEM LIST FIELDS=ITEM_ID,QTY,ON_LOAN
< +DATA
< F ITEM_ID QTY ON_LOAN
< R 1 3 1
< R 2 1 0
< R 3 1 0
< .

# LOAN ADD is the same command; the full field names are accepted.
> LOAN ADD 1 QTY=2 HOLDER=Bob CONTACT="555-1234" OUT_DATE=20261001 DUE_DATE=20261005 NOTES="Two of them"
< +OK ID=2
> LOAN GET 2
< +DATA
< K LOAN_ID=2
< K ITEM_ID=1
< K KIND=L
< K QTY=2
< K HOLDER=Bob
< K HOST_ID=0
< K CONTACT=555-1234
< K OUT_DATE=20261001
< K DUE_DATE=20261005
< K RET_DATE=""
< K NOTES="Two of them"
< .
> loan out 2 HOLDER=Carol DATE=20260901 DUE=20261008
< +OK ID=3
> ITEM LIST FIELDS=ITEM_ID,QTY,ON_LOAN
< +DATA
< F ITEM_ID QTY ON_LOAN
< R 1 3 3
< R 2 1 1
< R 3 1 0
< .

# LOAN OUT errors.
> LOAN OUT 1 HOLDER=Al DUE=20261231
< -ERR 202 not enough on hand FIELD=QTY
> LOAN OUT 3 HOLDER=Al DUE=20261231
< -ERR 202 item was disposed of FIELD=ITEM
> LOAN OUT 99 HOLDER=Al DUE=20261231
< -ERR 200 no such item FIELD=ITEM
> LOAN OUT x HOLDER=Al DUE=20261231
< -ERR 102 bad ID FIELD=ITEM
> LOAN OUT 0 HOLDER=Al DUE=20261231
< -ERR 102 bad ID FIELD=ITEM
> LOAN OUT 123456789 HOLDER=Al DUE=20261231
< -ERR 102 bad ID FIELD=ITEM
> LOAN OUT HOLDER=Al DUE=20261231
< -ERR 102 missing argument FIELD=ITEM
> LOAN OUT 1 2 HOLDER=Al DUE=20261231
< -ERR 100 too many arguments
> ITEM ADD CATEGORY=CPU MFR=NEC MODEL=V20 QTY=2
< +OK ID=4
> LOAN OUT 4 DUE=20261231
< -ERR 102 value required FIELD=HOLDER
> LOAN OUT 4 HOLDER=""  DUE=20261231
< -ERR 102 value required FIELD=HOLDER
> LOAN OUT 4 HOLDER=Al
< -ERR 102 value required FIELD=DUE_DATE
> LOAN OUT 4 HOLDER=Al DUE=
< -ERR 102 value required FIELD=DUE_DATE
> LOAN OUT 4 HOLDER=Al DUE=20261007
< -ERR 102 due date before out date FIELD=DUE_DATE
> LOAN OUT 4 HOLDER=Al DATE=20261010 DUE_DATE=20261009
< -ERR 102 due date before out date FIELD=DUE_DATE
> LOAN OUT 4 HOLDER=Al DUE=20261332
< -ERR 102 bad value FIELD=DUE_DATE
> LOAN OUT 4 HOLDER=Al DUE=20261231 QTY=0
< -ERR 102 bad or missing argument FIELD=QTY
> LOAN OUT 4 HOLDER=Al DUE=20261231 QTY=-1
< -ERR 102 negative value FIELD=QTY
> LOAN OUT 4 HOLDER=Al DUE=20261231 QTY=x
< -ERR 102 not a number FIELD=QTY
> LOAN OUT 4 HOLDER=Al DUE=20261231 QTY=3
< -ERR 202 not enough on hand FIELD=QTY
> LOAN OUT 4 HOLDER=Al DUE=20261231 QTY=1 QTY=2
< -ERR 102 bad or missing argument FIELD=QTY
> LOAN OUT 4 HOLDER=Al DUE=20261231 DUE_DATE=20261231
< -ERR 102 bad or missing argument FIELD=DUE_DATE
> LOAN OUT 4 HOLDER=Al DUE=20261231 DATE=20261008 OUT_DATE=20261008
< -ERR 102 bad or missing argument FIELD=OUT_DATE
> LOAN OUT 4 HOLDER=Al DUE=20261231 RET_DATE=20261010
< -ERR 102 field not settable FIELD=RET_DATE
> LOAN OUT 4 HOLDER=Al DUE=20261231 LOAN_ID=7
< -ERR 102 unexpected key FIELD=LOAN_ID
> LOAN OUT 4 HOLDER=Al DUE=20261231 ITEM_ID=1
< -ERR 102 unexpected key FIELD=ITEM_ID
> LOAN OUT 4 HOLDER=Al DUE=20261231 FOO=1
< -ERR 102 unexpected key FIELD=FOO
> LOAN OUT 4 HOLDER=Al DUE=20261231 ITEM=1
< -ERR 102 unexpected key FIELD=ITEM
> LOAN OUT 4 HOLDER=Al DUE=20261231 CONTACT="1234567890123456789012345678901"
< -ERR 102 value too long FIELD=CONTACT
> ITEM DEL 4
< +OK
> LOAN OUT 4 HOLDER=Al DUE=20261231
< -ERR 200 no such item FIELD=ITEM
> ITEM LIST FIELDS=ITEM_ID,QTY,ON_LOAN
< +DATA
< F ITEM_ID QTY ON_LOAN
< R 1 3 3
< R 2 1 1
< R 3 1 0
< .

# The item rules while a quantity is on loan.
> ITEM SET 1 QTY=2
< -ERR 202 quantity below units lent, reserved or in use FIELD=QTY
> ITEM DEL 2
< -ERR 202 item is on loan FIELD=ON_LOAN
> ITEM SET 2 STATUS=D
< -ERR 202 item is on loan FIELD=STATUS

# LOAN GET errors.
> LOAN GET 99
< -ERR 200 not found FIELD=ID
> LOAN GET
< -ERR 102 missing argument FIELD=ID
> LOAN GET 1x
< -ERR 102 bad ID FIELD=ID
> LOAN GET 1 2
< -ERR 100 too many arguments
> LOAN GET 1 FIELDS=QTY
< -ERR 102 unexpected key FIELD=FIELDS

# LOAN LIST: open loans first by due date.  Loan 2 was due before
# today and is late; loan 3 is due today and is not.
> LOAN LIST
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 2 1 L 2 Bob 0 555-1234 20261001 20261005 "" Intel 8088
< R 0 3 2 L 1 Carol 0 "" 20260901 20261008 "" Hercules "Graphics Card"
< R 0 1 1 L 1 "Jane Smith" 0 "" 20261008 20261022 "" Intel 8088
< .
> LOAN LIST PAGE=2
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 2 1 L 2 Bob 0 555-1234 20261001 20261005 "" Intel 8088
< R 0 3 2 L 1 Carol 0 "" 20260901 20261008 "" Hercules "Graphics Card"
< C LOANS2:2020203032303236313030382020202020202033:3
< .
> LOAN LIST PAGE=2 AFTER=LOANS2:2020203032303236313030382020202020202033:3
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 1 1 L 1 "Jane Smith" 0 "" 20261008 20261022 "" Intel 8088
< .
> LOAN LIST ITEM=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 1 1 L 1 "Jane Smith" 0 "" 20261008 20261022 "" Intel 8088
< R 1 2 1 L 2 Bob 0 555-1234 20261001 20261005 "" Intel 8088
< .
> LOAN LIST ITEM=0001 PAGE=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 1 1 L 1 "Jane Smith" 0 "" 20261008 20261022 "" Intel 8088
< C LOANS1:20202020202020312020202020202031:1
< .
> LOAN LIST ITEM=1 PAGE=1 AFTER=LOANS1:20202020202020312020202020202031:1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 2 1 L 2 Bob 0 555-1234 20261001 20261005 "" Intel 8088
< .
> LOAN LIST ITEM=3
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .
> LOAN LIST ITEM=
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 2 1 L 2 Bob 0 555-1234 20261001 20261005 "" Intel 8088
< R 0 3 2 L 1 Carol 0 "" 20260901 20261008 "" Hercules "Graphics Card"
< R 0 1 1 L 1 "Jane Smith" 0 "" 20261008 20261022 "" Intel 8088
< .

