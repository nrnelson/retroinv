> LOAN LIST OPEN=11
< -ERR 102 bad or missing argument FIELD=OPEN
> LOAN LIST PAGE=0
< -ERR 102 bad page size FIELD=PAGE
> LOAN LIST FIELDS=QTY
< -ERR 102 unexpected key FIELD=FIELDS
> LOAN LIST ASOF=20261001
< -ERR 102 unexpected key FIELD=ASOF
> LOAN LIST 1
< -ERR 100 too many arguments
> LOAN LIST AFTER=LOANS1:20202020202020312020202020202031:1
< -ERR 204 bad cursor
> LOAN LIST ITEM=1 AFTER=LOANS2:2020203032303236313030382020202020202033:3
< -ERR 204 bad cursor

# LOAN OVERDUE: open loans due before ASOF (default today), every one
# late.
> LOAN OVERDUE
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 2 1 L 2 Bob 0 555-1234 20261001 20261005 "" Intel 8088
< .
> LOAN OVERDUE ASOF=
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 2 1 L 2 Bob 0 555-1234 20261001 20261005 "" Intel 8088
< .
> LOAN OVERDUE ASOF=20261005
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .
> LOAN OVERDUE ASOF=20261009
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 2 1 L 2 Bob 0 555-1234 20261001 20261005 "" Intel 8088
< R 1 3 2 L 1 Carol 0 "" 20260901 20261008 "" Hercules "Graphics Card"
< .
> LOAN OVERDUE ASOF=20270101 PAGE=2
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 2 1 L 2 Bob 0 555-1234 20261001 20261005 "" Intel 8088
< R 1 3 2 L 1 Carol 0 "" 20260901 20261008 "" Hercules "Graphics Card"
< C LOANS2:2020203032303236313030382020202020202033:3
< .
> LOAN OVERDUE ASOF=20270101 PAGE=2 AFTER=LOANS2:2020203032303236313030382020202020202033:3
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 1 1 L 1 "Jane Smith" 0 "" 20261008 20261022 "" Intel 8088
< .
> LOAN OVERDUE ASOF=20261332
< -ERR 102 bad or missing argument FIELD=ASOF
> LOAN OVERDUE ASOF=2026100
< -ERR 102 bad or missing argument FIELD=ASOF
> LOAN OVERDUE OPEN=1
< -ERR 102 unexpected key FIELD=OPEN
> LOAN OVERDUE X
< -ERR 100 too many arguments

# LOAN SET: HOLDER, CONTACT, DUE (or DUE_DATE) and NOTES.
> LOAN SET 1 HOLDER="Jane Doe" CONTACT=Office DUE=20261029 NOTES="Back by Friday"
< +OK
> LOAN GET 1
< +DATA
< K LOAN_ID=1
< K ITEM_ID=1
< K KIND=L
< K QTY=1
< K HOLDER="Jane Doe"
< K HOST_ID=0
< K CONTACT=Office
< K OUT_DATE=20261008
< K DUE_DATE=20261029
< K RET_DATE=""
< K NOTES="Back by Friday"
< .
> LOAN SET 1 DUE_DATE=20261022 CONTACT=
< +OK
> LOAN SET 1
< +OK
> LOAN SET 1 HOLDER=
< -ERR 102 value required FIELD=HOLDER
> LOAN SET 1 DUE=
< -ERR 102 value required FIELD=DUE_DATE
> LOAN SET 1 DUE=20261001
< -ERR 102 due date before out date FIELD=DUE_DATE
> LOAN SET 1 DUE=20261022 DUE_DATE=20261022
< -ERR 102 bad or missing argument FIELD=DUE_DATE
> LOAN SET 1 QTY=2
< -ERR 102 field not settable FIELD=QTY
> LOAN SET 1 OUT_DATE=20261001
< -ERR 102 field not settable FIELD=OUT_DATE
> LOAN SET 1 DATE=20261001
< -ERR 102 field not settable FIELD=DATE
> LOAN SET 1 RET_DATE=20261010
< -ERR 102 field not settable FIELD=RET_DATE
> LOAN SET 1 ITEM_ID=2
< -ERR 102 field not settable FIELD=ITEM_ID
> LOAN SET 1 LOAN_ID=9
< -ERR 102 field not settable FIELD=LOAN_ID
> LOAN SET 1 FOO=1
< -ERR 102 unexpected key FIELD=FOO
> LOAN SET 99 NOTES=x
< -ERR 200 not found FIELD=ID
> LOAN SET x NOTES=x
< -ERR 102 bad ID FIELD=ID
> LOAN SET
< -ERR 102 missing argument FIELD=ID
> LOAN SET 1 2 NOTES=x
< -ERR 100 too many arguments
> LOAN GET 1
< +DATA
< K LOAN_ID=1
< K ITEM_ID=1
< K KIND=L
< K QTY=1
< K HOLDER="Jane Doe"
< K HOST_ID=0
< K CONTACT=""
< K OUT_DATE=20261008
< K DUE_DATE=20261022
< K RET_DATE=""
< K NOTES="Back by Friday"
< .

# LOAN RETURN: DATE (or RET_DATE) defaults to today and is not before
# OUT_DATE; ON_LOAN falls by the loan's QTY.
> LOAN RETURN 3 DATE=20260831
< -ERR 102 end date before out date FIELD=RET_DATE
> LOAN RETURN 3 RET_DATE=20261007 DATE=20261007
< -ERR 102 bad or missing argument FIELD=RET_DATE
> LOAN RETURN 3 DATE=20261332
< -ERR 102 bad value FIELD=RET_DATE
> LOAN RETURN 3 DUE=20261007
< -ERR 102 unexpected key FIELD=DUE
> LOAN RETURN 99
< -ERR 200 not found FIELD=ID
> LOAN RETURN 0
< -ERR 102 bad ID FIELD=ID
> LOAN RETURN
< -ERR 102 missing argument FIELD=ID
> LOAN RETURN 3 4
< -ERR 100 too many arguments
> LOAN RETURN 3 DATE=20261007
< +OK
> LOAN RETURN 3
< -ERR 202 already returned or released FIELD=ID
> LOAN RETURN 2 RET_DATE=
< +OK
> LOAN GET 2
< +DATA
< K LOAN_ID=2
< K ITEM_ID=1
< K KIND=L
< K QTY=2
< K HOLDER=Bob
< K HOST_ID=0
< K CONTACT=555-1234
< K OUT_DATE=20261001
< K DUE_DATE=20261005
< K RET_DATE=20261008
< K NOTES="Two of them"
< .
> ITEM LIST FIELDS=ITEM_ID,QTY,ON_LOAN
< +DATA
< F ITEM_ID QTY ON_LOAN
< R 1 3 1
< R 2 1 0
< R 3 1 0
< .

# A loan of an item deleted since lists empty MFR and MODEL.
> LOAN OUT 2 HOLDER=Dave DUE=20261231 DATE=
< +OK ID=4
> LOAN RETURN 4
< +OK
> ITEM DEL 2
< +OK
> LOAN LIST ITEM=2
< -ERR 200 no such item FIELD=ITEM

# Returned loans follow the open ones, by year of return and due date.
> LOAN LIST
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 1 1 L 1 "Jane Doe" 0 "" 20261008 20261022 "" Intel 8088
< R 0 2 1 L 2 Bob 0 555-1234 20261001 20261005 20261008 Intel 8088
< R 0 3 2 L 1 Carol 0 "" 20260901 20261008 20261007 "" ""
< R 0 4 2 L 1 Dave 0 "" 20261008 20261231 20261008 "" ""
< .
> LOAN LIST OPEN=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 1 1 L 1 "Jane Doe" 0 "" 20261008 20261022 "" Intel 8088
< .
> LOAN LIST OPEN=0 PAGE=3
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 1 1 L 1 "Jane Doe" 0 "" 20261008 20261022 "" Intel 8088
< R 0 2 1 L 2 Bob 0 555-1234 20261001 20261005 20261008 Intel 8088
< R 0 3 2 L 1 Carol 0 "" 20260901 20261008 20261007 "" ""
< C LOANS2:3230323632303236313030382020202020202033:3
< .
> LOAN LIST AFTER=LOANS2:3230323632303236313030382020202020202033:3
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 4 2 L 1 Dave 0 "" 20261008 20261231 20261008 "" ""
< .
> LOAN LIST ITEM=1 OPEN=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 1 1 L 1 "Jane Doe" 0 "" 20261008 20261022 "" Intel 8088
< .

# HOLDER= keeps the rows of one holder: the whole name, compared
# without regard to case, with every other filter; an empty one keeps
# every row.
> LOAN LIST HOLDER="jane DOE"
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 1 1 L 1 "Jane Doe" 0 "" 20261008 20261022 "" Intel 8088
< .
> LOAN LIST HOLDER=bob
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 2 1 L 2 Bob 0 555-1234 20261001 20261005 20261008 Intel 8088
< .
> LOAN LIST HOLDER=bob OPEN=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .
> LOAN LIST HOLDER=Jane
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .
> LOAN LIST ITEM=1 HOLDER=BOB
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 2 1 L 2 Bob 0 555-1234 20261001 20261005 20261008 Intel 8088
< .
> LOAN LIST ITEM=1 HOLDER=Carol
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .
> LOAN LIST HOLDER=Bob PAGE=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 2 1 L 2 Bob 0 555-1234 20261001 20261005 20261008 Intel 8088
< C LOANS2:3230323632303236313030352020202020202032:2
< .
> LOAN LIST HOLDER=Bob PAGE=1 AFTER=LOANS2:3230323632303236313030352020202020202032:2
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .
> LOAN LIST HOLDER= PAGE=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 1 1 L 1 "Jane Doe" 0 "" 20261008 20261022 "" Intel 8088
< C LOANS2:2020203032303236313032322020202020202031:1
< .
> LOAN LIST HOLDER=123456789012345678901234567890
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .
> LOAN LIST HOLDER=1234567890123456789012345678901
< -ERR 102 filter value too long FIELD=HOLDER
> LOAN OVERDUE ASOF=20270101
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 1 1 L 1 "Jane Doe" 0 "" 20261008 20261022 "" Intel 8088
< .

# Assemblies: an item with a quantity on loan is not installed, and an
# installed item is not lent.
> ITEM ADD CATEGORY=SYS MFR=IBM MODEL=5150
< +OK ID=5
> ASSY INSTALL 1 5
< -ERR 202 item is on loan FIELD=CHILD
> ITEM ADD CATEGORY=CARD MFR=Paradise MODEL=Mono
< +OK ID=6
> ASSY INSTALL 6 5
< +OK
> LOAN OUT 6 HOLDER=Al DUE=20261231
< -ERR 202 installed in an assembly FIELD=ITEM

# LATE follows the clock: a week after its due date loan 1 is late.
@NOW 20261029 090000
> LOAN LIST OPEN=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 1 1 L 1 "Jane Doe" 0 "" 20261008 20261022 "" Intel 8088
< .
> LOAN OVERDUE
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 1 1 L 1 "Jane Doe" 0 "" 20261008 20261022 "" Intel 8088
< .
> LOAN RETURN 1
< +OK
> LOAN OVERDUE
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .

# The loans survive a reopen.
@REOPEN
> LOAN GET 1
< +DATA
< K LOAN_ID=1
< K ITEM_ID=1
< K KIND=L
< K QTY=1
< K HOLDER="Jane Doe"
< K HOST_ID=0
< K CONTACT=""
< K OUT_DATE=20261008
< K DUE_DATE=20261022
< K RET_DATE=20261029
< K NOTES="Back by Friday"
< .

@TABLE LOANS
< F LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE NOTES
< R 1 1 L 1 "Jane Doe" 0 "" 20261008 20261022 20261029 "Back by Friday"
< R 2 1 L 2 Bob 0 555-1234 20261001 20261005 20261008 "Two of them"
< R 3 2 L 1 Carol 0 "" 20260901 20261008 20261007 ""
< R 4 2 L 1 Dave 0 "" 20261008 20261231 20261008 ""

# One I row per loan, a U row for RET_DATE per return and per field
# that LOAN SET changed, and an O or R row on the item for each change
# of ON_LOAN.
@TABLE AUDIT FIELDS=USERNAME,TBL,REC_ID,ACTION,FLD
< F USERNAME TBL REC_ID ACTION FLD
< R SYSTEM CATS 1 I CAT_CODE
< R SYSTEM CATS 2 I CAT_CODE
< R SYSTEM CATS 3 I CAT_CODE
< R SYSTEM CATS 4 I CAT_CODE
< R SYSTEM CATS 5 I CAT_CODE
< R SYSTEM CATS 6 I CAT_CODE
< R SYSTEM CATS 7 I CAT_CODE
< R SYSTEM CATS 8 I CAT_CODE
< R SYSTEM CATS 9 I CAT_CODE
< R SYSTEM CATS 10 I CAT_CODE
< R SYSTEM LTYPES 1 I LT_CODE
< R SYSTEM LTYPES 2 I LT_CODE
< R SYSTEM LTYPES 3 I LT_CODE
< R SYSTEM LTYPES 4 I LT_CODE
< R SYSTEM LTYPES 5 I LT_CODE
< R SYSTEM LTYPES 6 I LT_CODE
< R SYSTEM LTYPES 7 I LT_CODE
< R SYSTEM LTYPES 8 I LT_CODE
< R SYSTEM USERS 1 I USER_ID
< R ADMIN USERS 1 L ""
< R ADMIN USERS 1 W PWHASH
< R ADMIN ITEMS 1 I ITEM_ID
< R ADMIN ITEMS 2 I ITEM_ID
< R ADMIN ITEMS 3 I ITEM_ID
< R ADMIN LOANS 1 I LOAN_ID
< R ADMIN ITEMS 1 O ON_LOAN
< R ADMIN LOANS 2 I LOAN_ID
< R ADMIN ITEMS 1 O ON_LOAN
< R ADMIN LOANS 3 I LOAN_ID
< R ADMIN ITEMS 2 O ON_LOAN
< R ADMIN ITEMS 4 I ITEM_ID
< R ADMIN ITEMS 4 D ""
< R ADMIN LOANS 1 U HOLDER
< R ADMIN LOANS 1 U CONTACT
< R ADMIN LOANS 1 U DUE_DATE
< R ADMIN LOANS 1 U NOTES
< R ADMIN LOANS 1 U CONTACT
< R ADMIN LOANS 1 U DUE_DATE
< R ADMIN LOANS 3 U RET_DATE
< R ADMIN ITEMS 2 R ON_LOAN
< R ADMIN LOANS 2 U RET_DATE
< R ADMIN ITEMS 1 R ON_LOAN
< R ADMIN LOANS 4 I LOAN_ID
< R ADMIN ITEMS 2 O ON_LOAN
< R ADMIN LOANS 4 U RET_DATE
< R ADMIN ITEMS 2 R ON_LOAN
< R ADMIN ITEMS 2 D ""
< R ADMIN ITEMS 5 I ITEM_ID
< R ADMIN ITEMS 6 I ITEM_ID
< R ADMIN ITEMS 6 P PARENT_ID
< R ADMIN LOANS 1 U RET_DATE
< R ADMIN ITEMS 1 R ON_LOAN

# Reservations and in-use equipment: a monitor (item 8, two units) in
# use with a system (item 7) and reserved for a show.
@NOW 20261008 120000
> ITEM ADD CATEGORY=SYS MFR=IBM MODEL=5160
< +OK ID=7
> ITEM ADD CATEGORY=PERI MFR=IBM MODEL=5151 QTY=2
< +OK ID=8
> LOAN RESERVE 8
< -ERR 102 name who or which item it is for FIELD=HOLDER
> LOAN USE 8 HOLDER=
< -ERR 102 name who or which item it is for FIELD=HOLDER
> LOAN USE 8 HOST=7
< +OK ID=5
> LOAN RESERVE 8 HOLDER="Club show" DUE=20261020
< +OK ID=6
> LOAN USE 8 HOLDER=Desk
< -ERR 202 not enough on hand FIELD=QTY
> LOAN OUT 8 HOLDER=Al DUE=20261020
< -ERR 202 not enough on hand FIELD=QTY
> ITEM LIST FIELDS=ITEM_ID,QTY,ON_LOAN,RESERVED,IN_USE,ATTACHED
< -ERR 102 field list too long FIELD=FIELDS
> LOAN GET 5
< +DATA
< K LOAN_ID=5
< K ITEM_ID=8
< K KIND=U
< K QTY=1
< K HOLDER=""
< K HOST_ID=7
< K CONTACT=""
< K OUT_DATE=20261008
< K DUE_DATE=""
< K RET_DATE=""
< K NOTES=""
< .

# The refusals of a new row: a key of another kind, the host's rules.
> LOAN USE 7 HOLDER=Desk DUE=20261020
< -ERR 102 field not settable FIELD=DUE
> LOAN OUT 7 HOLDER=Al DUE=20261020 HOST=8
< -ERR 102 field not settable FIELD=HOST
> LOAN RESERVE 7 KIND=L HOLDER=Al
< -ERR 102 unexpected key FIELD=KIND
> LOAN RESERVE 8 HOST=8
< -ERR 202 cannot be used with itself or its own parts FIELD=HOST_ID
> LOAN RESERVE 7 HOST=999
< -ERR 200 no such item FIELD=HOST_ID
> LOAN RESERVE 7 HOST=3
< -ERR 202 item was disposed of FIELD=HOST_ID
> LOAN RESERVE 5 HOST=6
< -ERR 202 cannot be used with itself or its own parts FIELD=HOST_ID
> LOAN RESERVE 6 HOLDER=Al
< -ERR 202 installed in an assembly FIELD=ITEM
> LOAN RESERVE 7 HOST=x
< -ERR 102 not a number FIELD=HOST_ID
> LOAN RESERVE 7 HOLDER=Al DATE=20261010 DUE=20261009
< -ERR 102 due date before out date FIELD=DUE_DATE

# The rules of the items while units are held, each with its reason.
> ITEM SET 8 STATUS=D
< -ERR 202 item is reserved FIELD=STATUS
> ITEM DEL 8
< -ERR 202 item is reserved FIELD=RESERVED
> ITEM SET 8 QTY=1
< -ERR 202 quantity below units lent, reserved or in use FIELD=QTY
> ITEM SPLIT 8 QTY=1
< -ERR 202 not enough on hand FIELD=QTY
> ASSY INSTALL 8 7
< -ERR 202 item is reserved FIELD=CHILD
> ASSY INSTALL 7 8
< -ERR 202 cannot be used with itself or its own parts FIELD=PARENT
> ITEM SET 7 STATUS=D
< -ERR 202 equipment is reserved for or in use with it FIELD=STATUS
> ITEM DEL 7
< -ERR 202 equipment is reserved for or in use with it FIELD=ATTACHED

# Lists by host, by kind and by holder, paged; LOAN SET moves a reservation to
# the host; a lapsed reservation is overdue, an assignment never.
> LOAN LIST HOST=7
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 5 8 U 1 "" 7 "" 20261008 "" "" IBM 5151
< .
> LOAN LIST KIND=r OPEN=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 6 8 R 1 "Club show" 0 "" 20261008 20261020 "" IBM 5151
< .
> LOAN LIST ITEM=8 KIND=U
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 5 8 U 1 "" 7 "" 20261008 "" "" IBM 5151
< .
> LOAN LIST KIND=X
< -ERR 102 bad or missing argument FIELD=KIND
> LOAN LIST HOST=99
< -ERR 200 no such item FIELD=HOST
> LOAN LIST HOST=abc
< -ERR 102 bad ID FIELD=HOST
> LOAN SET 5 DUE=20261030
< -ERR 102 field not settable FIELD=DUE
> LOAN SET 6 KIND=U
< -ERR 102 field not settable FIELD=KIND
> LOAN SET 6 HOST=7
< +OK
> LOAN SET 5 HOLDER= HOST=0
< -ERR 102 name who or which item it is for FIELD=HOLDER
> LOAN LIST HOST=7 PAGE=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 5 8 U 1 "" 7 "" 20261008 "" "" IBM 5151
< C LOANS2:2020203020202030303030302020202020202035:5
< .
> LOAN LIST HOST=7 PAGE=1 AFTER=LOANS2:2020203020202020202020202020202020202035:5
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 5 8 U 1 "" 7 "" 20261008 "" "" IBM 5151
< C LOANS2:2020203020202030303030302020202020202035:5
< .
> LOAN LIST HOST=7 KIND=U
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 5 8 U 1 "" 7 "" 20261008 "" "" IBM 5151
< .
> LOAN LIST HOST=7 HOLDER="CLUB show"
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 6 8 R 1 "Club show" 7 "" 20261008 20261020 "" IBM 5151
< .
> LOAN LIST KIND=U HOLDER="Club show"
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .
> LOAN OVERDUE ASOF=20261021
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 6 8 R 1 "Club show" 7 "" 20261008 20261020 "" IBM 5151
< .
> REPORT LOANS
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< R 0 5 8 U 1 "" 7 "" 20261008 "" IBM 5151
< R 0 6 8 R 1 "Club show" 7 "" 20261008 20261020 IBM 5151
< .
> ITEM LIST FIELDS=ITEM_ID,ON_LOAN,RESERVED,IN_USE,ATTACHED
< +DATA
< F ITEM_ID ON_LOAN RESERVED IN_USE ATTACHED
< R 1 0 0 0 0
< R 3 0 0 0 0
< R 5 0 0 0 0
< R 6 0 0 0 0
< R 7 0 0 0 2
< R 8 0 1 1 0
< .
> LOAN RETURN 6
< +OK
> LOAN RETURN 5 DATE=20261008
< +OK
> LOAN RETURN 5
< -ERR 202 already returned or released FIELD=ID
> ITEM LIST FIELDS=ITEM_ID,ON_LOAN,RESERVED,IN_USE,ATTACHED
< +DATA
< F ITEM_ID ON_LOAN RESERVED IN_USE ATTACHED
< R 1 0 0 0 0
< R 3 0 0 0 0
< R 5 0 0 0 0
