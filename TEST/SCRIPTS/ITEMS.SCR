# Storage failures: a full disk (302), no free file handle (303) and a
# sharing violation (304) at the first file change of ITEM ADD, and at
# the edit marker or a later write of ITEM SET and LOC DEL.  The session
# goes on, and the files reopened after it are unchanged, with no item
# or audit number taken.
> LOC ADD LOC_NAME=C3 LTYPE=BIN LOC_CODE=C3
< +OK ID=3
@FAULT 1
> ITEM ADD CATEGORY=SYS
< -ERR 302 disk full
@FAULT 1 CF_EMFILE
> ITEM ADD CATEGORY=SYS
< -ERR 303 too few file handles: need FILES=45 or more
@FAULT 1 CF_ESHARE
> ITEM ADD CATEGORY=SYS
< -ERR 304 data files in use
@FAULT 1
> ITEM SET 2 MFR=X
< -ERR 302 EDITING.$$$
@FAULT 1 CF_EMFILE
> ITEM SET 2 MFR=X
< -ERR 303 EDITING.$$$
@FAULT 12 CF_ESHARE
> ITEM SET 2 MFR=X
< -ERR 304 data files in use
@FAULT 1
> LOC DEL C3
< -ERR 302 EDITING.$$$
@FAULT 1 CF_EMFILE
> LOC DEL C3
< -ERR 303 EDITING.$$$
# The code may also be given by number: 32 is CF_ESHARE.
@FAULT 2 32
> LOC DEL C3
< -ERR 304 data files in use
> LOC GET C3
< +DATA
< K LOC_ID=3
< K PARENT_ID=0
< K LOC_NAME=C3
< K LOC_CODE=C3
< K LTYPE=BIN
< K CAPACITY=""
< K DEPTH=1
< K PATH=C3
< .
@REOPEN
@TABLE ITEMS FIELDS=ITEM_ID,MFR
< F ITEM_ID MFR
< R 1 ""
< R 2 IBM
< D 3 Seagate
< R 4 IBM
< R 5 ""
@TABLE LOCS FIELDS=LOC_CODE
< F LOC_CODE
< R A1
< D B2
< R C3
@TABLE SEQ
< F SEQ_NAME NEXT_VAL
< R ITEMS 6
< R LOCS 4
< R MAINT 1
< R LOANS 1
< R AUDIT 75
< R USERS 2

# Level 1: reads are allowed.
> USER ADD READER LEVEL=1 PASSWORD=read1
< +OK
@SESSION
> HELLO RDPC
< +OK
> LOGIN READER read1
< +OK LEVEL=1 MUSTCHG=1
> PASSWD read1 read2
< +OK
> ITEM GET 2
< +DATA
< K ITEM_ID=2
< K CATEGORY=CARD
< K ITEMTYPE="ISA VGA"
< K MFR=IBM
< K MODEL="5150 CGA"
< K SERIALNO=SN-0001
< K DESCR="Colour graphics adapter"
< K COND=GD
< K WORKS=?
< K QTY=2
< K ON_LOAN=0
< K RESERVED=0
< K IN_USE=0
< K ATTACHED=0
< K LOC_ID=1
< K PARENT_ID=0
< K ACQ_DATE=19860214
< K ACQ_SRC="Swap meet"
< K ACQ_PRICE=12.50
< K CUR_VALUE=40.00
< K TAGS=video,isa
< K STATUS=A
< K CREATED=20261008
< K UPDATED=20261008
< .
> ITEM LIST FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< R 2
< R 4
< R 5
< .
> ITEM NOTES 3
< -ERR 200 no such item

# The cosmetic grade and the works state, at level 3 again: COND is blank
# or one of NEW EXC GD FR PR, WORKS one of Y I N ?, any case, stored
# upper case.
@SESSION
> HELLO CONSOLE
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=3 NAME="System Administrator"
> ITEM SET 2 COND= WORKS=y
< +OK
> ITEM SET 4 COND=fr WORKS=i
< +OK
> ITEM SET 5 WORKS=N
< +OK
> ITEM LIST FIELDS=ITEM_ID,COND,WORKS
< +DATA
< F ITEM_ID COND WORKS
< R 1 EXC ?
< R 2 "" Y
< R 4 FR I
< R 5 "" N
< .
> ITEM SET 2 WORKS=X
< -ERR 102 works must be Y, N, I or ? FIELD=WORKS
> ITEM SET 2 WORKS=
< -ERR 102 works must be Y, N, I or ? FIELD=WORKS
> ITEM SET 2 WORKS=YN
< -ERR 102 value too long FIELD=WORKS
> ITEM ADD CATEGORY=SYS WORKS=x
< -ERR 102 works must be Y, N, I or ? FIELD=WORKS
> ITEM SET 2 COND=NW
< -ERR 102 bad condition code FIELD=COND
> ITEM SET 2 COND=UT
< -ERR 102 bad condition code FIELD=COND
> ITEM SET 2 COND=PT
< -ERR 102 bad condition code FIELD=COND

# TAGS: commas or spaces in any run separate the tags; they are stored
# joined by single commas, a repeat (A-Z folded) left out and the first
# spelling kept.  A tag is 1 to 12 of A-Z a-z 0-9 - _ . / +.
> ITEM SET 2 TAGS="Retro, ISA  retro,,pci"
< +OK
> ITEM SET 4 TAGS=" a-b_c.d/e+f ,abcdefghijkl, "
< +OK
> ITEM SET 5 TAGS=", ,"
< +OK
> ITEM LIST FIELDS=ITEM_ID,TAGS
< +DATA
< F ITEM_ID TAGS
< R 1 ""
< R 2 Retro,ISA,pci
< R 4 a-b_c.d/e+f,abcdefghijkl
< R 5 ""
< .
> ITEM SET 2 TAGS=a*b
< -ERR 102 each tag 1-12 of A-Z a-z 0-9 - _ . / + FIELD=TAGS
> ITEM SET 2 TAGS="ok abcdefghijklm"
< -ERR 102 each tag 1-12 of A-Z a-z 0-9 - _ . / + FIELD=TAGS
@SEND ITEM ADD CATEGORY=SYS TAGS=caf\x82
< -ERR 102 each tag 1-12 of A-Z a-z 0-9 - _ . / + FIELD=TAGS
> ITEM LIST FIELDS=ITEM_ID,TAGS
< +DATA
< F ITEM_ID TAGS
< R 1 ""
< R 2 Retro,ISA,pci
< R 4 a-b_c.d/e+f,abcdefghijkl
< R 5 ""
< .

# ITEM COPY makes another unit, neither graded nor tested: COND blank,
# WORKS ?, the tags kept.  ITEM SPLIT keeps all three, as the lot was
# graded and tested as a whole.
> ITEM SET 2 COND=GD
< +OK
> ITEM COPY 2
< +OK ID=6
> ITEM SPLIT 2 QTY=1
< +OK ID=7
> ITEM LIST FIELDS=ITEM_ID,COND,WORKS,TAGS,QTY
< +DATA
< F ITEM_ID COND WORKS TAGS QTY
< R 1 EXC ? "" 3
< R 2 GD Y Retro,ISA,pci 1
< R 4 FR I a-b_c.d/e+f,abcdefghijkl 2
< R 5 "" N "" 1
< R 6 "" ? Retro,ISA,pci 2
< R 7 GD Y Retro,ISA,pci 1
< .
