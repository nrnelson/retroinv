# ITEM commands: every success and error response, FIELD= reporting,
# FIELDS= selection, memo notes with escaping, storage failures, and
# reads at level 1.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK
> LOC ADD LOC_NAME="Shelf A1" LTYPE=BIN LOC_CODE=A1
< +OK ID=1
> LOC ADD LOC_NAME="Shelf B2" LTYPE=BIN LOC_CODE=B2
< +OK ID=2

# ITEM ADD with defaults, then with every settable field.
> ITEM ADD CATEGORY=SYS
< +OK ID=1
> ITEM GET 1
< +DATA
< K ITEM_ID=1
< K CATEGORY=SYS
< K ITEMTYPE=""
< K MFR=""
< K MODEL=""
< K SERIALNO=""
< K DESCR=""
< K COND=""
< K WORKS=?
< K QTY=1
< K ON_LOAN=0
< K RESERVED=0
< K IN_USE=0
< K ATTACHED=0
< K LOC_ID=0
< K PARENT_ID=0
< K ACQ_DATE=""
< K ACQ_SRC=""
< K ACQ_PRICE=""
< K CUR_VALUE=""
< K TAGS=""
< K STATUS=A
< K CREATED=20261008
< K UPDATED=20261008
< .
