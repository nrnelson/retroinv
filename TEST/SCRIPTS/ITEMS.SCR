# LOC_NAME, a computed column: the name of the item's location, blank
# for an unknown one, after LOC_ID in the default rows.  FIELDS= takes
# it anywhere, in any case, once, and counts its name in the length of
# the list.
> ITEM LIST FIELDS=ITEM_ID,LOC_ID,LOC_NAME
< +DATA
< F ITEM_ID LOC_ID LOC_NAME
< R 1 0 ""
< R 2 1 "Shelf A1"
< R 4 1 "Shelf A1"
< .
# A LOC_ID that names no live location, as another program might write
# it, gives a blank name.
@PUT ITEMS 1 LOC_ID 99
> ITEM LIST FIELDS=ITEM_ID,LOC_ID,LOC_NAME
< +DATA
< F ITEM_ID LOC_ID LOC_NAME
< R 1 99 ""
< R 2 1 "Shelf A1"
< R 4 1 "Shelf A1"
< .
@PUT ITEMS 1 LOC_ID 0
> ITEM LIST FIELDS=loc_name,ITEM_ID PAGE=2
< +DATA
< F LOC_NAME ITEM_ID
< R "" 1
< R "Shelf A1" 2
< C ITEMS1:2020202020202032:2
< .
> ITEM LIST FIELDS=LOC_NAME LOC=0
