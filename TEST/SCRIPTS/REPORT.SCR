# REPORT ITEMS and REPORT LOANS: the fixed columns, the filters and
# orders shared with ITEM LIST, the default order, argument errors
# naming their key, paging with cursors and the per-request read limit,
# deleted items; open and overdue loans, ASOF as the reference of LATE
# in both forms, MFR and MODEL of the loan's item, and the cursors of
# the LOANS2 index.  The clock is 2026-10-08.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK

# No items and no loans yet: the F lines alone.
> REPORT ITEMS
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< .
> REPORT LOANS
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< .
> REPORT LOANS OVERDUE=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< .

> LOC ADD LOC_NAME="Shelf A1" LTYPE=SHELF LOC_CODE=A1
< +OK ID=1
> LOC ADD LOC_NAME="Box B2" LTYPE=BOX LOC_CODE=B2
< +OK ID=2
> LOC ADD LOC_NAME="Bin C3" LTYPE=BIN LOC_CODE=C3
< +OK ID=3
> ITEM ADD CATEGORY=SYS MFR=IBM MODEL=5150 SERIALNO=0012345 COND=GD LOC_ID=B2 ACQ_DATE=19840312 ACQ_PRICE=450 CUR_VALUE=1200.5
< +OK ID=1
> ITEM ADD CATEGORY=CARD MFR=Hercules MODEL="Graphics Card" SERIALNO=HGC-1 COND=EXC QTY=2 LOC_ID=A1
< +OK ID=2
> ITEM ADD CATEGORY=CPU MFR=Intel MODEL=8088 QTY=3 LOC_ID=A1 SERIALNO=X1
< +OK ID=3
> ITEM ADD CATEGORY=DRV MFR=Seagate MODEL=ST-225 STATUS=D LOC_ID=C3 SERIALNO=X1
< +OK ID=4
> ITEM ADD CATEGORY=SYS MFR=Compaq MODEL="Portable \"Plus\"" DESCR="not a column" ACQ_PRICE=0.99
< +OK ID=5
> ITEM ADD CATEGORY=CPU MFR=AMD MODEL=8086 LOC_ID=B2
< +OK ID=6
> ITEM DEL 6
< +OK

# Without ORDER= the order is ID, or LOC when LOC= is given; the
# deleted item 6 is skipped in every order.  DESCR is no column.
> REPORT ITEMS
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< R 4 DRV Seagate ST-225 X1 "" ? 1 3 "Bin C3" D "" "" ""
< R 5 SYS Compaq "Portable \"Plus\"" "" "" ? 1 0 "" A "" 0.99 ""
< .
> REPORT ITEMS LOC=A1
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< .
> REPORT ITEMS LOC=
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< R 4 DRV Seagate ST-225 X1 "" ? 1 3 "Bin C3" D "" "" ""
< R 5 SYS Compaq "Portable \"Plus\"" "" "" ? 1 0 "" A "" 0.99 ""
< .
# Every order, in any case.
> REPORT ITEMS ORDER=ID
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
