< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< R 4 DRV Seagate ST-225 X1 "" ? 1 3 "Bin C3" D "" "" ""
< .
> REPORT ITEMS ORDER=SERIAL
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 5 SYS Compaq "Portable \"Plus\"" "" "" ? 1 0 "" A "" 0.99 ""
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< R 4 DRV Seagate ST-225 X1 "" ? 1 3 "Bin C3" D "" "" ""
< .
> REPORT ITEMS LOC=B2 ORDER=MFR
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< .

# Filters, alone and together; empty values filter nothing, values
# that name nothing match nothing.
> REPORT ITEMS CAT=SYS
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< R 5 SYS Compaq "Portable \"Plus\"" "" "" ? 1 0 "" A "" 0.99 ""
< .
> REPORT ITEMS cat=cpu
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< .
> REPORT ITEMS STATUS=D
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 4 DRV Seagate ST-225 X1 "" ? 1 3 "Bin C3" D "" "" ""
< .
> REPORT ITEMS STATUS=A CAT=SYS ORDER=MFR
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 5 SYS Compaq "Portable \"Plus\"" "" "" ? 1 0 "" A "" 0.99 ""
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< .
> REPORT ITEMS CAT=SYS LOC=B2
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< .
> REPORT ITEMS CAT= LOC= STATUS=
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< R 4 DRV Seagate ST-225 X1 "" ? 1 3 "Bin C3" D "" "" ""
< R 5 SYS Compaq "Portable \"Plus\"" "" "" ? 1 0 "" A "" 0.99 ""
< .
> REPORT ITEMS CAT=NONE
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< .
> REPORT ITEMS LOC=Z9
< -ERR 200 no such location FIELD=LOC

# Argument errors name their key; FIELDS= is not a key of the report.
> REPORT ITEMS ORDER=NAME
< -ERR 102 bad or missing argument FIELD=ORDER
> REPORT ITEMS ORDER=
< -ERR 102 bad or missing argument FIELD=ORDER
> REPORT ITEMS CAT=TOOLONG
< -ERR 102 filter value too long FIELD=CAT
> REPORT ITEMS LOC=TOOLONG
< -ERR 200 no such location FIELD=LOC
> REPORT ITEMS STATUS=AB
< -ERR 102 filter value too long FIELD=STATUS
> REPORT ITEMS FIELDS=ITEM_ID
< -ERR 102 unexpected key FIELD=FIELDS
> REPORT ITEMS MFR=IBM
< -ERR 102 unexpected key FIELD=MFR
> REPORT ITEMS PAGE=0
< -ERR 102 bad page size FIELD=PAGE
> REPORT ITEMS PAGE=26
< -ERR 102 bad page size FIELD=PAGE
> REPORT ITEMS 1
< -ERR 100 too many arguments
> REPORT ITEMS AFTER=ITEMS9:20:1
< -ERR 204 bad cursor
> REPORT ITEMS AFTER=garbage
< -ERR 204 bad cursor

# Paging: C cursors followed to the end, in ID and LOC order.
> REPORT ITEMS PAGE=2
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< C ITEMS1:2020202020202032:2
< .
> REPORT ITEMS PAGE=2 AFTER=ITEMS1:2020202020202032:2
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< R 4 DRV Seagate ST-225 X1 "" ? 1 3 "Bin C3" D "" "" ""
< C ITEMS1:2020202020202034:4
< .
> REPORT ITEMS PAGE=2 AFTER=ITEMS1:2020202020202034:4
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 5 SYS Compaq "Portable \"Plus\"" "" "" ? 1 0 "" A "" 0.99 ""
< .
> REPORT ITEMS ORDER=LOC PAGE=3
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 5 SYS Compaq "Portable \"Plus\"" "" "" ? 1 0 "" A "" 0.99 ""
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< C ITEMS2:20202020202020312020202020202033:3
< .
> REPORT ITEMS ORDER=LOC PAGE=3 AFTER=ITEMS2:20202020202020312020202020202033:3
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< R 4 DRV Seagate ST-225 X1 "" ? 1 3 "Bin C3" D "" "" ""
< .
# The cursors are those of ITEM LIST in the same order, both ways.
> ITEM LIST ORDER=LOC PAGE=1 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 5
< C ITEMS2:20202020202020302020202020202035:5
< .
> REPORT ITEMS ORDER=LOC PAGE=2 AFTER=ITEMS2:20202020202020302020202020202035:5
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< C ITEMS2:20202020202020312020202020202033:3
< .
> ITEM LIST ORDER=LOC FIELDS=ITEM_ID AFTER=ITEMS2:20202020202020312020202020202033:3
< +DATA
< F ITEM_ID
< R 1
< R 4
< .

# ALL=1: the items at LOC= and at every location below it, in tree order
# (depth first, the locations of one parent by name), each location's by
# ITEM_ID; LOC=0 starts with the items of unknown location.  The filters
# apply inside the walk, and pages go on across locations; ORDER= is
# refused beside ALL=1, and LOC= is needed.
> LOC SET B2 PARENT_ID=A1
< +OK
> REPORT ITEMS LOC=A1 ALL=1
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< .
> REPORT ITEMS LOC=0 ALL=1
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 5 SYS Compaq "Portable \"Plus\"" "" "" ? 1 0 "" A "" 0.99 ""
< R 4 DRV Seagate ST-225 X1 "" ? 1 3 "Bin C3" D "" "" ""
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< .
> REPORT ITEMS LOC=0 ALL=1 PAGE=2
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 5 SYS Compaq "Portable \"Plus\"" "" "" ? 1 0 "" A "" 0.99 ""
< R 4 DRV Seagate ST-225 X1 "" ? 1 3 "Bin C3" D "" "" ""
< C ITEMS2:20202020202020332020202020202034:4
< .
> REPORT ITEMS LOC=0 ALL=1 PAGE=2 AFTER=ITEMS2:20202020202020332020202020202034:4
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< C ITEMS2:20202020202020312020202020202033:3
< .
> REPORT ITEMS LOC=0 ALL=1 PAGE=2 AFTER=ITEMS2:20202020202020312020202020202033:3
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< .
> REPORT ITEMS LOC=A1 ALL=1 CAT=CPU
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< .
> REPORT ITEMS LOC=0 ALL=1 STATUS=D
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 4 DRV Seagate ST-225 X1 "" ? 1 3 "Bin C3" D "" "" ""
< .
> REPORT ITEMS LOC=b2 ALL=1 AVAIL=1
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 SYS IBM 5150 0012345 GD ? 1 2 "Box B2" A 19840312 450.00 1200.50
< .
> REPORT ITEMS LOC=A1 ALL=1 ORDER=ID
< -ERR 102 bad or missing argument FIELD=ORDER
> REPORT ITEMS ALL=1 CAT=CPU
< -ERR 102 missing argument FIELD=LOC
> REPORT ITEMS LOC=Z9 ALL=1
< -ERR 200 no such location FIELD=LOC
> REPORT ITEMS LOC=0 ALL=x
< -ERR 102 bad or missing argument FIELD=ALL

# ENG_MAXREADS entries examined end a page even when none of them is
# returned: 200 more items, none of them a CPU, then one CPU, found by
# the request that continues from the first page's cursor.
@REPEAT 200
> ITEM ADD CATEGORY=SYS
< +OK ID=206
> ITEM ADD CATEGORY=CPU MFR=NEC MODEL=V20
< +OK ID=207
> REPORT ITEMS CAT=CPU
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< C ITEMS1:2020202020323030:C8
< .
> REPORT ITEMS CAT=CPU AFTER=ITEMS1:2020202020323030:C8
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 207 CPU NEC V20 "" "" ? 1 0 "" A "" "" ""
< .
# The same in tree order: the walk passes over the items of unknown
# location that fail CAT=, each counted, so its first page ends empty
# with a cursor, and the next goes on.
> REPORT ITEMS LOC=0 ALL=1 CAT=CPU
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< C ITEMS2:20202020202020302020202020323035:CD
< .
> REPORT ITEMS LOC=0 ALL=1 CAT=CPU AFTER=ITEMS2:20202020202020302020202020323035:CD
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 207 CPU NEC V20 "" "" ? 1 0 "" A "" "" ""
< R 3 CPU Intel 8088 X1 "" ? 3 1 "Shelf A1" A "" "" ""
< .

# REPORT LOANS: the open loans by DUE_DATE; the returned ones are
# left out.  LATE is 1 for an open loan due before ASOF, by default
# today.
> LOAN OUT 3 HOLDER="Jane Smith" CONTACT=555-0101 DATE=20261001 DUE=20261007
< +OK ID=1
> LOAN OUT 2 HOLDER=Bob DUE=20261031
< +OK ID=2
> LOAN OUT 3 QTY=2 HOLDER=Carol CONTACT="c@example" DATE=20260901 DUE=20261008
< +OK ID=3
> LOAN OUT 1 HOLDER=Dave DUE=20261231
< +OK ID=4
> LOAN OUT 2 HOLDER=Eve DATE=20260920 DUE=20261001
< +OK ID=5
> LOAN OUT 5 HOLDER=Fay DATE=20260915 DUE=20261002
< +OK ID=6
> LOAN RETURN 6
< +OK
> REPORT LOANS
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< R 1 5 2 L 1 Eve 0 "" 20260920 20261001 Hercules "Graphics Card"
< R 1 1 3 L 1 "Jane Smith" 0 555-0101 20261001 20261007 Intel 8088
< R 0 3 3 L 2 Carol 0 c@example 20260901 20261008 Intel 8088
< R 0 2 2 L 1 Bob 0 "" 20261008 20261031 Hercules "Graphics Card"
< R 0 4 1 L 1 Dave 0 "" 20261008 20261231 IBM 5150
< .
> REPORT LOANS OVERDUE=0
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< R 1 5 2 L 1 Eve 0 "" 20260920 20261001 Hercules "Graphics Card"
< R 1 1 3 L 1 "Jane Smith" 0 555-0101 20261001 20261007 Intel 8088
< R 0 3 3 L 2 Carol 0 c@example 20260901 20261008 Intel 8088
< R 0 2 2 L 1 Bob 0 "" 20261008 20261031 Hercules "Graphics Card"
< R 0 4 1 L 1 Dave 0 "" 20261008 20261231 IBM 5150
< .
> REPORT LOANS ASOF=
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< R 1 5 2 L 1 Eve 0 "" 20260920 20261001 Hercules "Graphics Card"
< R 1 1 3 L 1 "Jane Smith" 0 555-0101 20261001 20261007 Intel 8088
< R 0 3 3 L 2 Carol 0 c@example 20260901 20261008 Intel 8088
< R 0 2 2 L 1 Bob 0 "" 20261008 20261031 Hercules "Graphics Card"
< R 0 4 1 L 1 Dave 0 "" 20261008 20261231 IBM 5150
< .
# OVERDUE=1: only the loans due before ASOF.
> REPORT LOANS OVERDUE=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< R 1 5 2 L 1 Eve 0 "" 20260920 20261001 Hercules "Graphics Card"
< R 1 1 3 L 1 "Jane Smith" 0 555-0101 20261001 20261007 Intel 8088
< .
# ASOF in the past: fewer late, fewer overdue; in the future: all.
> REPORT LOANS ASOF=20261005
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< R 1 5 2 L 1 Eve 0 "" 20260920 20261001 Hercules "Graphics Card"
