# Argument errors.
> REPORT LOANS OVERDUE=2
< -ERR 102 bad or missing argument FIELD=OVERDUE
> REPORT LOANS OVERDUE=
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< R 1 5 2 L 1 Eve 0 "" 20260920 20261001 Hercules "Graphics Card"
< R 1 1 3 L 1 "Jane Smith" 0 555-0101 20261001 20261007 Intel 8088
< R 0 3 3 L 2 Carol 0 c@example 20260901 20261008 Intel 8088
< R 0 2 2 L 1 Bob 0 "" 20261008 20261031 Hercules "Graphics Card"
< R 0 4 1 L 1 Dave 0 "" 20261008 20261231 IBM 5150
< .
> REPORT LOANS OVERDUE=01
< -ERR 102 bad or missing argument FIELD=OVERDUE
> REPORT LOANS ASOF=20261332
< -ERR 102 bad or missing argument FIELD=ASOF
> REPORT LOANS OVERDUE=1 ASOF=2026101
< -ERR 102 bad or missing argument FIELD=ASOF
> REPORT LOANS ASOF=tomorrow
< -ERR 102 bad or missing argument FIELD=ASOF
# A bad ASOF is reported before a bad cursor, in both forms.
> REPORT LOANS OVERDUE=0 ASOF=bad AFTER=LOANS1:20202020202020332020202020202031:1
< -ERR 102 bad or missing argument FIELD=ASOF
> REPORT LOANS OVERDUE=1 ASOF=bad AFTER=garbage
< -ERR 102 bad or missing argument FIELD=ASOF
> REPORT LOANS OPEN=1
< -ERR 102 unexpected key FIELD=OPEN
> REPORT LOANS ITEM=1
< -ERR 102 unexpected key FIELD=ITEM
> REPORT LOANS PAGE=0
< -ERR 102 bad page size FIELD=PAGE
> REPORT LOANS 1
< -ERR 100 too many arguments

# Paging over LOANS2 cursors, in both forms; a cursor past ASOF ends
# the overdue list.
> REPORT LOANS PAGE=2
