# The cursors are those of LOAN LIST without ITEM= (the same index),
# both ways, while they lie within the open loans; one on a returned
# loan (LOAN LIST takes it), or one of LOANS1, the index of LOAN LIST
# ITEM=, is 204.
> LOAN LIST PAGE=3
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 5 2 L 1 Eve 0 "" 20260920 20261001 "" Hercules "Graphics Card"
< R 1 1 3 L 1 "Jane Smith" 0 555-0101 20261001 20261007 "" Intel 8088
< R 0 3 3 L 2 Carol 0 c@example 20260901 20261008 "" Intel 8088
< C LOANS2:2020203032303236313030382020202020202033:3
< .
> REPORT LOANS PAGE=1 AFTER=LOANS2:2020203032303236313030382020202020202033:3
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< R 0 2 2 L 1 Bob 0 "" 20261008 20261031 Hercules "Graphics Card"
< C LOANS2:2020203032303236313033312020202020202032:2
< .
> LOAN LIST PAGE=3 AFTER=LOANS2:2020203032303236313033312020202020202032:2
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 0 4 1 L 1 Dave 0 "" 20261008 20261231 "" IBM 5150
< R 0 6 5 L 1 Fay 0 "" 20260915 20261002 20261008 Compaq "Portable \"Plus\""
< .
> LOAN LIST ITEM=3 PAGE=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< R 1 1 3 L 1 "Jane Smith" 0 555-0101 20261001 20261007 "" Intel 8088
< C LOANS1:20202020202020332020202020202031:1
< .
> REPORT LOANS AFTER=LOANS1:20202020202020332020202020202031:1
< -ERR 204 bad cursor
> LOAN LIST AFTER=LOANS2:3230323632303236313030323230202020202036:6
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE RET_DATE MFR MODEL
< .
> REPORT LOANS AFTER=LOANS2:3230323632303236313030323230202020202036:6
< -ERR 204 bad cursor

# MFR and MODEL would be sent empty for a loan whose item is no longer
# live, but no open loan can have one: ITEM DEL refuses an item with a
# quantity on loan, so only returned loans, which REPORT LOANS leaves
# out, reach that case (LOANS.SCR shows it for LOAN LIST).
# MFR and MODEL are read from the loan's item with each page, so a
# change of the item shows at once.
> ITEM SET 1 MFR="IBM Corp." MODEL="PC 5150"
< +OK
> REPORT LOANS OVERDUE=0 ASOF=20261231
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< R 1 5 2 L 1 Eve 0 "" 20260920 20261001 Hercules "Graphics Card"
< R 1 1 3 L 1 "Jane Smith" 0 555-0101 20261001 20261007 Intel 8088
< R 1 3 3 L 2 Carol 0 c@example 20260901 20261008 Intel 8088
< R 1 2 2 L 1 Bob 0 "" 20261008 20261031 Hercules "Graphics Card"
< R 0 4 1 L 1 Dave 0 "" 20261008 20261231 "IBM Corp." "PC 5150"
< .

# A row with MFR, MODEL, SERIALNO and LOC_NAME full of escaped quotes
# stays within PROTO_MAXRESP.
> ITEM ADD CATEGORY=SYS MFR="\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" MODEL="\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" SERIALNO="\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\""
< +OK ID=208
> LOC ADD LOC_NAME="\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" LTYPE=BIN
< +OK ID=4
> ITEM SET 208 LOC_ID=4
< +OK
> REPORT ITEMS AFTER=ITEMS1:2020202020323037:CF
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 208 SYS "\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" "\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" "\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" "" ? 1 4 "\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" A "" "" ""
< .

# A REPORT LOANS row with its texts at their longest: HOLDER and CONTACT
# of that kind, on that item, after Dave's loan (due the same day).
> LOAN OUT 208 HOLDER="\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" CONTACT="\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" DUE=20261231
< +OK ID=7
> REPORT LOANS AFTER=LOANS2:2020203032303236313233312020202020202034:4
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< R 0 7 208 L 1 "\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" 0 "\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" 20261008 20261231 "\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"" "\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\"\""
< .

# Level 1 runs both reports.
> USER ADD READER LEVEL=1 PASSWORD=readpw01
< +OK
@SESSION
> HELLO PC1
< +OK
> LOGIN READER readpw01
< +OK LEVEL=1 MUSTCHG=1
> PASSWD readpw01 readpw02
< +OK
> REPORT ITEMS CAT=CARD
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 2 CARD Hercules "Graphics Card" HGC-1 EXC ? 2 1 "Shelf A1" A "" "" ""
< C ITEMS1:2020202020323030:C8
< .
> REPORT LOANS OVERDUE=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< R 1 5 2 L 1 Eve 0 "" 20260920 20261001 Hercules "Graphics Card"
< R 1 1 3 L 1 "Jane Smith" 0 555-0101 20261001 20261007 Intel 8088
< .
