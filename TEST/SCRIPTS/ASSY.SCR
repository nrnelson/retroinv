# ASSY commands: every success and error response, the FIELD= names,
# the LEVEL column of BOM and PATH, paging with cursors through every
# list, deleted parts, the depth and size limits, and the audit rows.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK
> LOC ADD LOC_NAME=A1 LTYPE=BIN LOC_CODE=A1
< +OK ID=1
> LOC ADD LOC_NAME=B2 LTYPE=BIN LOC_CODE=B2
< +OK ID=2
> ITEM ADD CATEGORY=SYS MFR=IBM MODEL=5150 LOC_ID=A1
< +OK ID=1
> ITEM ADD CATEGORY=MOBO MFR=IBM MODEL="64-256K"
< +OK ID=2
> ITEM ADD CATEGORY=CPU MFR=Intel MODEL=8088
< +OK ID=3
> ITEM ADD CATEGORY=CPU MFR=Intel MODEL=8087
< +OK ID=4
> ITEM ADD CATEGORY=CARD MFR=IBM MODEL=CGA
< +OK ID=5
> ITEM ADD CATEGORY=SYS MFR=Compaq MODEL=Portable LOC_ID=B2
< +OK ID=6
> ITEM ADD CATEGORY=DRV MFR=Tandon MODEL=TM100-2
< +OK ID=7

# No assemblies yet: the lists are empty, a top-level item has no path.
> ASSY LIST
< +DATA
< F ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< .
> ASSY LIST TOP=1
< +DATA
< F ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< .
> ASSY BOM 1
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< .
> ASSY CHILDREN 1
< +DATA
< F ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< .
> ASSY PATH 1
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL LOC_ID LOC_NAME
< .

# ASSY INSTALL: the child takes the location of the parent's top-level
# item, and so do its own parts.
> ASSY INSTALL 3 2
< +OK
> ASSY INSTALL 4 3
< +OK
> ASSY INSTALL 2 1
< +OK
> ASSY INSTALL 5 1
< +OK
> ASSY INSTALL 7 6
< +OK
> LOC CONTENTS A1 FIELDS=ITEM_ID,PARENT_ID,LOC_ID
< +DATA
< F ITEM_ID PARENT_ID LOC_ID
< R 1 0 1
< R 2 1 1
< R 3 2 1
< R 4 3 1
< R 5 1 1
< .
> LOC CONTENTS B2 FIELDS=ITEM_ID,PARENT_ID,LOC_ID
< +DATA
< F ITEM_ID PARENT_ID LOC_ID
< R 6 0 2
< R 7 6 2
< .
# Installing a child in its own parent again changes nothing.
> ASSY INSTALL 2 1
< +OK

# ASSY BOM: depth first, each part before its own parts, LEVEL 1 for a
# part of the item named; FIELDS= and paging with the cursor.
> ASSY BOM 1
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< R 1 2 MOBO IBM 64-256K ? 1 I 1 A1 A
< R 2 3 CPU Intel 8088 ? 1 I 1 A1 A
< R 3 4 CPU Intel 8087 ? 1 I 1 A1 A
< R 1 5 CARD IBM CGA ? 1 I 1 A1 A
< .
> ASSY BOM 1 FIELDS=ITEM_ID,MODEL PAGE=2
< +DATA
< F LEVEL ITEM_ID MODEL
< R 1 2 64-256K
< R 2 3 8088
< C ITEMS3:20202020202020322020202020202033:3
< .
> ASSY BOM 1 FIELDS=ITEM_ID,MODEL PAGE=2 AFTER=ITEMS3:20202020202020322020202020202033:3
< +DATA
< F LEVEL ITEM_ID MODEL
< R 3 4 8087
< R 1 5 CGA
< .
> ASSY BOM 2 AFTER=ITEMS3:20202020202020322020202020202033:3
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< R 2 4 CPU Intel 8087 ? 1 I 1 A1 A
< .
> ASSY BOM 2
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< R 1 3 CPU Intel 8088 ? 1 I 1 A1 A
< R 2 4 CPU Intel 8087 ? 1 I 1 A1 A
< .
> ASSY BOM 4
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< .
> ASSY BOM 6 FIELDS=model
< +DATA
< F LEVEL MODEL
< R 1 TM100-2
< .

# ASSY PATH: the ancestors, the top-level item first.
> ASSY PATH 4
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL LOC_ID LOC_NAME
< R 1 1 SYS IBM 5150 1 A1
< R 2 2 MOBO IBM 64-256K 1 A1
< R 3 3 CPU Intel 8088 1 A1
< .
> ASSY PATH 2
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL LOC_ID LOC_NAME
< R 1 1 SYS IBM 5150 1 A1
< .
> ASSY PATH 7
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL LOC_ID LOC_NAME
< R 1 6 SYS Compaq Portable 2 B2
< .

# ASSY CHILDREN: the direct parts in ID order, paged.
> ASSY CHILDREN 1
< +DATA
< F ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< R 2 MOBO IBM 64-256K ? 1 I 1 A1 A
< R 5 CARD IBM CGA ? 1 I 1 A1 A
< .
> ASSY CHILDREN 1 FIELDS=ITEM_ID PAGE=1
< +DATA
< F ITEM_ID
< R 2
< C ITEMS3:20202020202020312020202020202032:2
< .
> ASSY CHILDREN 1 FIELDS=ITEM_ID PAGE=1 AFTER=ITEMS3:20202020202020312020202020202032:2
< +DATA
< F ITEM_ID
< R 5
< .
> ASSY CHILDREN 4
< +DATA
< F ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< .

# ASSY LIST: the items with parts in ID order; TOP=1 the assemblies.
> ASSY LIST FIELDS=ITEM_ID,MODEL
< +DATA
< F ITEM_ID MODEL
< R 1 5150
< R 2 64-256K
< R 3 8088
< R 6 Portable
< .
> ASSY LIST TOP=1 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< R 6
< .
> ASSY LIST TOP=0 FIELDS=ITEM_ID PAGE=1
< +DATA
< F ITEM_ID
< R 1
< C ITEMS3:20202020202020313939393939393939:2
< .
> ASSY LIST FIELDS=ITEM_ID PAGE=2 AFTER=ITEMS3:20202020202020313939393939393939:2
< +DATA
< F ITEM_ID
< R 2
< R 3
< C ITEMS3:20202020202020333939393939393939:4
< .
> ASSY LIST FIELDS=ITEM_ID PAGE=2 AFTER=ITEMS3:20202020202020333939393939393939:4
< +DATA
< F ITEM_ID
< R 6
< .
> ASSY LIST TOP=1 FIELDS=ITEM_ID AFTER=ITEMS3:20202020202020313939393939393939:2
< +DATA
< F ITEM_ID
< R 6
< .

# Argument errors: IDs, extra arguments and keys, FIELDS=, PAGE=, TOP=,
# and cursors (a BOM or CHILDREN cursor must name an entry below the
# item).
> ASSY INSTALL
< -ERR 102 missing argument FIELD=CHILD
> ASSY INSTALL 7
< -ERR 102 missing argument FIELD=PARENT
> ASSY INSTALL 0 1
< -ERR 102 bad ID FIELD=CHILD
> ASSY INSTALL 7 x
< -ERR 102 bad ID FIELD=PARENT
> ASSY INSTALL 7 100000000
< -ERR 102 bad ID FIELD=PARENT
> ASSY INSTALL 7 1 2
< -ERR 100 too many arguments
> ASSY INSTALL 7 1 LOC=A1
< -ERR 102 unexpected key FIELD=LOC
> ASSY INSTALL 9 1
< -ERR 200 no such item FIELD=CHILD
> ASSY INSTALL 7 9
< -ERR 200 no such item FIELD=PARENT
> ASSY REMOVE LOC=A1
< -ERR 102 missing argument FIELD=CHILD
> ASSY REMOVE -1 LOC=A1
< -ERR 102 bad ID FIELD=CHILD
> ASSY REMOVE 9 LOC=A1
< -ERR 200 no such item FIELD=CHILD
> ASSY REMOVE 7 B2
< -ERR 100 too many arguments
> ASSY REMOVE 7 LOC=B2 ALL=1
< -ERR 102 unexpected key FIELD=ALL
> ASSY MOVE LOC=A1
< -ERR 102 missing argument FIELD=ID
> ASSY MOVE 1x LOC=A1
< -ERR 102 bad ID FIELD=ID
> ASSY MOVE 9 LOC=A1
< -ERR 200 no such item FIELD=ID
> ASSY MOVE 1 2 LOC=A1
< -ERR 100 too many arguments
> ASSY BOM
< -ERR 102 missing argument FIELD=ID
> ASSY BOM 9
< -ERR 200 no such item FIELD=ID
> ASSY BOM 1 2
< -ERR 100 too many arguments
> ASSY BOM 1 TOP=1
< -ERR 102 unexpected key FIELD=TOP
> ASSY BOM 1 FIELDS=FOO
< -ERR 102 no such field FIELD=FOO
> ASSY BOM 1 FIELDS=NOTES
< -ERR 102 memo fields cannot be listed FIELD=NOTES
> ASSY BOM 1 PAGE=0
< -ERR 102 bad page size FIELD=PAGE
> ASSY BOM 1 PAGE=26
< -ERR 102 bad page size FIELD=PAGE
> ASSY BOM 1 AFTER=junk
< -ERR 204 bad cursor
> ASSY BOM 1 AFTER=ITEMS1:2020202020202031:1
< -ERR 204 bad cursor
> ASSY PATH
< -ERR 102 missing argument FIELD=ID
> ASSY PATH 9
< -ERR 200 no such item FIELD=ID
> ASSY PATH 1 2
< -ERR 100 too many arguments
> ASSY PATH 1 FIELDS=ITEM_ID
< -ERR 102 unexpected key FIELD=FIELDS
> ASSY PATH 1 PAGE=1
< -ERR 102 unexpected key FIELD=PAGE
> ASSY CHILDREN
< -ERR 102 missing argument FIELD=ID
> ASSY CHILDREN 9
< -ERR 200 no such item FIELD=ID
> ASSY CHILDREN 1 TOP=1
< -ERR 102 unexpected key FIELD=TOP
> ASSY CHILDREN 1 AFTER=junk
< -ERR 204 bad cursor
> ASSY LIST 1
< -ERR 100 too many arguments
> ASSY LIST TOP=2
< -ERR 102 bad or missing argument FIELD=TOP
> ASSY LIST TOP=2 FIELDS=FOO
< -ERR 102 no such field FIELD=FOO
> ASSY LIST TOP=2 FOO=1
< -ERR 102 unexpected key FIELD=FOO
> ASSY LIST TOP=
< +DATA
< F ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< R 1 SYS IBM 5150 ? 1 Y 1 A1 A
< R 2 MOBO IBM 64-256K ? 1 I 1 A1 A
< R 3 CPU Intel 8088 ? 1 I 1 A1 A
< R 6 SYS Compaq Portable ? 1 Y 2 B2 A
< .
> ASSY LIST TOP=01
< -ERR 102 bad or missing argument FIELD=TOP
> ASSY LIST FIELDS=FOO
< -ERR 102 no such field FIELD=FOO
> ASSY LIST PAGE=x
< -ERR 102 bad page size FIELD=PAGE
> ASSY LIST AFTER=junk
< -ERR 204 bad cursor
> ASSY BOM 1 AFTER=ITEMS3:20202020202020362020202020202037:7
< -ERR 204 bad cursor
> ASSY CHILDREN 1 AFTER=ITEMS3:20202020202020362020202020202037:7
< -ERR 204 bad cursor

# Rule errors: a cycle (the parent is the child or one of its parts),
# and a location change of an installed item or of an assembly, which
# moves as a whole; ITEM DEL of an item with live parts, and STATUS=D
# for an installed item.
> ASSY INSTALL 1 1
< -ERR 202 cannot be put inside itself or its contents FIELD=PARENT
> ASSY INSTALL 1 2
< -ERR 202 cannot be put inside itself or its contents FIELD=PARENT
> ASSY INSTALL 2 4
< -ERR 202 cannot be put inside itself or its contents FIELD=PARENT
> ASSY INSTALL 6 7
< -ERR 202 cannot be put inside itself or its contents FIELD=PARENT
> ITEM SET 4 LOC_ID=B2
< -ERR 202 assemblies move as a whole FIELD=LOC_ID
> ITEM SET 1 LOC_ID=B2
< -ERR 202 assemblies move as a whole FIELD=LOC_ID
> ITEM DEL 3
< -ERR 202 item has parts installed: remove them first
> ITEM SET 4 STATUS=D
< -ERR 202 installed in an assembly FIELD=STATUS

# An installed child moves to its new parent with its parts, which take
# the new location.
> ASSY INSTALL 3 6
< +OK
> ASSY BOM 6 FIELDS=ITEM_ID,LOC_ID
< +DATA
< F LEVEL ITEM_ID LOC_ID
< R 1 3 2
< R 2 4 2
< R 1 7 2
< .
> ASSY BOM 1 FIELDS=ITEM_ID,LOC_ID
< +DATA
< F LEVEL ITEM_ID LOC_ID
< R 1 2 1
< R 1 5 1
< .

# ASSY REMOVE: the child becomes top level at LOC=, with its parts; LOC=
# is required and must name a location, by LOC_ID or by code (a
# lower-case code is found), or be 0 for unknown.
> ASSY REMOVE 1 LOC=A1
< -ERR 202 not part of an assembly FIELD=CHILD
> ASSY REMOVE 3
< -ERR 102 bad or missing argument FIELD=LOC
> ASSY REMOVE 3 LOC=
< -ERR 102 bad or missing argument FIELD=LOC
> ASSY REMOVE 3 LOC="  "
< -ERR 102 bad or missing argument FIELD=LOC
> ASSY REMOVE 3 LOC=Z9
< -ERR 202 unknown location FIELD=LOC
> ASSY REMOVE 3 LOC=99
< -ERR 202 unknown location FIELD=LOC
> ASSY REMOVE 3 LOC=a1
< +OK
> ASSY PATH 4
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL LOC_ID LOC_NAME
< R 1 3 CPU Intel 8088 1 A1
< .
> ASSY CHILDREN 6
< +DATA
< F ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< R 7 DRV Tandon TM100-2 ? 1 I 2 B2 A
< .
> LOC CONTENTS A1 FIELDS=ITEM_ID,PARENT_ID,LOC_ID
< +DATA
< F ITEM_ID PARENT_ID LOC_ID
< R 1 0 1
< R 2 1 1
< R 3 0 1
< R 4 3 1
< R 5 1 1
< .

# ASSY MOVE: a top-level item and all its parts; items already there are
# not written.
> ASSY INSTALL 3 1
< +OK
> ASSY MOVE 2 LOC=B2
< -ERR 202 installed in an assembly FIELD=ID
> ASSY MOVE 1
< -ERR 102 bad or missing argument FIELD=LOC
> ASSY MOVE 1 LOC=
< -ERR 102 bad or missing argument FIELD=LOC
> ASSY MOVE 1 LOC="  "
< -ERR 102 bad or missing argument FIELD=LOC
> ASSY MOVE 1 LOC=Z9
< -ERR 202 unknown location FIELD=LOC
> ASSY MOVE 1 LOC=B2
< +OK
> LOC CONTENTS B2 FIELDS=ITEM_ID,PARENT_ID,LOC_ID
< +DATA
< F ITEM_ID PARENT_ID LOC_ID
< R 1 0 2
< R 2 1 2
< R 3 1 2
< R 4 3 2
< R 5 1 2
< R 6 0 2
< R 7 6 2
< .
> ASSY MOVE 1 LOC=b2
< +OK
> ASSY MOVE 1 LOC=0
< +OK
> LOC CONTENTS 0 FIELDS=ITEM_ID,PARENT_ID,LOC_ID
< +DATA
< F ITEM_ID PARENT_ID LOC_ID
< R 1 0 0
< R 2 1 0
< R 3 1 0
< R 4 3 0
< R 5 1 0
< .
> ASSY MOVE 1 LOC=2
< +OK
> ASSY MOVE 7 LOC=A1
< -ERR 202 installed in an assembly FIELD=ID

# A deleted part is left out of BOM, CHILDREN and LIST; an item whose
# parts are all deleted has none.
> ITEM DEL 5
< +OK
> ITEM DEL 7
< +OK
> ASSY BOM 1 FIELDS=ITEM_ID
< +DATA
< F LEVEL ITEM_ID
< R 1 2
< R 1 3
< R 2 4
< .
> ASSY CHILDREN 1 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 2
< R 3
< .
> ASSY LIST FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< R 3
< .
> ASSY CHILDREN 6
< +DATA
< F ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< .
> ITEM UNDEL 7
< +OK
> ASSY LIST TOP=1 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< R 6
< .
# A deleted item is not found, whichever argument names it.
> ASSY INSTALL 5 1
< -ERR 200 no such item FIELD=CHILD
> ASSY INSTALL 1 5
< -ERR 200 no such item FIELD=PARENT
> ASSY REMOVE 5 LOC=A1
< -ERR 200 no such item FIELD=CHILD
> ASSY MOVE 5 LOC=A1
< -ERR 200 no such item FIELD=ID
> ASSY BOM 5
< -ERR 200 no such item FIELD=ID
> ASSY PATH 5
< -ERR 200 no such item FIELD=ID
> ASSY CHILDREN 5
< -ERR 200 no such item FIELD=ID

# The audit rows: INSTALL and REMOVE one P row for the item named and
# an M row for each item whose location changes, MOVE an M row per item
# moved; a refused command or one that changes nothing writes none.
@TABLE AUDIT FIELDS=USERNAME,TBL,REC_ID,ACTION,FLD,OLDVAL,NEWVAL
< F USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< R SYSTEM CATS 1 I CAT_CODE "" SYS
< R SYSTEM CATS 2 I CAT_CODE "" MOBO
< R SYSTEM CATS 3 I CAT_CODE "" CPU
< R SYSTEM CATS 4 I CAT_CODE "" CARD
< R SYSTEM CATS 5 I CAT_CODE "" DRV
< R SYSTEM CATS 6 I CAT_CODE "" PERI
< R SYSTEM CATS 7 I CAT_CODE "" SW
< R SYSTEM CATS 8 I CAT_CODE "" MAN
< R SYSTEM CATS 9 I CAT_CODE "" CBL
< R SYSTEM CATS 10 I CAT_CODE "" PART
< R SYSTEM LTYPES 1 I LT_CODE "" ROOM
< R SYSTEM LTYPES 2 I LT_CODE "" SHELF
< R SYSTEM LTYPES 3 I LT_CODE "" RACK
< R SYSTEM LTYPES 4 I LT_CODE "" CABINET
< R SYSTEM LTYPES 5 I LT_CODE "" DRAWER
< R SYSTEM LTYPES 6 I LT_CODE "" BOX
< R SYSTEM LTYPES 7 I LT_CODE "" BIN
< R SYSTEM LTYPES 8 I LT_CODE "" BUCKET
< R SYSTEM USERS 1 I USER_ID "" 1
< R ADMIN USERS 1 L "" "" ""
< R ADMIN USERS 1 W PWHASH "" ""
< R ADMIN LOCS 1 I LOC_ID "" 1
< R ADMIN LOCS 2 I LOC_ID "" 2
< R ADMIN ITEMS 1 I ITEM_ID "" 1
< R ADMIN ITEMS 2 I ITEM_ID "" 2
< R ADMIN ITEMS 3 I ITEM_ID "" 3
< R ADMIN ITEMS 4 I ITEM_ID "" 4
< R ADMIN ITEMS 5 I ITEM_ID "" 5
< R ADMIN ITEMS 6 I ITEM_ID "" 6
< R ADMIN ITEMS 7 I ITEM_ID "" 7
< R ADMIN ITEMS 3 P PARENT_ID 0 2
< R ADMIN ITEMS 4 P PARENT_ID 0 3
< R ADMIN ITEMS 3 M LOC_ID 0 1
< R ADMIN ITEMS 4 M LOC_ID 0 1
< R ADMIN ITEMS 2 M LOC_ID 0 1
< R ADMIN ITEMS 2 P PARENT_ID 0 1
< R ADMIN ITEMS 5 M LOC_ID 0 1
< R ADMIN ITEMS 5 P PARENT_ID 0 1
< R ADMIN ITEMS 7 M LOC_ID 0 2
< R ADMIN ITEMS 7 P PARENT_ID 0 6
< R ADMIN ITEMS 4 M LOC_ID 1 2
< R ADMIN ITEMS 3 M LOC_ID 1 2
< R ADMIN ITEMS 3 P PARENT_ID 2 6
< R ADMIN ITEMS 4 M LOC_ID 2 1
< R ADMIN ITEMS 3 M LOC_ID 2 1
< R ADMIN ITEMS 3 P PARENT_ID 6 0
< R ADMIN ITEMS 3 P PARENT_ID 0 1
< R ADMIN ITEMS 2 M LOC_ID 1 2
< R ADMIN ITEMS 3 M LOC_ID 1 2
< R ADMIN ITEMS 4 M LOC_ID 1 2
< R ADMIN ITEMS 5 M LOC_ID 1 2
< R ADMIN ITEMS 1 M LOC_ID 1 2
< R ADMIN ITEMS 2 M LOC_ID 2 0
< R ADMIN ITEMS 3 M LOC_ID 2 0
< R ADMIN ITEMS 4 M LOC_ID 2 0
< R ADMIN ITEMS 5 M LOC_ID 2 0
< R ADMIN ITEMS 1 M LOC_ID 2 0
< R ADMIN ITEMS 2 M LOC_ID 0 2
< R ADMIN ITEMS 3 M LOC_ID 0 2
< R ADMIN ITEMS 4 M LOC_ID 0 2
< R ADMIN ITEMS 5 M LOC_ID 0 2
< R ADMIN ITEMS 1 M LOC_ID 0 2
< R ADMIN ITEMS 5 D "" "" DELETED
< R ADMIN ITEMS 7 D "" "" DELETED
< R ADMIN ITEMS 7 D "" DELETED ""

# The depth limit: a chain of ENG_MAXDEPTH levels from item 8 down to
# item 23 is accepted; a part below item 23 is refused, and so is a
# subtree that would reach too deep.  PATH of the deepest item has the
# most rows it can have.
> ITEM ADD CATEGORY=PART MODEL=P8
< +OK ID=8
> ITEM ADD CATEGORY=PART MODEL=P9
< +OK ID=9
> ITEM ADD CATEGORY=PART MODEL=P10
< +OK ID=10
> ITEM ADD CATEGORY=PART MODEL=P11
< +OK ID=11
> ITEM ADD CATEGORY=PART MODEL=P12
< +OK ID=12
> ITEM ADD CATEGORY=PART MODEL=P13
< +OK ID=13
> ITEM ADD CATEGORY=PART MODEL=P14
< +OK ID=14
> ITEM ADD CATEGORY=PART MODEL=P15
< +OK ID=15
> ITEM ADD CATEGORY=PART MODEL=P16
< +OK ID=16
> ITEM ADD CATEGORY=PART MODEL=P17
< +OK ID=17
> ITEM ADD CATEGORY=PART MODEL=P18
< +OK ID=18
> ITEM ADD CATEGORY=PART MODEL=P19
< +OK ID=19
> ITEM ADD CATEGORY=PART MODEL=P20
< +OK ID=20
> ITEM ADD CATEGORY=PART MODEL=P21
< +OK ID=21
> ITEM ADD CATEGORY=PART MODEL=P22
< +OK ID=22
> ITEM ADD CATEGORY=PART MODEL=P23
< +OK ID=23
> ITEM ADD CATEGORY=PART MODEL=P24
< +OK ID=24
> ASSY INSTALL 9 8
< +OK
> ASSY INSTALL 10 9
< +OK
> ASSY INSTALL 11 10
< +OK
> ASSY INSTALL 12 11
< +OK
> ASSY INSTALL 13 12
< +OK
> ASSY INSTALL 14 13
< +OK
> ASSY INSTALL 15 14
< +OK
> ASSY INSTALL 16 15
< +OK
> ASSY INSTALL 17 16
< +OK
> ASSY INSTALL 18 17
< +OK
> ASSY INSTALL 19 18
< +OK
> ASSY INSTALL 20 19
< +OK
> ASSY INSTALL 21 20
< +OK
> ASSY INSTALL 22 21
< +OK
> ASSY INSTALL 23 22
< +OK
> ASSY INSTALL 24 23
< -ERR 202 parts nested more than 16 levels deep FIELD=PARENT
> ASSY INSTALL 3 22
< -ERR 202 parts nested more than 16 levels deep FIELD=PARENT
> ASSY INSTALL 3 21
< +OK
> ASSY PATH 23
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL LOC_ID LOC_NAME
< R 1 8 PART "" P8 0 ""
< R 2 9 PART "" P9 0 ""
< R 3 10 PART "" P10 0 ""
< R 4 11 PART "" P11 0 ""
< R 5 12 PART "" P12 0 ""
< R 6 13 PART "" P13 0 ""
< R 7 14 PART "" P14 0 ""
< R 8 15 PART "" P15 0 ""
< R 9 16 PART "" P16 0 ""
< R 10 17 PART "" P17 0 ""
< R 11 18 PART "" P18 0 ""
< R 12 19 PART "" P19 0 ""
< R 13 20 PART "" P20 0 ""
< R 14 21 PART "" P21 0 ""
< R 15 22 PART "" P22 0 ""
< .
> ASSY BOM 8 FIELDS=ITEM_ID PAGE=25
< +DATA
< F LEVEL ITEM_ID
< R 1 9
< R 2 10
< R 3 11
< R 4 12
< R 5 13
< R 6 14
< R 7 15
< R 8 16
< R 9 17
< R 10 18
< R 11 19
< R 12 20
< R 13 21
< R 14 3
< R 15 4
< R 14 22
< R 15 23
< .

# The size limit: ENG_MAXASSY ITEMS3 entries per assembly, the top-level
# item's own included.  Item 8's assembly holds 18 (the chain, item 3
# and its part 4); 46 more make ENG_MAXASSY, and one more is refused, by
# the parent's count or by the child's (a child with parts counts them
# all).
# A part moved within its own assembly leaves the size as it is; one
# moved out makes room.
> ITEM ADD CATEGORY=PART MODEL=P25
< +OK ID=25
> ITEM ADD CATEGORY=PART MODEL=P26
< +OK ID=26
> ITEM ADD CATEGORY=PART MODEL=P27
< +OK ID=27
> ITEM ADD CATEGORY=PART MODEL=P28
< +OK ID=28
> ITEM ADD CATEGORY=PART MODEL=P29
< +OK ID=29
> ITEM ADD CATEGORY=PART MODEL=P30
< +OK ID=30
> ITEM ADD CATEGORY=PART MODEL=P31
< +OK ID=31
> ITEM ADD CATEGORY=PART MODEL=P32
< +OK ID=32
> ITEM ADD CATEGORY=PART MODEL=P33
< +OK ID=33
> ITEM ADD CATEGORY=PART MODEL=P34
< +OK ID=34
