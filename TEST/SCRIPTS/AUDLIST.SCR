# AUDLIST.SCR - AUDIT LIST: every AUDIT field by default, or FIELDS=;
# newest first without TBL=, and with it the AUDIT1 order (by record,
# then oldest first); the TBL=, REC=, STATION= and USER= filters, USER=
# without TBL= through AUDIT2, which reads that user's rows alone; pages
# with PAGE= and AFTER= in the three orders, and the reads a page may
# take (ENG_MAXREADS) when a filter passes over every row; a cursor of
# another order, table or user (204); the argument errors.  The level
# and the gate are in PERMS.SCR.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK
> LOC ADD LOC_NAME=A1 LTYPE=BIN LOC_CODE=A1
< +OK ID=1
> ITEM ADD CATEGORY=SYS MFR=IBM MODEL=5150 LOC_ID=A1
< +OK ID=1
> ITEM ADD CATEGORY=CPU MFR=Intel MODEL=8088
< +OK ID=2
@NOW 20261009 093000
> HELLO "Lab 2"
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=3 NAME="System Administrator"
> ITEM SET 1 MODEL=5160
< +OK
> ITEM DEL 2
< +OK

# Newest first, every field, a page at a time.
> AUDIT LIST PAGE=3
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< R 27 20261009 09:30:00 "Lab 2" ADMIN ITEMS 2 D "" "" DELETED
< R 26 20261009 09:30:00 "Lab 2" ADMIN ITEMS 1 U MODEL 5150 5160
< R 25 20261009 09:30:00 "Lab 2" ADMIN USERS 1 L "" "" ""
< C AUDIT::19
< .
> AUDIT LIST PAGE=3 AFTER=AUDIT::1B
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< R 26 20261009 09:30:00 "Lab 2" ADMIN ITEMS 1 U MODEL 5150 5160
< R 25 20261009 09:30:00 "Lab 2" ADMIN USERS 1 L "" "" ""
< R 24 20261008 12:00:00 CONSOLE ADMIN ITEMS 2 I ITEM_ID "" 2
< C AUDIT::18
< .
> audit list page=2 after=audit::0019
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< R 24 20261008 12:00:00 CONSOLE ADMIN ITEMS 2 I ITEM_ID "" 2
< R 23 20261008 12:00:00 CONSOLE ADMIN ITEMS 1 I ITEM_ID "" 1
< C AUDIT::17
< .

# FIELDS= picks and orders the columns.
> AUDIT LIST FIELDS=ACTION,AUD_ID,TBL PAGE=4
< +DATA
< F ACTION AUD_ID TBL
< R D 27 ITEMS
< R U 26 ITEMS
< R L 25 USERS
< R I 24 ITEMS
< C AUDIT::18
< .

# STATION= keeps one station, compared without regard to case.
> AUDIT LIST STATION="lab 2" FIELDS=AUD_ID,STATION,ACTION
< +DATA
< F AUD_ID STATION ACTION
< R 27 "Lab 2" D
< R 26 "Lab 2" U
< R 25 "Lab 2" L
< .
> AUDIT LIST STATION=console FIELDS=AUD_ID,STATION,ACTION PAGE=3
< +DATA
< F AUD_ID STATION ACTION
< R 24 CONSOLE I
< R 23 CONSOLE I
< R 22 CONSOLE I
< C AUDIT::16
< .
> AUDIT LIST STATION=NOBODY
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST STATION= FIELDS=AUD_ID PAGE=1
< +DATA
< F AUD_ID
< R 27
< C AUDIT::1B
< .

# USER= keeps one user's rows, the whole name compared without regard
# to case; with STATION= a row must match both.
> AUDIT LIST USER=admin FIELDS=AUD_ID,STATION,USERNAME,ACTION PAGE=4
< +DATA
< F AUD_ID STATION USERNAME ACTION
< R 27 "Lab 2" ADMIN D
< R 26 "Lab 2" ADMIN U
< R 25 "Lab 2" ADMIN L
< R 24 CONSOLE ADMIN I
< C AUDIT2:41444D494E2020203939393939393735:18
< .
> audit list user=Admin fields=AUD_ID page=3 after=audit2:41444d494e2020203939393939393735:18
< +DATA
< F AUD_ID
< R 23
< R 22
< R 21
< C AUDIT2:41444D494E2020203939393939393738:15
< .
> AUDIT LIST USER=ADMIN FIELDS=AUD_ID AFTER=AUDIT2:41444D494E2020203939393939393738:15
< +DATA
< F AUD_ID
< R 20
< .
> AUDIT LIST USER=Admin STATION=console FIELDS=AUD_ID,STATION,USERNAME,ACTION
< +DATA
< F AUD_ID STATION USERNAME ACTION
< R 24 CONSOLE ADMIN I
< R 23 CONSOLE ADMIN I
< R 22 CONSOLE ADMIN I
< R 21 CONSOLE ADMIN W
< R 20 CONSOLE ADMIN L
< .
> AUDIT LIST USER=ADMIN STATION=SYSTEM
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST USER=ADMI
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST USER="ADMIN "
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST USER=ADMINS
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST USER=12345678
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST USER= FIELDS=AUD_ID PAGE=1
< +DATA
< F AUD_ID
< R 27
< C AUDIT::1B
< .

# TBL= lists a table's rows by record, oldest first within each;
# REC= keeps one record; TBL= and REC= empty filter nothing.
> AUDIT LIST TBL=items FIELDS=AUD_ID,TBL,REC_ID,ACTION,FLD,NEWVAL
< +DATA
< F AUD_ID TBL REC_ID ACTION FLD NEWVAL
< R 23 ITEMS 1 I ITEM_ID 1
< R 26 ITEMS 1 U MODEL 5160
< R 24 ITEMS 2 I ITEM_ID 2
< R 27 ITEMS 2 D "" DELETED
< .
> AUDIT LIST TBL=ITEMS REC=1 FIELDS=AUD_ID,REC_ID,ACTION,FLD,OLDVAL,NEWVAL
< +DATA
< F AUD_ID REC_ID ACTION FLD OLDVAL NEWVAL
< R 23 1 I ITEM_ID "" 1
< R 26 1 U MODEL 5150 5160
< .
> AUDIT LIST TBL=ITEMS REC=00000001 FIELDS=AUD_ID PAGE=1
< +DATA
< F AUD_ID
< R 23
< C AUDIT1:4954454D5320202020202020202020312020202020203233:17
< .
> AUDIT LIST TBL=ITEMS REC=1 FIELDS=AUD_ID PAGE=1 AFTER=AUDIT1:4954454D5320202020202020202020312020202020203233:17
< +DATA
< F AUD_ID
< R 26
< .
> AUDIT LIST TBL=CATS STATION=SYSTEM FIELDS=AUD_ID,REC_ID,NEWVAL PAGE=2
< +DATA
< F AUD_ID REC_ID NEWVAL
< R 1 1 SYS
< R 2 2 MOBO
< C AUDIT1:434154532020202020202020202020322020202020202032:2
< .
> AUDIT LIST TBL=USERS REC=1 STATION="LAB 2" FIELDS=AUD_ID,ACTION
< +DATA
< F AUD_ID ACTION
< R 25 L
< .
> AUDIT LIST TBL=ITEMS USER=admin FIELDS=AUD_ID,REC_ID,ACTION
< +DATA
< F AUD_ID REC_ID ACTION
< R 23 1 I
< R 26 1 U
< R 24 2 I
< R 27 2 D
< .
> AUDIT LIST TBL=CATS USER=ADMIN
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST TBL=LOANS
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST TBL=NOSUCH
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST TBL= REC= FIELDS=AUD_ID PAGE=1
< +DATA
< F AUD_ID
< R 27
< C AUDIT::1B
< .

# A cursor of the other order, of another table or record, or not a
# cursor: 204.
> AUDIT LIST AFTER=AUDIT1:4954454D53:1
< -ERR 204 bad cursor
> AUDIT LIST TBL=ITEMS AFTER=AUDIT::5
< -ERR 204 bad cursor
> AUDIT LIST TBL=ITEMS AFTER=AUDIT1:43415453:1
< -ERR 204 bad cursor
> AUDIT LIST TBL=ITEMS REC=2 AFTER=AUDIT1:4954454D5320202020202020202020312020202020203133:D
< -ERR 204 bad cursor
> AUDIT LIST AFTER=AUDIT::0
< -ERR 204 bad cursor
> AUDIT LIST AFTER=ITEMS::1
< -ERR 204 bad cursor
> AUDIT LIST USER=ADMIN AFTER=AUDIT::5
< -ERR 204 bad cursor
> AUDIT LIST AFTER=AUDIT2:41444D494E2020203939393939393735:18
< -ERR 204 bad cursor
> AUDIT LIST USER=SYSTEM AFTER=AUDIT2:41444D494E2020203939393939393735:18
< -ERR 204 bad cursor
> AUDIT LIST TBL=ITEMS USER=ADMIN AFTER=AUDIT2:41444D494E2020203939393939393735:18
< -ERR 204 bad cursor

# The argument errors.
> AUDIT LIST REC=1
< -ERR 102 value required FIELD=TBL
> AUDIT LIST TBL=ITEMS REC=0
< -ERR 102 bad ID FIELD=REC
> AUDIT LIST TBL=ITEMS REC=X
< -ERR 102 bad ID FIELD=REC
> AUDIT LIST TBL=ITEMSXXXX
< -ERR 102 filter value too long FIELD=TBL
> AUDIT LIST STATION=12345678901234567
< -ERR 102 filter value too long FIELD=STATION
> AUDIT LIST USER=123456789
< -ERR 102 filter value too long FIELD=USER
> AUDIT LIST FOO=1
< -ERR 102 unexpected key FIELD=FOO
> AUDIT LIST X
< -ERR 100 too many arguments
> AUDIT LIST PAGE=0
< -ERR 102 bad page size FIELD=PAGE
> AUDIT LIST FIELDS=NOPE
< -ERR 102 no such field FIELD=NOPE
> AUDIT LIST TBL=ITEMS TBL=LOCS
< -ERR 102 bad or missing argument FIELD=TBL

# A filter that passes over every row stops after ENG_MAXREADS rows
# with an empty page and a cursor, and the next request goes on from
# there.
@REPEAT 205
> LOC NOTES A1 ADD=x
< +OK
> AUDIT LIST STATION=NOBODY
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< C AUDIT::21
< .
> AUDIT LIST STATION=NOBODY AFTER=AUDIT::21
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST TBL=ITEMS REC=1 STATION=NOBODY
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .

# USER= reads only that user's rows, whatever the others': none for a
# name without rows or one that only starts another's, and SYSTEM's
# below the 213 rows of ADMIN.  With STATION= passing over every row of
# the user, the page still ends after ENG_MAXREADS of them.
> AUDIT LIST USER=NOBODY
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST USER=ADMI
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .
> AUDIT LIST USER=system FIELDS=AUD_ID,USERNAME PAGE=2
< +DATA
< F AUD_ID USERNAME
< R 19 SYSTEM
< R 18 SYSTEM
< C AUDIT2:53595354454D20203939393939393831:12
< .
> AUDIT LIST USER=ADMIN STATION=NOBODY
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< C AUDIT2:41444D494E2020203939393939393636:21
< .
> AUDIT LIST USER=ADMIN STATION=NOBODY AFTER=AUDIT2:41444D494E2020203939393939393636:21
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< .

# USER= of a full ENG_USERLEN name keeps that user's rows.
> USER ADD ABCDEFGH LEVEL=3 PASSWORD=pw12345
< +OK
> LOGIN abcdefgh pw12345
< +OK LEVEL=3 MUSTCHG=1
> PASSWD pw12345 pw67890
< +OK
> AUDIT LIST USER=abcdefgh FIELDS=AUD_ID,USERNAME,TBL,ACTION
< +DATA
< F AUD_ID USERNAME TBL ACTION
< R 235 ABCDEFGH USERS W
< R 234 ABCDEFGH USERS L
< .
