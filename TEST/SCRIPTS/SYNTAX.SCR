# SYNTAX.SCR - request syntax and its error codes: 100 syntax error, 101
# unknown command, 102 bad or missing argument, 103 line too long, 104
# not available in this version; quoting and escapes; empty lines; and
# the framing of memo and paged output.

# An empty line, or one of only spaces, is no request and gets no
# response, in any state.
>
@SEND \x20*4
# Syntax is checked before anything else, even before HELLO.
> PING "abc
< -ERR 100 syntax error
> FOO "abc
< -ERR 100 syntax error
> FOO
< -ERR 101 unknown command
> FOO CLIENTS
< -ERR 101 unknown command
> HELLO PC1
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK
>
@SEND \x20*4

# 100: unterminated quote, unknown escape, \x00, a quote inside a bare
# token, text after a closing quote, a bad key, a positional token after
# a pair, too many positional tokens or pairs, pairs without a command.
> HELLO "PC2
< -ERR 100 syntax error
> HELLO "A\qB"
< -ERR 100 syntax error
> HELLO "A\x00B"
< -ERR 100 syntax error
> HELLO "A\x4"
< -ERR 100 syntax error
> HELLO A"B
< -ERR 100 syntax error
> HELLO "A"B
< -ERR 100 syntax error
> ITEM LIST 1CAT=CPU
< -ERR 100 syntax error
> ITEM LIST =CPU
< -ERR 100 syntax error
> ITEM LIST CAT=CPU 5
< -ERR 100 syntax error
> ITEM GET 1 2 3 4 5 6 7
< -ERR 100 syntax error
> ITEM LIST K0=1 K1=1 K2=1 K3=1 K4=1 K5=1 K6=1 K7=1 K8=1 K9=1 K10=1 K11=1 K12=1 K13=1 K14=1 K15=1 K16=1 K17=1 K18=1 K19=1 K20=1 K21=1 K22=1 K23=1 K24=1
< -ERR 100 syntax error
> CAT=CPU
< -ERR 100 no command
> CAT=CPU PAGE=1
< -ERR 100 no command
# A syntax error comes before a repeated key.
> ITEM LIST CAT=A CAT=B "x
< -ERR 100 syntax error
# More positional arguments than a command takes.
> PING X
< -ERR 100 too many arguments
> VER 1
< -ERR 100 too many arguments
> WHOAMI ME
< -ERR 100 too many arguments
> STATUS ALL
< -ERR 100 too many arguments
> HELLO PC1 PC2
< -ERR 100 too many arguments
> LOGIN ADMIN secret1 X
< -ERR 100 too many arguments
> PASSWD secret1 secret2 X
< -ERR 100 too many arguments
> BYE NOW
< -ERR 100 too many arguments
> ITEM GET 1 2
< -ERR 100 too many arguments
# The session is unchanged by all of these.
> WHOAMI
< +DATA
< K USER=ADMIN
< K LEVEL=3
< K STATION=PC1
< .

# 101: unknown verbs and unknown or missing second words of a group.
> PINGG
< -ERR 101 unknown command
> ITEM
< -ERR 101 unknown command
> ITEM BAR 1
< -ERR 101 unknown command
> USER
< -ERR 101 unknown command
> CAT GET CPU
< -ERR 101 unknown command
> LOC FIND A1
< -ERR 101 unknown command
> "ITEM GET" 1
< -ERR 101 unknown command
# Keywords are case-insensitive, and a quoted keyword is still a keyword.
> ping
< +OK
> Ver
< +OK RETROINV 1.0
> item get 1
< -ERR 200 no such item
> "ITEM" "GET" 1
< -ERR 200 no such item

# 102: a repeated key, a key a command does not take, missing or bad
# arguments, naming the field.
> ITEM LIST CAT=A CAT=B
< -ERR 102 bad or missing argument FIELD=CAT
> ITEM LIST cat=A Cat=B
< -ERR 102 bad or missing argument FIELD=CAT
> PING K=V
< -ERR 102 unexpected key FIELD=K
> WHOAMI user=ME
< -ERR 102 unexpected key FIELD=USER
> HELLO
< -ERR 102 missing argument FIELD=STATION
> ITEM GET
< -ERR 102 missing argument FIELD=ID
> ITEM GET abc
< -ERR 102 bad ID FIELD=ID
> ITEM GET 0
< -ERR 102 bad ID FIELD=ID
> ITEM GET 000
< -ERR 102 bad ID FIELD=ID
> ITEM GET -1
< -ERR 102 bad ID FIELD=ID
> ITEM GET +1
< -ERR 102 bad ID FIELD=ID
> ITEM GET 1.0
< -ERR 102 bad ID FIELD=ID
> ITEM GET ""
< -ERR 102 bad ID FIELD=ID
> ITEM GET 100000000
< -ERR 102 bad ID FIELD=ID
> ITEM GET 99999999999999999999
< -ERR 102 bad ID FIELD=ID
> ITEM GET 99999999
< -ERR 200 no such item
> ITEM GET 0000000000001
< -ERR 200 no such item
> ITEM LIST PAGE=0
< -ERR 102 bad page size FIELD=PAGE
> ITEM LIST PAGE=26
< -ERR 102 bad page size FIELD=PAGE
> ITEM LIST PAGE=
< -ERR 102 bad page size FIELD=PAGE
> ITEM LIST PAGE=1x
< -ERR 102 bad page size FIELD=PAGE
> ITEM LIST PAGE=-1
< -ERR 102 bad page size FIELD=PAGE
> ITEM LIST PAGE=000025
< +DATA
<*
> ITEM LIST PAGE=1
< +DATA
<*

# 103: a request longer than 292 bytes, whatever it holds; 292 bytes
# pass.
@SEND PING\x20*288
< +OK
@SEND PING\x20*289
< -ERR 103 line too long
@SEND FOOX*290
< -ERR 103 line too long
@SEND \x20*293
< -ERR 103 line too long

# Command words: case, quoting, groups alone; 104 after parsing.  A
# command in lower case runs as in upper case (assy bom, maint recent), a
# quoted command word is still that word (LOAN "OUT"), and a group word
# alone is 101.  A group of a later version is 104 whatever follows its
# verb, but only once the request has been parsed: a repeated key is 102
# first.
> assy bom 1
< -ERR 200 no such item FIELD=ID
> maint recent
< +DATA
< F MAINT_ID ITEM_ID MDATE MTYPE SUMMARY COST
< .
> maint
< -ERR 101 unknown command
> LOAN "OUT" 1 QTY=1
< -ERR 200 no such item FIELD=ITEM
> ADMIN 1 2 3 4 5 6 7
< -ERR 101 unknown command
> AUDIT LIST TBL=ITEMS TBL=LOCS
< -ERR 102 bad or missing argument FIELD=TBL

# Quoting: spaces, '=', escapes, CP437 bytes, and how values come back.
> HELLO "My Station"
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=3 NAME="System Administrator"
> WHOAMI
< +DATA
< K USER=ADMIN
< K LEVEL=3
< K STATION="My Station"
< .
> HELLO "a\"b\\c=d"
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=3 NAME="System Administrator"
> WHOAMI
< +DATA
< K USER=ADMIN
< K LEVEL=3
< K STATION="a\"b\\c=d"
< .
> HELLO \x41\
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=3 NAME="System Administrator"
> WHOAMI
< +DATA
< K USER=ADMIN
< K LEVEL=3
< K STATION="\\x41\\"
< .
> HELLO "\x41\x62"
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=3 NAME="System Administrator"
> WHOAMI
< +DATA
< K USER=ADMIN
< K LEVEL=3
< K STATION=Ab
< .
> HELLO °±²Û
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=3 NAME="System Administrator"
> WHOAMI
< +DATA
< K USER=ADMIN
< K LEVEL=3
< K STATION=°±²Û
< .
# Tabs separate tokens too.
@SEND PING\x09
< +OK
@SEND HELLO\x09PC1
< +OK
@SEND LOGIN ADMIN\x09secret1
< +OK LEVEL=3 NAME="System Administrator"

# Memo output: one L line per memo line, "L" alone for an empty one, '\'
# doubled, a line longer than 200 written bytes split, and a memo of
# the engine's largest size still sent whole.
> ITEM ADD CATEGORY=CPU
< +OK ID=1
> ITEM NOTES 1
< +DATA
< .
> ITEM NOTES 1 ADD="one\n\ntwo\\three\x09four"
< +OK
> ITEM NOTES 1
< +DATA
< L one
< L
< L two\\three	four
< .
# A data line that begins with '.' is sent with a second '.'; this one
# begins with "L", so it is not.
> ITEM NOTES 1 ADD=".dot"
< +OK
> ITEM NOTES 1
< +DATA
< L one
< L
< L two\\three	four
< L .dot
< .
> ITEM ADD CATEGORY=CPU
< +OK ID=2
> ITEM NOTES 2 ADD="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\\\\yyyyyyyyyyyyyyyyyyyy"
< +OK
> ITEM NOTES 2
< +DATA
< L xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
< L \\\\yyyyyyyyyyyyyyyyyyyy
< .
> ITEM ADD CATEGORY=CPU
< +OK ID=3
> ITEM NOTES 3 ADD="\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"
