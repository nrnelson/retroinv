> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK

# BYE still runs while the password change is pending.
@SESSION
> HELLO PC1
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=3 NAME="System Administrator"
> USER ADD TEMP2 LEVEL=1 PASSWORD=temppw01
< +OK
> LOGIN TEMP2 temppw01
< +OK LEVEL=1 MUSTCHG=1
> BYE
< +OK
@CLOSED
@SESSION
> HELLO PC1
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=3 NAME="System Administrator"

# Level 3: every command runs.  Two more users for the other levels.
> USER ADD OPER LEVEL=2 PASSWORD=operpw01
< +OK
> USER ADD READER LEVEL=1 PASSWORD=readpw01
< +OK
> USER LIST
< +DATA
<*
> USER GET OPER
< +DATA
<*
> USER SET OPER FULLNAME="Op Erator"
< +OK
> USER RESET READER PASSWORD=readpw02
< +OK
> USER ADD TEMP LEVEL=1 PASSWORD=temppw01
< +OK
> USER DEL TEMP
< +OK
> CAT ADD BOOK CAT_NAME=Books
< +OK
> CAT SET BOOK SORTORD=11
< +OK
> LTYPE ADD CRATE LT_NAME=Crate
< +OK
> LTYPE SET CRATE SORTORD=11
< +OK
> LOC ADD LOC_NAME="Shelf A1" LTYPE=BIN LOC_CODE=A1
< +OK ID=1
> LOC SET A1 LTYPE=SHELF
< +OK
> ITEM ADD CATEGORY=CPU MFR=Intel MODEL=8088
< +OK ID=1
> ITEM SET 1 LOC_ID=A1
< +OK
> ITEM COPY 1
< +OK ID=2
> ITEM DEL 2
< +OK
> ITEM UNDEL 2
< +OK
> ITEM NOTES 1 ADD="first note"
< +OK
> STATUS
< +DATA
< K ITEMS=2
< K LOCS=1
< K CATS=11
< K LTYPES=9
< K MAINT=0
< K LOANS=0
< K AUDIT=44
< K USERS=5
< .
> WHOAMI
< +DATA
< K USER=ADMIN
< K LEVEL=3
< K STATION=PC1
< .
# The assembly, maintenance and loan commands pass the gate at every
# level they need and give their own answers; a group word alone or
# with an unknown second word is 101.
> ASSY LIST
< +DATA
< F ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< .
> ASSY BOM 1
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< .
> ASSY PATH 1
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL LOC_ID LOC_NAME
< .
> ASSY CHILDREN 1
< +DATA
< F ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< .
> ASSY INSTALL 2 1
< +OK
> ASSY BOM 1
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< R 1 2 CPU Intel 8088 ? 1 I 1 "Shelf A1" A
< .
> ASSY REMOVE 2 LOC=A1
< +OK
> ASSY MOVE 1 LOC=A1
< +OK
> MAINT ADD 1 MTYPE=CL SUMMARY=x
< +OK ID=1
> MAINT GET 1
< +DATA
<*
> MAINT LIST 1
< +DATA
<*
> MAINT RECENT
< +DATA
<*
> MAINT NOTES 1
< +DATA
< .
> MAINT SET 1 SUMMARY=y
< +OK
> MAINT NOTES 1 ADD="x"
< +OK
> MAINT DEL 1
< +OK
> LOAN GET 1
< -ERR 200 not found FIELD=ID
> LOAN LIST
< +DATA
<*
> LOAN OVERDUE
< +DATA
<*
> LOAN OUT 1 HOLDER=Jo DUE=20991231
< +OK ID=1
> LOAN ADD 1 HOLDER=Jo DUE=20991231
< -ERR 202 not enough on hand FIELD=QTY
> LOAN RESERVE 1 HOLDER=Jo
< -ERR 202 not enough on hand FIELD=QTY
> LOAN USE 1 HOLDER=Jo
< -ERR 202 not enough on hand FIELD=QTY
> LOAN RETURN 1
< +OK
> LOAN SET 1 CONTACT=x
< +OK
> ASSY
< -ERR 101 unknown command
> MAINT
< -ERR 101 unknown command
> LOAN
< -ERR 101 unknown command
