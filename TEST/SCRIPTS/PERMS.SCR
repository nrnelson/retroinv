< -ERR 203 permission denied

# A read-only station caps every user at level 1, its name matched
# without regard to case.  Whether the station is capped is decided at
# HELLO, and the level it caps at LOGIN.
@READONLY RO1,Ro2
> HELLO ro1
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=1 NAME="System Administrator"
> WHOAMI
< +DATA
< K USER=ADMIN
< K LEVEL=1
< K STATION=ro1
< .
> USER LIST
< -ERR 203 permission denied
> USER ADD X LEVEL=1 PASSWORD=abcdef
< -ERR 203 permission denied
> ITEM ADD CATEGORY=CPU
< -ERR 203 permission denied
> ITEM SET 1 MFR=X
< -ERR 203 permission denied
> ITEM DEL 1
< -ERR 203 permission denied
> ITEM NOTES 1 ADD="not allowed"
< -ERR 203 permission denied
> CAT ADD X CAT_NAME=X
< -ERR 203 permission denied
> LTYPE ADD X LT_NAME=X
< -ERR 203 permission denied
> LOC ADD LOC_NAME=C3 LTYPE=BIN LOC_CODE=C3
< -ERR 203 permission denied
> LOC DEL A1
< -ERR 203 permission denied
> ASSY INSTALL 3 1
< -ERR 203 permission denied
> MAINT ADD 1 MTYPE=CL SUMMARY=x
< -ERR 203 permission denied
> MAINT NOTES 1 ADD="not allowed"
< -ERR 203 permission denied
> LOAN OUT 1 HOLDER=Jo DUE=20991231
< -ERR 203 permission denied
> LOAN RETURN 1
< -ERR 203 permission denied
> ASSY BOM 1
< +DATA
< F LEVEL ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< .
> ITEM GET 1
< +DATA
<*
> CAT LIST
< +DATA
<*
> LTYPE LIST
< +DATA
<*
> EXPORT ITEMS FILE=X.CSV
< -ERR 203 permission denied
> IMPORT ITEMS FILE=X.CSV
< -ERR 203 permission denied
> REPORT ITEMS
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 CPU Intel 8088 "" "" ? 1 1 "Shelf A1" A "" "" ""
< R 2 CPU Intel 8088 "" "" ? 1 1 "Shelf A1" A "" "" ""
< R 3 CPU NEC "" "" "" Y 1 1 "Shelf A1" A "" "" ""
< R 4 CPU NEC "" "" "" ? 1 0 "" A "" "" ""
< .
> REPORT LOANS
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< .
> AUDIT LIST
< -ERR 203 permission denied
> ADMIN PACK
< -ERR 203 permission denied
# The user's own password may still be changed.
> PASSWD secret1 secret2
< +OK
> HELLO RO2
< +OK
> LOGIN OPER operpw02
< +OK LEVEL=1 NAME="Op Erator"
> LOC SET A1 LOC_NAME=X
< -ERR 203 permission denied
# Another station gets the user's own level back: PACK passes the level
# gate and meets the busy one.
> HELLO PC2
< +OK
> LOGIN ADMIN secret2
< +OK LEVEL=3 NAME="System Administrator"
> USER LIST
< +DATA
<*
@OTHERS 1
> ADMIN PACK
< -ERR 402 server busy
@OTHERS 0
# A changed list applies from the next HELLO.
@READONLY PC2
> USER GET ADMIN
< +DATA
<*
> HELLO PC2
< +OK
> LOGIN ADMIN secret2
< +OK LEVEL=1 NAME="System Administrator"
> USER GET ADMIN
< -ERR 203 permission denied

# A level change takes effect at the next LOGIN.
@READONLY
> HELLO PC3
< +OK
> LOGIN ADMIN secret2
< +OK LEVEL=3 NAME="System Administrator"
> USER SET READER LEVEL=2
< +OK
> LOGIN READER readpw03
< +OK LEVEL=2 NAME=""
> ITEM SET 1 MFR=Zilog
< +OK

