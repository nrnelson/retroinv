< -ERR 101 unknown command
# REPORT ITEMS, REPORT LOANS, EXPORT and IMPORT run at level 3 (IMPORT
# only while no other session is open); REPORT alone or with an unknown
# word is 101.
> REPORT ITEMS
< +DATA
< F ITEM_ID CATEGORY MFR MODEL SERIALNO COND WORKS QTY LOC_ID LOC_NAME STATUS ACQ_DATE ACQ_PRICE CUR_VALUE
< R 1 CPU Intel 8088 "" "" ? 1 1 "Shelf A1" A "" "" ""
< R 2 CPU Intel 8088 "" "" ? 1 1 "Shelf A1" A "" "" ""
< .
> REPORT LOANS OVERDUE=1
< +DATA
< F LATE LOAN_ID ITEM_ID KIND QTY HOLDER HOST_ID CONTACT OUT_DATE DUE_DATE MFR MODEL
< .
> EXPORT ITEMS FILE=$DPERMS.CSV REPLACE=1
< +DATA
< K ROWS=2
< .
> EXPORT
< -ERR 102 missing argument FIELD=TABLE
> IMPORT ITEMS FILE=$DNONE.CSV
< -ERR 200 file not found FIELD=FILE
@OTHERS 1
> IMPORT ITEMS FILE=$DPERMS.CSV
< -ERR 402 server busy
> ADMIN PACK
< -ERR 402 server busy
> ADMIN REINDEX X
< -ERR 402 server busy
> ADMIN BACKUP
< -ERR 402 server busy
> ADMIN RESTORE DIR=$D
< -ERR 402 server busy
> AUDIT LIST TBL=ITEMS REC=1 PAGE=2
< +DATA
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< R 39 20261008 12:00:00 PC1 ADMIN ITEMS 1 I ITEM_ID "" 1
< R 40 20261008 12:00:00 PC1 ADMIN ITEMS 1 M LOC_ID 0 1
< C AUDIT1:4954454D5320202020202020202020312020202020203430:28
< .
@OTHERS 0
> REPORT
< -ERR 101 unknown command
> REPORT BINS
< -ERR 101 unknown command
# AUDIT and ADMIN are groups: alone or with an unknown word, 101.  ADMIN
# SHUTDOWN passes the gate and needs a server: 104 in local mode.
> AUDIT
< -ERR 101 unknown command
> AUDIT LIST TBL=TOOLONGNAME
< -ERR 102 filter value too long FIELD=TBL
> ADMIN
< -ERR 101 unknown command
> ADMIN BACKUP
< -ERR 102 missing argument FIELD=DIR
> ADMIN SHUTDOWN
< -ERR 104 command needs the server

