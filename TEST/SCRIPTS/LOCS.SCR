< .
> LOC CONTENTS GAR ALL=1 AFTER=ITEMS2:20202020202020312020202020202035:5
< -ERR 204 bad cursor
> LOC CONTENTS OFF AFTER=LOCS2:2020202020202030:1
< -ERR 204 bad cursor

# Moving a container moves the items in it without writing them: they
# keep their LOC_ID and now sit below the new parent.
> LOC SET OFF-A PARENT_ID=GAR
< +OK
> LOC CONTENTS GAR ALL=1 FIELDS=ITEM_ID,LOC_ID,LOC_NAME
< +DATA
< F ITEM_ID LOC_ID LOC_NAME
< R 6 8 "Box 3"
< R 2 4 "Bin 1"
< R 3 5 "Bin 2"
< .
> LOC CONTENTS OFF ALL=1 FIELDS=ITEM_ID,LOC_ID
< +DATA
< F ITEM_ID LOC_ID
< R 1 1
< R 5 1
< .
> ITEM GET 2
< +DATA
< K ITEM_ID=2
< K CATEGORY=CARD
< K ITEMTYPE=""
< K MFR=Hercules
< K MODEL=Graphics
< K SERIALNO=""
< K DESCR=""
< K COND=""
< K WORKS=?
< K QTY=1
< K ON_LOAN=0
< K RESERVED=0
< K IN_USE=0
< K ATTACHED=0
< K LOC_ID=4
< K PARENT_ID=0
< K ACQ_DATE=""
< K ACQ_SRC=""
< K ACQ_PRICE=""
< K CUR_VALUE=""
< K TAGS=""
< K STATUS=A
< K CREATED=20261008
< K UPDATED=20261008
< .
> LOC SET OFF-A PARENT_ID=OFF
< +OK

# LOC DEL: refused while an item is at the location or a location is in
# it; a deleted location is gone, and its name and code are free again.
> LOC DEL OFF
< -ERR 202 location holds items: move or delete them
> LOC DEL BOX3
< -ERR 202 location holds items: move or delete them
> LOC DEL L8
< +OK
> LOC DEL 3
< +OK
> LOC GET 3
< -ERR 200 no such location
> LOC DEL 3
< -ERR 200 no such location
> LOC SET 3 LOC_NAME=x
< -ERR 200 no such location
> LOC NOTES 3
< -ERR 200 no such location
> LOC CONTENTS 3
< -ERR 200 no such location
> LOC LIST UNDER=3
< -ERR 200 no such location
> ITEM ADD CATEGORY=SYS LOC_ID=3
< -ERR 202 unknown location FIELD=LOC_ID
> LOC ADD LOC_NAME="Shelf B" LTYPE=SHELF PARENT_ID=OFF LOC_CODE=L8
< +OK ID=15
> LOC DEL
< -ERR 102 missing argument FIELD=LOC
> LOC DEL 1 2
< -ERR 100 too many arguments
> LOC DEL 1 X=1
< -ERR 102 unexpected key FIELD=X
> LOC DEL 0
< -ERR 200 no such location
> ITEM DEL 6
< +OK
> LOC DEL BOX3
< -ERR 202 location holds locations: move or delete them

# LOC NOTES.
> LOC NOTES 2
< +DATA
< .
> LOC NOTES 2 ADD="first"
< +OK
> LOC NOTES off-a ADD="back\\slash and \"quotes\""
< +OK
> LOC NOTES 2 ADD="x\ny"
< +OK
> LOC NOTES 2
< +DATA
< L first
< L back\\slash and "quotes"
< L x
< L y
< .
> LOC NOTES 2 ADD="ctl\x02"
< -ERR 102 bad memo text FIELD=NOTES
> LOC NOTES ZZ
< -ERR 200 no such location
> LOC NOTES ZZ ADD=x
< -ERR 200 no such location
> LOC NOTES
< -ERR 102 missing argument FIELD=LOC
> LOC NOTES 1 2
< -ERR 100 too many arguments
> LOC NOTES 2 TEXT=x
< -ERR 102 unexpected key FIELD=TEXT
> LOC SET 2 NOTES="new\nnotes"
< +OK
> LOC NOTES 2
< +DATA
< L new
< L notes
< .
> LOC NOTES off-a NEW=staged
< +OK
> LOC NOTES 2 END=whole
< +OK
> LOC NOTES off-a
< +DATA
< L staged
< L whole
< .
> LOC NOTES 2 PART=x
< -ERR 204 no note being saved FIELD=NOTES
> ITEM NOTES 2 NEW=item
< +OK
> LOC NOTES 2 END=loc
< -ERR 204 no note being saved FIELD=NOTES

# A location deleted between two pages ends its part of the walk; the
# next page goes on after it, repeating and hiding nothing else.
> LOC LIST PAGE=7
< +DATA
< F DEPTH LOC_ID PARENT_ID LOC_NAME LOC_CODE LTYPE CAPACITY
< R 1 6 0 Garage GAR ROOM ""
< R 2 7 6 "Rack 1" "" RACK ""
< R 3 8 7 "Box 3" BOX3 BOX ""
< R 4 10 8 "Long stack, drawer number 4" L4 DRAWER ""
< R 5 11 10 "Long stack, drawer number 5" L5 DRAWER ""
< R 6 12 11 "Long stack, drawer number 6" L6 DRAWER ""
< R 7 13 12 "Long stack, drawer number 7" L7 DRAWER ""
