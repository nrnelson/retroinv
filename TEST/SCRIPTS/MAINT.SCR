# MAINT commands: every success and error response, FIELD= reporting,
# the NOTES key for the DETAIL memo, both lists with paging and
# FIELDS=, records of a deleted item, and the audit rows.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK
> ITEM ADD CATEGORY=SYS MFR=IBM MODEL=5150
< +OK ID=1
> ITEM ADD CATEGORY=CPU MFR=Intel MODEL=8088
< +OK ID=2

# Empty lists.
> MAINT RECENT
< +DATA
< F MAINT_ID ITEM_ID MDATE MTYPE SUMMARY COST
< .
> MAINT LIST 1
< +DATA
< F MAINT_ID ITEM_ID MDATE MTYPE SUMMARY COST
< .

# MAINT ADD: MDATE defaults to today, MTYPE is upper-cased, NOTES and
# DETAIL both set the memo, an empty MDATE= stores a blank date.
> MAINT ADD 1 MTYPE=RP SUMMARY="Recapped the PSU" COST=12.50
< +OK ID=1
> MAINT GET 1
< +DATA
< K MAINT_ID=1
< K ITEM_ID=1
< K MDATE=20261008
< K MTYPE=RP
< K SUMMARY="Recapped the PSU"
< K COST=12.50
< K DONE_BY=""
< .
> maint add 1 MTYPE=cl SUMMARY=Cleaned MDATE=20200101 DONE_BY=Norman NOTES="Dusty\nVery \"dusty\""
< +OK ID=2
> MAINT GET 2
< +DATA
< K MAINT_ID=2
< K ITEM_ID=1
< K MDATE=20200101
< K MTYPE=CL
< K SUMMARY=Cleaned
< K COST=""
< K DONE_BY=Norman
< .
> MAINT NOTES 2
< +DATA
< L Dusty
< L Very "dusty"
< .
> MAINT ADD 2 MTYPE=IN SUMMARY=Inspected MDATE=
< +OK ID=3
> MAINT GET 3
< +DATA
< K MAINT_ID=3
< K ITEM_ID=2
< K MDATE=""
< K MTYPE=IN
< K SUMMARY=Inspected
< K COST=""
< K DONE_BY=""
< .
> MAINT NOTES 3
< +DATA
< .
> MAINT ADD 1 MTYPE=MD SUMMARY="Turbo switch" MDATE=20230505 DETAIL="via DETAIL"
< +OK ID=4
> MAINT NOTES 4
< +DATA
< L via DETAIL
< .
> MAINT ADD 1 MTYPE=TS SUMMARY=Tested MDATE=20230505 COST=0
< +OK ID=5

# MAINT ADD errors.
> MAINT ADD 1 MTYPE=XX SUMMARY=x
< -ERR 102 bad or missing argument FIELD=MTYPE
> MAINT ADD 1 MTYPE=R SUMMARY=x
< -ERR 102 bad or missing argument FIELD=MTYPE
> MAINT ADD 1 SUMMARY=x
< -ERR 102 value required FIELD=MTYPE
> MAINT ADD 1 MTYPE=TS
< -ERR 102 value required FIELD=SUMMARY
> MAINT ADD 1 MTYPE=TS SUMMARY=""
< -ERR 102 value required FIELD=SUMMARY
> MAINT ADD 1 MTYPE=TS SUMMARY=x NOTES=a DETAIL=b
< -ERR 102 bad or missing argument FIELD=NOTES
> MAINT ADD 1 MTYPE=TS SUMMARY=x MAINT_ID=5
< -ERR 102 field not settable FIELD=MAINT_ID
> MAINT ADD 1 MTYPE=TS SUMMARY=x ITEM_ID=2
< -ERR 102 field not settable FIELD=ITEM_ID
> MAINT ADD 1 MTYPE=TS SUMMARY=x FOO=5
< -ERR 102 field not settable FIELD=FOO
> MAINT ADD 1 MTYPE=TS SUMMARY=x COST=-1
< -ERR 102 negative value FIELD=COST
> MAINT ADD 1 MTYPE=TS SUMMARY=x COST=abc
< -ERR 102 not a number FIELD=COST
> MAINT ADD 1 MTYPE=TS SUMMARY=1234567890123456789012345678901234567890123456789012345678901
< -ERR 102 value too long FIELD=SUMMARY
> MAINT ADD 1 MTYPE=TS SUMMARY=x MDATE=20261340
< -ERR 102 bad value FIELD=MDATE
> MAINT ADD 9 MTYPE=TS SUMMARY=x
< -ERR 200 no such item FIELD=ITEM
> MAINT ADD 0 MTYPE=TS SUMMARY=x
< -ERR 102 bad ID FIELD=ITEM
> MAINT ADD 1x MTYPE=TS SUMMARY=x
< -ERR 102 bad ID FIELD=ITEM
> MAINT ADD 100000000 MTYPE=TS SUMMARY=x
< -ERR 102 bad ID FIELD=ITEM
> MAINT ADD MTYPE=TS SUMMARY=x
< -ERR 102 missing argument FIELD=ITEM
> MAINT ADD 1 2 MTYPE=TS SUMMARY=x
< -ERR 100 too many arguments
> MAINT GET 6
< -ERR 200 not found FIELD=ID

# MAINT GET errors.
> MAINT GET 9
< -ERR 200 not found FIELD=ID
> MAINT GET 0
< -ERR 102 bad ID FIELD=ID
> MAINT GET -1
< -ERR 102 bad ID FIELD=ID
> MAINT GET 100000000
< -ERR 102 bad ID FIELD=ID
> MAINT GET 00000001
< +DATA
<*
> MAINT GET
< -ERR 102 missing argument FIELD=ID
> MAINT GET 1 2
< -ERR 100 too many arguments
> MAINT GET 1 FIELDS=SUMMARY
< -ERR 102 unexpected key FIELD=FIELDS

# MAINT LIST: the item's records, oldest MDATE first.
> MAINT LIST 1
< +DATA
< F MAINT_ID ITEM_ID MDATE MTYPE SUMMARY COST
< R 2 1 20200101 CL Cleaned ""
< R 4 1 20230505 MD "Turbo switch" ""
< R 5 1 20230505 TS Tested 0.00
< R 1 1 20261008 RP "Recapped the PSU" 12.50
< .
> MAINT LIST 2
< +DATA
< F MAINT_ID ITEM_ID MDATE MTYPE SUMMARY COST
< R 3 2 "" IN Inspected ""
< .
> MAINT LIST 1 PAGE=2
< +DATA
< F MAINT_ID ITEM_ID MDATE MTYPE SUMMARY COST
< R 2 1 20200101 CL Cleaned ""
< R 4 1 20230505 MD "Turbo switch" ""
< C MAINT1:20202020202020313230323330353035:4
< .
> MAINT LIST 1 PAGE=2 AFTER=MAINT1:20202020202020313230323330353035:4
< +DATA
< F MAINT_ID ITEM_ID MDATE MTYPE SUMMARY COST
< R 5 1 20230505 TS Tested 0.00
< R 1 1 20261008 RP "Recapped the PSU" 12.50
< .
> MAINT LIST 1 FIELDS=MAINT_ID,done_by,MTYPE
< +DATA
< F MAINT_ID DONE_BY MTYPE
< R 2 Norman CL
< R 4 "" MD
< R 5 "" TS
< R 1 "" RP
< .
> MAINT LIST 1 FIELDS=DETAIL
< -ERR 102 memo fields cannot be listed FIELD=DETAIL
> MAINT LIST 1 FIELDS=QTY
< -ERR 102 no such field FIELD=QTY
> MAINT LIST 1 PAGE=0
< -ERR 102 bad page size FIELD=PAGE
> MAINT LIST 1 AFTER=MAINT::2
< -ERR 204 bad cursor
> MAINT LIST 1 AFTER=junk
< -ERR 204 bad cursor
> MAINT LIST 2 AFTER=MAINT1:20202020202020313230323330353035:4
< -ERR 204 bad cursor
> MAINT LIST 1 LOC=A1
< -ERR 102 unexpected key FIELD=LOC
> MAINT LIST 9
< -ERR 200 no such item FIELD=ITEM
> MAINT LIST x
< -ERR 102 bad ID FIELD=ITEM
> MAINT LIST
< -ERR 102 missing argument FIELD=ITEM
> MAINT LIST 1 2
< -ERR 100 too many arguments

# MAINT RECENT: every record, the most recently added first.
> MAINT RECENT
< +DATA
< F MAINT_ID ITEM_ID MDATE MTYPE SUMMARY COST
< R 5 1 20230505 TS Tested 0.00
< R 4 1 20230505 MD "Turbo switch" ""
< R 3 2 "" IN Inspected ""
< R 2 1 20200101 CL Cleaned ""
< R 1 1 20261008 RP "Recapped the PSU" 12.50
< .
> MAINT RECENT PAGE=2 FIELDS=MAINT_ID,SUMMARY
< +DATA
< F MAINT_ID SUMMARY
< R 5 Tested
< R 4 "Turbo switch"
< C MAINT::4
< .
> MAINT RECENT PAGE=2 FIELDS=MAINT_ID,SUMMARY AFTER=MAINT::4
< +DATA
< F MAINT_ID SUMMARY
< R 3 Inspected
< R 2 Cleaned
< C MAINT::2
< .
> MAINT RECENT PAGE=2 FIELDS=MAINT_ID,SUMMARY AFTER=MAINT::2
< +DATA
< F MAINT_ID SUMMARY
< R 1 "Recapped the PSU"
< .
> MAINT RECENT AFTER=MAINT1:20202020202020313230323330353035:4
< -ERR 204 bad cursor
> MAINT RECENT AFTER=junk
< -ERR 204 bad cursor
> MAINT RECENT PAGE=26
< -ERR 102 bad page size FIELD=PAGE
> MAINT RECENT 1
< -ERR 100 too many arguments
> MAINT RECENT ITEM=1
< -ERR 102 unexpected key FIELD=ITEM

# MAINT SET: the rules of ADD hold after every change.
> MAINT SET 1 MTYPE=cl SUMMARY="Recapped and cleaned" DONE_BY=Me
< +OK
> MAINT GET 1
< +DATA
< K MAINT_ID=1
< K ITEM_ID=1
< K MDATE=20261008
< K MTYPE=CL
< K SUMMARY="Recapped and cleaned"
< K COST=12.50
< K DONE_BY=Me
< .
> MAINT SET 1 MTYPE=xx
< -ERR 102 bad or missing argument FIELD=MTYPE
> MAINT SET 1 MTYPE=
< -ERR 102 value required FIELD=MTYPE
> MAINT SET 1 SUMMARY=
< -ERR 102 value required FIELD=SUMMARY
> MAINT SET 1 NOTES=a DETAIL=b
< -ERR 102 bad or missing argument FIELD=NOTES
> MAINT SET 1 MAINT_ID=7
< -ERR 102 field not settable FIELD=MAINT_ID
> MAINT SET 1 ITEM_ID=2
< -ERR 102 field not settable FIELD=ITEM_ID
> MAINT SET 1 COST=1234567.00
< -ERR 102 bad value FIELD=COST
> MAINT SET 9 SUMMARY=x
< -ERR 200 not found FIELD=ID
> MAINT SET x SUMMARY=x
< -ERR 102 bad ID FIELD=ID
> MAINT SET
< -ERR 102 missing argument FIELD=ID
> MAINT SET 1 2 SUMMARY=x
< -ERR 100 too many arguments
> MAINT SET 1 FOO=1
< -ERR 102 field not settable FIELD=FOO
> MAINT SET 1 SUMMARY=1234567890123456789012345678901234567890123456789012345678901
< -ERR 102 value too long FIELD=SUMMARY
> MAINT SET 1
< +OK
> MAINT SET 1 MDATE=
< +OK
> MAINT GET 1
< +DATA
< K MAINT_ID=1
< K ITEM_ID=1
< K MDATE=""
<*

# MAINT NOTES, and NOTES= on SET replacing the memo.
> MAINT SET 1 NOTES="Replaced C1\nand C2"
< +OK
> MAINT NOTES 1
< +DATA
< L Replaced C1
< L and C2
< .
> MAINT NOTES 1 ADD="Tested OK"
< +OK
> MAINT NOTES 1
< +DATA
< L Replaced C1
< L and C2
< L Tested OK
< .
> MAINT SET 1 DETAIL=
< +OK
> MAINT NOTES 1
< +DATA
< .
> MAINT NOTES 1 NEW=staged
< +OK
> MAINT NOTES 1
< +DATA
< .
> MAINT NOTES 1 END=whole
< +OK
> MAINT NOTES 1
< +DATA
< L staged
< L whole
< .
> MAINT NOTES 1 PART=x
< -ERR 204 no note being saved FIELD=NOTES
> MAINT NOTES 1 FOO=1
< -ERR 102 unexpected key FIELD=FOO
> MAINT NOTES 1 ADD=x FOO=1
< -ERR 102 unexpected key FIELD=FOO
> MAINT NOTES 1 ADD="a\x0Db"
< -ERR 102 bad memo text FIELD=NOTES
# The memo holds at most ENG_MAXMEMO bytes: nine lines of 200 and the
# CR LF between them leave room for one of 182 more, then none.
> MAINT NOTES 5 ADD="01234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
< +OK
