> MAINT NOTES 9
< -ERR 200 not found FIELD=ID
> MAINT NOTES 9 ADD=x
< -ERR 200 not found FIELD=ID
> MAINT NOTES 0
< -ERR 102 bad ID FIELD=ID
> MAINT NOTES
< -ERR 102 missing argument FIELD=ID
> MAINT NOTES 1 2
< -ERR 100 too many arguments

# MAINT DEL: the record is gone for every command and both lists.
> MAINT DEL 4
< +OK
> MAINT DEL 4
< -ERR 200 not found FIELD=ID
> MAINT GET 4
< -ERR 200 not found FIELD=ID
> MAINT SET 4 SUMMARY=x
< -ERR 200 not found FIELD=ID
> MAINT NOTES 4
< -ERR 200 not found FIELD=ID
> MAINT DEL 9
< -ERR 200 not found FIELD=ID
> MAINT DEL 1 COST=1
< -ERR 102 unexpected key FIELD=COST
> MAINT DEL x
< -ERR 102 bad ID FIELD=ID
> MAINT DEL 0
< -ERR 102 bad ID FIELD=ID
> MAINT DEL
< -ERR 102 missing argument FIELD=ID
> MAINT DEL 1 2
< -ERR 100 too many arguments
> MAINT LIST 1 FIELDS=MAINT_ID,MDATE
< +DATA
< F MAINT_ID MDATE
< R 1 ""
< R 2 20200101
< R 5 20230505
< .
> MAINT RECENT PAGE=2 FIELDS=MAINT_ID AFTER=MAINT::5
< +DATA
< F MAINT_ID
< R 3
< R 2
< C MAINT::2
< .

# The records of a deleted item: ADD and LIST refuse the item, the
# record commands and RECENT still reach its records.
> ITEM DEL 2
< +OK
> MAINT ADD 2 MTYPE=RP SUMMARY=x
< -ERR 200 no such item FIELD=ITEM
> MAINT LIST 2
< -ERR 200 no such item FIELD=ITEM
> MAINT GET 3
< +DATA
< K MAINT_ID=3
< K ITEM_ID=2
< K MDATE=""
< K MTYPE=IN
< K SUMMARY=Inspected
< K COST=""
< K DONE_BY=""
< .
> MAINT SET 3 COST=5
< +OK
> MAINT NOTES 3 ADD=after
< +OK
> MAINT NOTES 3
< +DATA
< L after
< .
> MAINT RECENT FIELDS=MAINT_ID,ITEM_ID,COST
< +DATA
< F MAINT_ID ITEM_ID COST
< R 5 1 0.00
< R 3 2 5.00
< R 2 1 ""
< R 1 1 12.50
< .
> MAINT DEL 3
< +OK
> ITEM UNDEL 2
< +OK
> MAINT LIST 2
< +DATA
< F MAINT_ID ITEM_ID MDATE MTYPE SUMMARY COST
< .

# A new record after deletions gets the next ID.
> MAINT ADD 2 MTYPE=RC SUMMARY=Recapped
< +OK ID=6
> MAINT RECENT PAGE=1 FIELDS=MAINT_ID,ITEM_ID,MTYPE
< +DATA
< F MAINT_ID ITEM_ID MTYPE
< R 6 2 RC
< C MAINT::6
< .
> STATUS
< +DATA
< K ITEMS=2
< K LOCS=0
< K CATS=10
< K LTYPES=8
< K MAINT=6
< K LOANS=0
<*

# The audit rows: MAINT ADD one I row, MAINT SET, the ADD= form of
# MAINT NOTES and a staged memo's END= a U row per changed field (none
# for a SET that changes nothing, nor for NEW=), MAINT DEL one D row; a
# refused command writes none.
@TABLE AUDIT FIELDS=USERNAME,TBL,REC_ID,ACTION,FLD
< F USERNAME TBL REC_ID ACTION FLD
< R SYSTEM CATS 1 I CAT_CODE
< R SYSTEM CATS 2 I CAT_CODE
< R SYSTEM CATS 3 I CAT_CODE
< R SYSTEM CATS 4 I CAT_CODE
< R SYSTEM CATS 5 I CAT_CODE
< R SYSTEM CATS 6 I CAT_CODE
< R SYSTEM CATS 7 I CAT_CODE
< R SYSTEM CATS 8 I CAT_CODE
< R SYSTEM CATS 9 I CAT_CODE
< R SYSTEM CATS 10 I CAT_CODE
< R SYSTEM LTYPES 1 I LT_CODE
< R SYSTEM LTYPES 2 I LT_CODE
< R SYSTEM LTYPES 3 I LT_CODE
< R SYSTEM LTYPES 4 I LT_CODE
< R SYSTEM LTYPES 5 I LT_CODE
< R SYSTEM LTYPES 6 I LT_CODE
< R SYSTEM LTYPES 7 I LT_CODE
< R SYSTEM LTYPES 8 I LT_CODE
< R SYSTEM USERS 1 I USER_ID
< R ADMIN USERS 1 L ""
< R ADMIN USERS 1 W PWHASH
< R ADMIN ITEMS 1 I ITEM_ID
< R ADMIN ITEMS 2 I ITEM_ID
< R ADMIN MAINT 1 I MAINT_ID
< R ADMIN MAINT 2 I MAINT_ID
< R ADMIN MAINT 3 I MAINT_ID
< R ADMIN MAINT 4 I MAINT_ID
< R ADMIN MAINT 5 I MAINT_ID
< R ADMIN MAINT 1 U MTYPE
< R ADMIN MAINT 1 U SUMMARY
< R ADMIN MAINT 1 U DONE_BY
< R ADMIN MAINT 1 U MDATE
< R ADMIN MAINT 1 U DETAIL
< R ADMIN MAINT 1 U DETAIL
< R ADMIN MAINT 1 U DETAIL
< R ADMIN MAINT 1 U DETAIL
< R ADMIN MAINT 5 U DETAIL
< R ADMIN MAINT 5 U DETAIL
< R ADMIN MAINT 5 U DETAIL
< R ADMIN MAINT 5 U DETAIL
< R ADMIN MAINT 5 U DETAIL
< R ADMIN MAINT 5 U DETAIL
< R ADMIN MAINT 5 U DETAIL
< R ADMIN MAINT 5 U DETAIL
< R ADMIN MAINT 5 U DETAIL
< R ADMIN MAINT 5 U DETAIL
< R ADMIN MAINT 4 D ""
< R ADMIN ITEMS 2 D ""
< R ADMIN MAINT 3 U COST
< R ADMIN MAINT 3 U DETAIL
< R ADMIN MAINT 3 D ""
< R ADMIN ITEMS 2 D ""
< R ADMIN MAINT 6 I MAINT_ID
