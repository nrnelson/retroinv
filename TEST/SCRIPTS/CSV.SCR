# CSV.SCR - EXPORT and IMPORT: the files they write and read beside
# the data (named through $D), table and path checks, flags, paging of
# an export through its scratch file, REPLACE, the file-exists and
# no-export-in-progress errors, the exports of two sessions at once;
# imports by position and by header, read-only columns ignored,
# refused lines reported with nothing added, the count of refusals
# beyond those listed, the location rules (codes and names unique, a
# parent on an earlier line, the depth limit), the exclusive rule, the
# audit rows; an export imported back; the answers of a disk failure
# while adding and after refused lines.  The clock is 2026-10-08.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK

# An empty table: the file holds only the Ctrl-Z that ends it.
> EXPORT MAINT FILE=$DEMPTY.CSV
< +DATA
< K ROWS=0
< .
@FILE $DEMPTY.CSV
< \x1A
@FILE $DNONE.CSV
< (no file)

# AUDIT before any import, whose K row names the file's path, which
# differs between systems.
> EXPORT AUDIT FILE=$DAUDIT.CSV
< +DATA
< K ROWS=21
< .
@FILE $DAUDIT.CSV
< 1,20261008,"12:00:00","SYSTEM","SYSTEM","CATS",1,"I","CAT_CODE","","SYS"
< 2,20261008,"12:00:00","SYSTEM","SYSTEM","CATS",2,"I","CAT_CODE","","MOBO"
< 3,20261008,"12:00:00","SYSTEM","SYSTEM","CATS",3,"I","CAT_CODE","","CPU"
< 4,20261008,"12:00:00","SYSTEM","SYSTEM","CATS",4,"I","CAT_CODE","","CARD"
< 5,20261008,"12:00:00","SYSTEM","SYSTEM","CATS",5,"I","CAT_CODE","","DRV"
< 6,20261008,"12:00:00","SYSTEM","SYSTEM","CATS",6,"I","CAT_CODE","","PERI"
< 7,20261008,"12:00:00","SYSTEM","SYSTEM","CATS",7,"I","CAT_CODE","","SW"
< 8,20261008,"12:00:00","SYSTEM","SYSTEM","CATS",8,"I","CAT_CODE","","MAN"
< 9,20261008,"12:00:00","SYSTEM","SYSTEM","CATS",9,"I","CAT_CODE","","CBL"
< 10,20261008,"12:00:00","SYSTEM","SYSTEM","CATS",10,"I","CAT_CODE","","PART"
< 11,20261008,"12:00:00","SYSTEM","SYSTEM","LTYPES",1,"I","LT_CODE","","ROOM"
< 12,20261008,"12:00:00","SYSTEM","SYSTEM","LTYPES",2,"I","LT_CODE","","SHELF"
< 13,20261008,"12:00:00","SYSTEM","SYSTEM","LTYPES",3,"I","LT_CODE","","RACK"
< 14,20261008,"12:00:00","SYSTEM","SYSTEM","LTYPES",4,"I","LT_CODE","","CABINET"
< 15,20261008,"12:00:00","SYSTEM","SYSTEM","LTYPES",5,"I","LT_CODE","","DRAWER"
< 16,20261008,"12:00:00","SYSTEM","SYSTEM","LTYPES",6,"I","LT_CODE","","BOX"
< 17,20261008,"12:00:00","SYSTEM","SYSTEM","LTYPES",7,"I","LT_CODE","","BIN"
< 18,20261008,"12:00:00","SYSTEM","SYSTEM","LTYPES",8,"I","LT_CODE","","BUCKET"
< 19,20261008,"12:00:00","SYSTEM","SYSTEM","USERS",1,"I","USER_ID","","1"
< 20,20261008,"12:00:00","CONSOLE","ADMIN","USERS",1,"L","","",""
< 21,20261008,"12:00:00","CONSOLE","ADMIN","USERS",1,"W","PWHASH","",""
< \x1A

# IMPORT ITEMS by position: ITEM_ID (read-only) is ignored, an empty
# value takes the default of ITEM ADD, a line may stop early, blank
# lines are skipped and a Ctrl-Z ends the file.  WORKS is stored upper
# case.  One K row names the import, then each record has its I row.
@WRITE $DIN.CSV
= 77,"CPU","","Intel","8088",,"  spaced",,,4
=
= ,MAN,,"IBM","Tech ""Ref""","6025005","a, b, c",GD,y,1,0,,,,,0,19850101,"shop",12.5
= \x20\x20\x20
= ,CBL,,Bel\\kin
= \x1A
= ,CPU,,never
> IMPORT ITEMS FILE=$DIN.CSV
< +OK ADDED=3
@TABLE ITEMS FIELDS=ITEM_ID,CATEGORY,MFR,MODEL,SERIALNO,DESCR,COND,WORKS,QTY,ON_LOAN,LOC_ID,PARENT_ID,ACQ_DATE,ACQ_SRC,ACQ_PRICE,STATUS,CREATED
< F ITEM_ID CATEGORY MFR MODEL SERIALNO DESCR COND WORKS QTY ON_LOAN LOC_ID PARENT_ID ACQ_DATE ACQ_SRC ACQ_PRICE STATUS CREATED
< R 1 CPU Intel 8088 "" "  spaced" "" ? 4 0 0 0 "" "" "" A 20261008
< R 2 MAN IBM "Tech \"Ref\"" 6025005 "a, b, c" GD Y 1 0 0 0 19850101 shop 12.50 A 20261008
< R 3 CBL "Bel\\kin" "" "" "" "" ? 1 0 0 0 "" "" "" A 20261008
@TABLE AUDIT FIELDS=AUD_ID,USERNAME,TBL,REC_ID,ACTION,FLD
< F AUD_ID USERNAME TBL REC_ID ACTION FLD
< R 1 SYSTEM CATS 1 I CAT_CODE
< R 2 SYSTEM CATS 2 I CAT_CODE
< R 3 SYSTEM CATS 3 I CAT_CODE
< R 4 SYSTEM CATS 4 I CAT_CODE
< R 5 SYSTEM CATS 5 I CAT_CODE
< R 6 SYSTEM CATS 6 I CAT_CODE
< R 7 SYSTEM CATS 7 I CAT_CODE
< R 8 SYSTEM CATS 8 I CAT_CODE
< R 9 SYSTEM CATS 9 I CAT_CODE
< R 10 SYSTEM CATS 10 I CAT_CODE
< R 11 SYSTEM LTYPES 1 I LT_CODE
< R 12 SYSTEM LTYPES 2 I LT_CODE
< R 13 SYSTEM LTYPES 3 I LT_CODE
< R 14 SYSTEM LTYPES 4 I LT_CODE
< R 15 SYSTEM LTYPES 5 I LT_CODE
< R 16 SYSTEM LTYPES 6 I LT_CODE
< R 17 SYSTEM LTYPES 7 I LT_CODE
< R 18 SYSTEM LTYPES 8 I LT_CODE
< R 19 SYSTEM USERS 1 I USER_ID
< R 20 ADMIN USERS 1 L ""
< R 21 ADMIN USERS 1 W PWHASH
< R 22 ADMIN ITEMS 0 K IMPORT
< R 23 ADMIN ITEMS 1 I ITEM_ID
< R 24 ADMIN ITEMS 2 I ITEM_ID
< R 25 ADMIN ITEMS 3 I ITEM_ID

# Argument errors: the table, the path, the flags, other keys and
# positional arguments.
> EXPORT
< -ERR 102 missing argument FIELD=TABLE
> EXPORT USERS FILE=$DX.CSV
< -ERR 102 table not allowed FIELD=TABLE
> EXPORT SEQ FILE=$DX.CSV
< -ERR 102 table not allowed FIELD=TABLE
> EXPORT FOO FILE=$DX.CSV
< -ERR 102 table not allowed FIELD=TABLE
> EXPORT ITEMS
< -ERR 102 bad file name FIELD=FILE
> EXPORT ITEMS FILE=
< -ERR 102 bad file name FIELD=FILE
> EXPORT ITEMS FILE=$DX.DBF
< -ERR 102 bad file name FIELD=FILE
> EXPORT ITEMS FILE=$DX.&C0
< -ERR 102 bad file name FIELD=FILE
> EXPORT ITEMS FILE=$D
< -ERR 102 bad file name FIELD=FILE
> EXPORT ITEMS FILE="A B.CSV"
< -ERR 102 bad file name FIELD=FILE
> EXPORT ITEMS FILE=$DX.CSV HEADER=2
< -ERR 102 bad or missing argument FIELD=HEADER
> EXPORT ITEMS FILE=$DX.CSV HEADER= REPLACE=yes
< -ERR 102 bad or missing argument FIELD=REPLACE
> EXPORT ITEMS FILE=$DX.CSV REPLACE=yes
< -ERR 102 bad or missing argument FIELD=REPLACE
> EXPORT ITEMS FILE=$DX.CSV PAGE=5
< -ERR 102 unexpected key FIELD=PAGE
> EXPORT ITEMS $DX.CSV
< -ERR 100 too many arguments
> EXPORT ITEMS EXTRA FILE=$DX.CSV
< -ERR 100 too many arguments
# DOS device names, in any directory and with any extension, and
# extensions that DOS cuts to those of data files.
> EXPORT ITEMS FILE=$DNUL.CSV
< -ERR 102 bad file name FIELD=FILE
> EXPORT ITEMS FILE=PRN
< -ERR 102 bad file name FIELD=FILE
> EXPORT ITEMS FILE=$Dcon
< -ERR 102 bad file name FIELD=FILE
> EXPORT ITEMS FILE=$DITEMS.DBFX
< -ERR 102 bad file name FIELD=FILE
> IMPORT ITEMS FILE=$DAUX.CSV
< -ERR 102 bad file name FIELD=FILE
> IMPORT LOCS FILE=$DLOCS.NDXA
< -ERR 102 bad file name FIELD=FILE
@FILE $DX.CSV
< (no file)

# No export of that name in progress: a continuation is refused.
> EXPORT ITEMS FILE=$DX.CSV AFTER=ITEMS::5
< -ERR 204 no export in progress

> LOC ADD LOC_NAME="Shelf A, top" LTYPE=BIN LOC_CODE=A1 CAPACITY=12
< +OK ID=1
> LOC ADD LOC_NAME=B2 LTYPE=BIN LOC_CODE=B2
< +OK ID=2
> LOC ADD LOC_NAME="  indented" LTYPE=BIN LOC_CODE=C3
< +OK ID=3
> ITEM ADD CATEGORY=SYS MFR=IBM MODEL=5150 SERIALNO=0012345 COND=GD LOC_ID=B2 ACQ_DATE=19840312 ACQ_PRICE=450 CUR_VALUE=1200.5 NOTES="never exported"
< +OK ID=4
> ITEM ADD CATEGORY=CARD MFR="M\x81ller" MODEL="  XT" DESCR="a, b" QTY=2 LOC_ID=A1 TAGS=isa
< +OK ID=5
> ITEM ADD CATEGORY=SYS MFR=Compaq MODEL="Portable \"Plus\"" ACQ_PRICE=0.99
< +OK ID=6
> ITEM ADD CATEGORY=CPU MFR=AMD MODEL=8086
< +OK ID=7
> ITEM DEL 7
< +OK
> MAINT ADD 1 MTYPE=CL SUMMARY="cleaned, \"tested\""
< +OK ID=1
> LOAN OUT 2 HOLDER="Jane Smith" CONTACT=555-0101 DUE=20261020
< +OK ID=1

# Every exportable table, the deleted item 7 left out; memo fields are
# never written.
> EXPORT ITEMS FILE=$DITEMS.CSV
< +DATA
< K ROWS=6
< .
@FILE $DITEMS.CSV
< 1,"CPU","","Intel","8088","","  spaced","","?",4,0,0,0,0,0,0,,"",,,"","A",20261008,20261008
< 2,"MAN","","IBM","Tech ""Ref""","6025005","a, b, c","GD","Y",1,1,0,0,0,0,0,19850101,"shop",12.50,,"","A",20261008,20261008
< 3,"CBL","","Bel\\kin","","","","","?",1,0,0,0,0,0,0,,"",,,"","A",20261008,20261008
