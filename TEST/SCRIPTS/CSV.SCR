> EXPORT LOCS FILE=$DLOCS.CSV
< +DATA
< K ROWS=3
< .
@FILE $DLOCS.CSV
< 1,0,"Shelf A, top","A1","BIN",12
< 2,0,"B2","B2","BIN",
< 3,0,"  indented","C3","BIN",
