# A stopped export leaves its scratch file, which the next first
# request replaces; a continuation needs the same path, and its
# scratch file, whose extension ends in the tag 0 of local mode.
> EXPORT LOCS FILE=$DSTOP.CSV
< +DATA
< K ROWS=48
< C LOCS::32
< .
@FILE $DSTOP.CSV
< (no file)
@REMOVE $DSTOP.&C0
> EXPORT LOCS FILE=$DSTOP.CSV AFTER=LOCS::32
< -ERR 204 no export in progress
> EXPORT LOCS FILE=$DOTHER.CSV AFTER=LOCS::32
< -ERR 204 no export in progress
> EXPORT LOCS FILE=$DSTOP.CSV
< +DATA
< K ROWS=48
< C LOCS::32
< .
> EXPORT LOCS FILE=$DSTOP.CSV AFTER=LOCS::32
< +DATA
< K ROWS=5
< .
@FILE $DSTOP.&C0
< (no file)

# Two sessions export at once to paths that differ only in their
# extension.  Each request gives its session's slot as the export's tag
# (3 for the second of three sessions under @PEERS 3 SELF=2, 0 in local
# mode), which the scratch file's name ends in, so the two never share
# one; a continuation from the other session finds no scratch file.
@PEERS 3 SELF=2
> EXPORT LOCS FILE=$DTWO.CSV HEADER=1
< +DATA
< K ROWS=48
< C LOCS::32
< .
@PEERS 0
> EXPORT LOCS FILE=$DTWO.CSV HEADER=1 AFTER=LOCS::32
< -ERR 204 no export in progress
> EXPORT LOCS FILE=$DTWO.TXT
< +DATA
< K ROWS=48
< C LOCS::32
< .
@PEERS 3 SELF=2
> EXPORT LOCS FILE=$DTWO.CSV HEADER=1 AFTER=LOCS::32
< +DATA
< K ROWS=5
< .
@PEERS 0
> EXPORT LOCS FILE=$DTWO.TXT AFTER=LOCS::32
< +DATA
< K ROWS=5
< .
@FILE $DTWO.CSV
< LOC_ID,PARENT_ID,LOC_NAME,LOC_CODE,LTYPE,CAPACITY
< 1,0,"Shelf A, top","A1","BIN",12
< 2,0,"B2","B2","BIN",
