# An export examines ENG_EXPROWS records per request (deleted ones
# counted) and writes the scratch file; the target appears only when
# the last request renames it.  The cursor LOCS::32 names record
# ENG_EXPROWS, in hex.
> EXPORT LOCS FILE=$DPAGE.CSV
< +DATA
< K ROWS=48
< C LOCS::32
< .
@FILE $DPAGE.CSV
< (no file)
> EXPORT LOCS FILE=$DPAGE.CSV AFTER=LOCS::32
< +DATA
< K ROWS=5
< .
@FILE $DPAGE.&C0
< (no file)
@FILE $DPAGE.CSV
< 1,0,"Shelf A, top","A1","BIN",12
