# A failure while adding: the disk is full at the file call @FAULT
# counts to, after one record.  The records added before it stay,
# flushed by the end of the batch, as the next open shows.  The count
# follows the engine's writes and is pinned here.
@WRITE $DIN.CSV
= ,CPU,,Intel,80286
= ,CPU,,Intel,80386
= ,CPU,,Intel,80486
@FAULT 27
> IMPORT ITEMS FILE=$DIN.CSV
< +DATA
< K ADDED=1
< K ERROR=302
< .
@FAULT 0
@REOPEN
@TABLE ITEMS FIELDS=ITEM_ID,MODEL
