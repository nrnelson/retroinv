< \x1A

# Two exports to one path: the first to end puts its file there, and
# the second's last request finds it.
@PEERS 3 SELF=2
> EXPORT LOCS FILE=$DSAME.CSV
< +DATA
< K ROWS=48
< C LOCS::32
< .
@PEERS 0
> EXPORT LOCS FILE=$DSAME.CSV
< +DATA
< K ROWS=48
< C LOCS::32
< .
@PEERS 3 SELF=2
> EXPORT LOCS FILE=$DSAME.CSV AFTER=LOCS::32
< +DATA
< K ROWS=5
< .
@PEERS 0
> EXPORT LOCS FILE=$DSAME.CSV AFTER=LOCS::32
< -ERR 201 file already exists FIELD=FILE

# The tag is the slot of the script's session, 3 under @PEERS 3
# SELF=2: without the scratch file whose extension ends in 3 the
# continuation finds none.
@PEERS 3 SELF=2
> EXPORT LOCS FILE=$DSTOP.CSV REPLACE=1
< +DATA
< K ROWS=48
< C LOCS::32
< .
@REMOVE $DSTOP.&C3
> EXPORT LOCS FILE=$DSTOP.CSV REPLACE=1 AFTER=LOCS::32
< -ERR 204 no export in progress
@PEERS 0

# IMPORT: argument errors, a missing file, and the exclusive rule.
> IMPORT
< -ERR 102 missing argument FIELD=TABLE
> IMPORT CATS FILE=$DIN.CSV
< -ERR 102 table not allowed FIELD=TABLE
> IMPORT LTYPES FILE=$DIN.CSV
< -ERR 102 table not allowed FIELD=TABLE
> IMPORT MAINT FILE=$DIN.CSV
< -ERR 102 table not allowed FIELD=TABLE
> IMPORT AUDIT FILE=$DIN.CSV
< -ERR 102 table not allowed FIELD=TABLE
> IMPORT ITEMS
< -ERR 102 bad file name FIELD=FILE
> IMPORT ITEMS FILE=$DIN.NDX
< -ERR 102 bad file name FIELD=FILE
> IMPORT ITEMS FILE=$DIN.CSV REPLACE=1
< -ERR 102 unexpected key FIELD=REPLACE
> IMPORT ITEMS FILE=$DIN.CSV AFTER=x
< -ERR 102 unexpected key FIELD=AFTER
> IMPORT ITEMS FILE=$DIN.CSV HEADER=x
< -ERR 102 bad or missing argument FIELD=HEADER
> IMPORT ITEMS $DIN.CSV
< -ERR 100 too many arguments
> IMPORT ITEMS FILE=$DNONE.CSV
< -ERR 200 file not found FIELD=FILE
@OTHERS 2
> IMPORT ITEMS FILE=$DNONE.CSV
< -ERR 402 server busy
> EXPORT ITEMS FILE=$DX.CSV REPLACE=1
< +DATA
< K ROWS=6
< .
@REMOVE $DX.CSV
@OTHERS 0

# By header: names in any case and any order, ON_LOAN (read-only)
# ignored, fewer columns on a line.
@WRITE $DIN.CSV
= model,Mfr,CATEGORY,ON_LOAN,QTY
= "5160","IBM",SYS,3,2
= "PCjr","IBM",SYS
> IMPORT ITEMS FILE=$DIN.CSV HEADER=1
< +OK ADDED=2
@TABLE ITEMS FIELDS=ITEM_ID,CATEGORY,MODEL,QTY,ON_LOAN
< F ITEM_ID CATEGORY MODEL QTY ON_LOAN
< R 1 CPU 8088 4 0
< R 2 MAN "Tech \"Ref\"" 1 1
< R 3 CBL "" 1 0
< R 4 SYS 5150 1 0
< R 5 CARD "  XT" 2 0
< R 6 SYS "Portable \"Plus\"" 1 0
< D 7 CPU 8086 1 0
< R 8 SYS 5160 2 0
< R 9 SYS PCjr 1 0

# Refused lines: nothing is added, each refusal names its line (the
# header is line 1) and field, or LINE for the line as a whole.
@WRITE $DIN.CSV
= CATEGORY,MFR,COND,QTY,LOC_CODE
= CPU,ok
= XYZ,bad category
= CPU,"open quote
= CPU,"text" after
= CPU,bad cond,ZZ
= CPU,bad qty,GD,many
= CPU,no such bin,GD,1,Q9
= CPU,a,GD,1,A1,extra
= CPU,also ok
> IMPORT ITEMS FILE=$DIN.CSV HEADER=1
< +DATA
< F LINE FIELD CODE TEXT
< R 1 LOC_CODE 102 "unknown column"
< K ERRORS=1
< .
@TABLE ITEMS FIELDS=ITEM_ID
< F ITEM_ID
< R 1
< R 2
< R 3
< R 4
< R 5
< R 6
< D 7
< R 8
< R 9

# More refusals than are listed: all are counted.
@WRITE $DIN.CSV
= ,BAD0
= ,BAD1
= ,BAD2
= ,BAD3
= ,BAD4
= ,BAD5
= ,BAD6
= ,BAD7
= ,BAD8
= ,BAD9
= ,BAD10
= ,BAD11
> IMPORT ITEMS FILE=$DIN.CSV
< +DATA
< F LINE FIELD CODE TEXT
< R 1 CATEGORY 202 "unknown category"
< R 2 CATEGORY 202 "unknown category"
< R 3 CATEGORY 202 "unknown category"
< R 4 CATEGORY 202 "unknown category"
< R 5 CATEGORY 202 "unknown category"
< R 6 CATEGORY 202 "unknown category"
< R 7 CATEGORY 202 "unknown category"
< R 8 CATEGORY 202 "unknown category"
< R 9 CATEGORY 202 "unknown category"
< R 10 CATEGORY 202 "unknown category"
< K ERRORS=12
< .

# Header errors stop the check at line 1.
@WRITE $DIN.CSV
= MFR,COLOR
= IBM,red
> IMPORT ITEMS FILE=$DIN.CSV HEADER=1
< +DATA
< F LINE FIELD CODE TEXT
< R 1 COLOR 102 "unknown column"
< K ERRORS=1
< .
@WRITE $DIN.CSV
= MFR,mfr
> IMPORT ITEMS FILE=$DIN.CSV HEADER=1
< +DATA
< F LINE FIELD CODE TEXT
< R 1 MFR 102 "repeated column"
< K ERRORS=1
< .
@WRITE $DIN.CSV
= MFR,NOTES
> IMPORT ITEMS FILE=$DIN.CSV HEADER=1
< +DATA
< F LINE FIELD CODE TEXT
< R 1 NOTES 102 "unknown column"
< K ERRORS=1
< .

# Locations: a code already in the table or twice in the file, a name
# twice under one parent (a parent written by an earlier line, named by
# its code), a missing name, an unknown type or parent, and a chain one
# level deeper than ENG_MAXLOCDEPTH.
@WRITE $DIN.CSV
= LOC_CODE,LOC_NAME,LTYPE,PARENT_ID
= A1,again,BIN,
= Z1,Attic,ROOM,
= Z1,Loft,ROOM,
= ,Shelf,SHELF,Z1
= ,shelf,SHELF,Z1
= Z2,,BIN,
= Z3,Crate,CRATE,
= Z4,Box,BOX,Q9
= Z5,Fine,BIN,A1
= D1,D1,BOX,
= D2,D2,BOX,D1
= D3,D3,BOX,D2
= D4,D4,BOX,D3
= D5,D5,BOX,D4
= D6,D6,BOX,D5
= D7,D7,BOX,D6
= D8,D8,BOX,D7
= D9,D9,BOX,D8
> IMPORT LOCS FILE=$DIN.CSV HEADER=1
< +DATA
< F LINE FIELD CODE TEXT
< R 4 LOC_CODE 201 "duplicate in file"
< R 2 LOC_CODE 201 "location code already used"
< R 6 LOC_NAME 201 "duplicate in file"
< R 7 LOC_NAME 102 "value required"
< R 8 LTYPE 202 "unknown location type"
< R 9 PARENT_ID 202 "unknown location"
< R 19 PARENT_ID 202 "locations nested more than 8 levels deep"
< K ERRORS=7
< .
# The LOC_ID column numbers the lines of a file: a PARENT_ID that is a
# number names a line, 0 the top level, and a code a live location or a
# line's, so an export imports back with its tree.
@WRITE $DIN.CSV
= 7,0,"Attic",Z1,ROOM
= 8,7,"Shelf",Z2,SHELF,40
= 9,A1,"Box",,BOX
> IMPORT LOCS FILE=$DIN.CSV
< +OK ADDED=3
# The lines may come in any order: a child before its parent is
# accepted, two lines that are each other's parent are refused.
@WRITE $DIN.CSV
= 2,1,"Drawer",Y2,DRAWER
= 1,0,"Cabinet",Y1,CABINET
> IMPORT LOCS FILE=$DIN.CSV
< +OK ADDED=2
@WRITE $DIN.CSV
= 1,2,"Loop one",,BOX
= 2,1,"Loop two",,BOX
> IMPORT LOCS FILE=$DIN.CSV
< +DATA
< F LINE FIELD CODE TEXT
< R 1 PARENT_ID 202 "cannot be put inside itself or its contents"
< R 2 PARENT_ID 202 "cannot be put inside itself or its contents"
< K ERRORS=2
< .
@TABLE LOCS FIELDS=LOC_ID,PARENT_ID,LOC_NAME,LOC_CODE,LTYPE,CAPACITY
< F LOC_ID PARENT_ID LOC_NAME LOC_CODE LTYPE CAPACITY
< R 1 0 "Shelf A, top" A1 BIN 12
< R 2 0 B2 B2 BIN ""
< R 3 0 "  indented" C3 BIN ""
< R 4 0 "Shelf 1" L01 SHELF ""
