> EXPORT MAINT FILE=$DMAINT.CSV
< +DATA
< K ROWS=1
< .
@FILE $DMAINT.CSV
< 1,1,20261008,"CL","cleaned, ""tested""",,""
< \x1A
> EXPORT LOANS FILE=$DLOANS.CSV
< +DATA
< K ROWS=1
< .
@FILE $DLOANS.CSV
< 1,2,"L",1,"Jane Smith",0,"555-0101",20261008,20261020,,""
< \x1A

# The file already exists: refused without REPLACE=1, which writes it anew,
# here with the field names first.
> EXPORT ITEMS FILE=$DITEMS.CSV
< -ERR 201 file already exists FIELD=FILE
> EXPORT ITEMS FILE=$DITEMS.CSV HEADER=1 REPLACE=1
< +DATA
< K ROWS=6
< .
@FILE $DITEMS.CSV
< ITEM_ID,CATEGORY,ITEMTYPE,MFR,MODEL,SERIALNO,DESCR,COND,WORKS,QTY,ON_LOAN,RESERVED,IN_USE,ATTACHED,LOC_ID,PARENT_ID,ACQ_DATE,ACQ_SRC,ACQ_PRICE,CUR_VALUE,TAGS,STATUS,CREATED,UPDATED
< 1,"CPU","","Intel","8088","","  spaced","","?",4,0,0,0,0,0,0,,"",,,"","A",20261008,20261008
< 2,"MAN","","IBM","Tech ""Ref""","6025005","a, b, c","GD","Y",1,1,0,0,0,0,0,19850101,"shop",12.50,,"","A",20261008,20261008
< 3,"CBL","","Bel\\kin","","","","","?",1,0,0,0,0,0,0,,"",,,"","A",20261008,20261008
< 4,"SYS","","IBM","5150","0012345","","GD","?",1,0,0,0,0,2,0,19840312,"",450.00,1200.50,"","A",20261008,20261008
< 5,"CARD","","M\x81ller","  XT","","a, b","","?",2,0,0,0,0,1,0,,"",,,"isa","A",20261008,20261008
< 6,"SYS","","Compaq","Portable ""Plus""","","","","?",1,0,0,0,0,0,0,,"",0.99,,"","A",20261008,20261008
< \x1A
> EXPORT LOCS FILE=$DLOCS.CSV HEADER=1 REPLACE=0
< -ERR 201 file already exists FIELD=FILE
> EXPORT LOCS FILE=$DLOCS.CSV HEADER=0 REPLACE=1
< +DATA
< K ROWS=3
< .
@FILE $DLOCS.CSV
< 1,0,"Shelf A, top","A1","BIN",12
< 2,0,"B2","B2","BIN",
< 3,0,"  indented","C3","BIN",
