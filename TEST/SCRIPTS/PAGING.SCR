< +OK ID=30

# ORDER=ID in pages of 10, followed to the end: no C on the last page.
> ITEM LIST PAGE=10 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< R 2
< R 3
< R 4
< R 5
< R 6
< R 7
< R 8
< R 9
< R 10
< C ITEMS1:2020202020203130:A
