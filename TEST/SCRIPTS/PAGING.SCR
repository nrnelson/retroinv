# Hostile cursors are 204.
> ITEM LIST PAGE=1 FIELDS=ITEM_ID AFTER=
< +DATA
< F ITEM_ID
< R 1
< C ITEMS1:2020202020202031:1
< .
> ITEM LIST AFTER=garbage
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS1
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS1:
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS1::
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS1:20:0
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS1:20:123456789
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS1:202:1
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS1:2G:1
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS1:20:1G
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS1:20:-1
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS1:202020202020202020:1
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS1:20:1:1
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS2:20:1
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS9:20:1
< -ERR 204 bad cursor
> ITEM LIST AFTER=ITEMS:20:1
< -ERR 204 bad cursor
> ITEM LIST ORDER=MFR AFTER=ITEMS1:20:1
< -ERR 204 bad cursor
> ITEM LIST LOC=A1 AFTER=ITEMS2:2020202020202032:1
< -ERR 204 bad cursor
> LOC CONTENTS A1 AFTER=ITEMS2:2020202020202032:1
< -ERR 204 bad cursor
> LOC CONTENTS A1 AFTER=LOCS1:2020202020202031:1
< -ERR 204 bad cursor
> ITEM SERIAL S1 AFTER=ITEMS5:5332:1
< -ERR 204 bad cursor
> ITEM FIND maker AFTER=ITEMS1:20:1
< -ERR 204 bad cursor
> ITEM FIND maker AFTER=ITEMS::1
< +DATA
< F ITEM_ID CATEGORY MFR MODEL WORKS QTY AVAIL LOC_ID LOC_NAME STATUS
< R 2 CARD MAKER4 M02 ? 1 Y 1 A1 A
< R 3 SYS MAKER1 M03 ? 1 Y 1 A1 A
< R 4 CARD MAKER3 M04 ? 1 Y 1 A1 A
< R 5 SYS MAKER0 M05 ? 1 Y 1 A1 A
< R 6 CARD MAKER2 M06 ? 1 Y 1 A1 A
< R 7 SYS MAKER4 M07 ? 1 Y 1 A1 A
< R 8 CARD MAKER1 M08 ? 1 Y 1 A1 A
< R 9 SYS MAKER3 M09 ? 1 Y 1 A1 A
< R 10 CARD MAKER0 M10 ? 1 Y 1 A1 A
< R 11 SYS MAKER2 M11 ? 1 Y 1 A1 A
< R 12 CARD MAKER4 M12 ? 1 Y 1 A1 A
< R 13 SYS MAKER1 M13 ? 1 Y 2 B2 A
< R 14 CARD MAKER3 M14 ? 1 Y 2 B2 A
< R 15 SYS MAKER0 M15 ? 1 Y 2 B2 A
< R 16 CARD MAKER2 M16 ? 1 Y 2 B2 A
< R 17 SYS MAKER4 M17 ? 1 Y 2 B2 A
< R 18 CARD MAKER1 M18 ? 1 Y 2 B2 A
< R 19 SYS MAKER3 M19 ? 1 Y 2 B2 A
< R 20 CARD MAKER0 M20 ? 1 Y 2 B2 A
< R 21 SYS MAKER2 M21 ? 1 Y 2 B2 A
< C ITEMS::15
< .
> LOC LIST AFTER=ITEMS1:20:1
< -ERR 204 bad cursor
> USER LIST AFTER=LOCS1:41:1
< -ERR 204 bad cursor
> ITEM LIST AFTER="ITEMS1:20 :1"
< -ERR 204 bad cursor

# Cursors are case-insensitive and accept leading zeros; one past the
# last entry gives an empty page; a cursor need not name a real record.
> ITEM LIST PAGE=2 FIELDS=ITEM_ID AFTER=items1:2020202020202031:01
< +DATA
< F ITEM_ID
< R 2
< R 3
< C ITEMS1:2020202020202033:3
< .
> ITEM LIST PAGE=2 FIELDS=ITEM_ID AFTER=ITEMS1:2020202020203330:0000001E
< +DATA
< F ITEM_ID
< .
> ITEM LIST PAGE=2 FIELDS=ITEM_ID AFTER=ITEMS1:2020202020203939:FFFFFFFF
< +DATA
< F ITEM_ID
< .
> ITEM LIST PAGE=2 FIELDS=ITEM_ID AFTER=ITEMS1:2020202020202035:3
< +DATA
< F ITEM_ID
< R 5
< R 6
< C ITEMS1:2020202020202036:6
< .
> ITEM LIST PAGE=2 FIELDS=ITEM_ID AFTER=ITEMS1::1
< +DATA
< F ITEM_ID
< R 1
< R 2
< C ITEMS1:2020202020202032:2
< .
> ITEM FIND maker PAGE=2 FIELDS=ITEM_ID AFTER=items::1C
< +DATA
< F ITEM_ID
< R 29
< R 30
< .

# Deleted entries keep their index entries: they are skipped, so a page
# may end empty, and a C line is sent while such entries remain.
> ITEM DEL 29
< +OK
> ITEM DEL 30
< +OK
> ITEM LIST PAGE=1 FIELDS=ITEM_ID AFTER=ITEMS1:2020202020203236:1A
< +DATA
< F ITEM_ID
< R 27
< C ITEMS1:2020202020203237:1B
< .
> ITEM LIST PAGE=1 FIELDS=ITEM_ID AFTER=ITEMS1:2020202020203237:1B
< +DATA
< F ITEM_ID
< R 28
< C ITEMS1:2020202020203238:1C
< .
> ITEM LIST PAGE=1 FIELDS=ITEM_ID AFTER=ITEMS1:2020202020203238:1C
< +DATA
< F ITEM_ID
< .

# A page stops early once the sink has less than PROTO_ROOMMIN bytes of
# room: with 691 bytes, "+DATA", the F line and three R lines (33 bytes)
# leave exactly PROTO_ROOMMIN and a fourth line follows; with 690 they
# leave one byte less.  The first entry is always examined.
@ROOM 691
> ITEM LIST PAGE=5 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< R 2
< R 3
< R 4
< C ITEMS1:2020202020202034:4
< .
@ROOM 690
> ITEM LIST PAGE=5 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< R 2
< R 3
< C ITEMS1:2020202020202033:3
< .
@ROOM 1
> ITEM LIST PAGE=5 FIELDS=ITEM_ID
< +DATA
< F ITEM_ID
< R 1
< C ITEMS1:2020202020202031:1
< .
@ROOM 0

# ENG_MAXREADS entries examined end a page even when none of them is
# returned: 200 more items, none of them a CPU, then one CPU, found by
# the request that continues from the first page's cursor.
@REPEAT 200
> ITEM ADD CATEGORY=SYS
< +OK ID=230
> ITEM ADD CATEGORY=CPU MFR=Intel MODEL=8088
< +OK ID=231
> ITEM LIST CAT=CPU FIELDS=ITEM_ID,CATEGORY
< +DATA
< F ITEM_ID CATEGORY
< C ITEMS1:2020202020323030:C8
< .
> ITEM LIST CAT=CPU FIELDS=ITEM_ID,CATEGORY AFTER=ITEMS1:2020202020323030:C8
< +DATA
< F ITEM_ID CATEGORY
< R 231 CPU
< .
