# Paging: PAGE= sizes, C cursors followed to the end in every order,
# filtered pages, the per-request read limit, a sink with little room,
# and hostile cursors.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK
> LOC ADD LOC_NAME=A1 LTYPE=BIN LOC_CODE=A1
< +OK ID=1
> LOC ADD LOC_NAME=B2 LTYPE=BIN LOC_CODE=B2
< +OK ID=2
> LOC ADD LOC_NAME=C3 LTYPE=BIN LOC_CODE=C3
< +OK ID=3
> ITEM ADD CATEGORY=SYS MFR=MAKER2 MODEL=M01 SERIALNO=S1 LOC_ID=A1
< +OK ID=1
> ITEM ADD CATEGORY=CARD MFR=MAKER4 MODEL=M02 SERIALNO=S2 LOC_ID=A1
< +OK ID=2
> ITEM ADD CATEGORY=SYS MFR=MAKER1 MODEL=M03 SERIALNO=S3 LOC_ID=A1
< +OK ID=3
> ITEM ADD CATEGORY=CARD MFR=MAKER3 MODEL=M04 SERIALNO=S0 LOC_ID=A1
< +OK ID=4
> ITEM ADD CATEGORY=SYS MFR=MAKER0 MODEL=M05 SERIALNO=S1 LOC_ID=A1
< +OK ID=5
