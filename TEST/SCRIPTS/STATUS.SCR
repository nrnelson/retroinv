# STATUS.SCR - STATUS: the record count of every table but SEQ, then
# the host's own K lines, cut with K TRUNCATED=1 where they would take
# the response past PROTO_MAXUNPAGED bytes; the host is told the room
# the sink reports, and that room does not shorten STATUS.
#
# The response is "+DATA" and eight count lines (96 bytes with their
# CR LF here), then the host's lines: "K HOSTROOM=r" when @ROOM limits
# the room, and "K HOSTLINE=i" lines of 14 bytes for i below 10, 15
# below 100 and 16 below 1000; then the "." terminator (3 bytes).  The
# host's lines pass only while the response, with "K TRUNCATED=1" (15
# bytes) and the terminator after them, stays within PROTO_MAXUNPAGED,
# whether or not a cut follows: 255 host lines are the most sent whole
# (4071 bytes), and 256 are cut to 255 and K TRUNCATED=1 (4086 bytes),
# although sent whole they would make 4087.

> HELLO CONSOLE
< +OK
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK
> ITEM ADD CATEGORY=SYS MFR=IBM MODEL=5150
< +OK ID=1

# Without host lines (local mode) only the counts are sent.
> STATUS
< +DATA
< K ITEMS=1
< K LOCS=0
< K CATS=10
< K LTYPES=8
< K MAINT=0
< K LOANS=0
< K AUDIT=22
< K USERS=1
< .

@STATUS 0
> STATUS
< +DATA
< K ITEMS=1
< K LOCS=0
< K CATS=10
< K LTYPES=8
< K MAINT=0
< K LOANS=0
< K AUDIT=22
< K USERS=1
< .

# The host's lines follow the counts in the order it writes them.
@STATUS 3
> STATUS
< +DATA
< K ITEMS=1
< K LOCS=0
< K CATS=10
< K LTYPES=8
< K MAINT=0
< K LOANS=0
< K AUDIT=22
< K USERS=1
< K HOSTLINE=1
< K HOSTLINE=2
< K HOSTLINE=3
< .

# The host is told the room left after the counts (200 - 96), or none
# when the counts already fill it; that room does not shorten STATUS.
@ROOM 200
> STATUS
< +DATA
< K ITEMS=1
< K LOCS=0
< K CATS=10
< K LTYPES=8
< K MAINT=0
< K LOANS=0
< K AUDIT=22
< K USERS=1
< K HOSTROOM=104
< K HOSTLINE=1
< K HOSTLINE=2
< K HOSTLINE=3
< .
@ROOM 40
> STATUS
< +DATA
< K ITEMS=1
< K LOCS=0
< K CATS=10
< K LTYPES=8
< K MAINT=0
< K LOANS=0
< K AUDIT=22
< K USERS=1
< K HOSTROOM=0
< K HOSTLINE=1
< K HOSTLINE=2
< K HOSTLINE=3
< .
@ROOM 0

