# Audit rows written by the USER, ITEM, LOC, CAT and LTYPE commands: one I
# row per new record, one U, M or P row per changed field (its values cut
# to ENG_AUDVAL characters; tags compared as stored), one D row per
# delete or undelete, MEMO for notes, W for passwords, L and F for
# logins, and the station and user of the session on each.  Failed
# commands write none.

# The rows written while the data directory was set up.
@TABLE AUDIT FIELDS=AUD_ID,ADATE,ATIME,STATION,USERNAME,TBL,REC_ID,ACTION,FLD,OLDVAL,NEWVAL
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< R 1 20261008 12:00:00 SYSTEM SYSTEM CATS 1 I CAT_CODE "" SYS
< R 2 20261008 12:00:00 SYSTEM SYSTEM CATS 2 I CAT_CODE "" MOBO
< R 3 20261008 12:00:00 SYSTEM SYSTEM CATS 3 I CAT_CODE "" CPU
< R 4 20261008 12:00:00 SYSTEM SYSTEM CATS 4 I CAT_CODE "" CARD
< R 5 20261008 12:00:00 SYSTEM SYSTEM CATS 5 I CAT_CODE "" DRV
< R 6 20261008 12:00:00 SYSTEM SYSTEM CATS 6 I CAT_CODE "" PERI
< R 7 20261008 12:00:00 SYSTEM SYSTEM CATS 7 I CAT_CODE "" SW
< R 8 20261008 12:00:00 SYSTEM SYSTEM CATS 8 I CAT_CODE "" MAN
< R 9 20261008 12:00:00 SYSTEM SYSTEM CATS 9 I CAT_CODE "" CBL
< R 10 20261008 12:00:00 SYSTEM SYSTEM CATS 10 I CAT_CODE "" PART
< R 11 20261008 12:00:00 SYSTEM SYSTEM LTYPES 1 I LT_CODE "" ROOM
< R 12 20261008 12:00:00 SYSTEM SYSTEM LTYPES 2 I LT_CODE "" SHELF
< R 13 20261008 12:00:00 SYSTEM SYSTEM LTYPES 3 I LT_CODE "" RACK
< R 14 20261008 12:00:00 SYSTEM SYSTEM LTYPES 4 I LT_CODE "" CABINET
< R 15 20261008 12:00:00 SYSTEM SYSTEM LTYPES 5 I LT_CODE "" DRAWER
< R 16 20261008 12:00:00 SYSTEM SYSTEM LTYPES 6 I LT_CODE "" BOX
< R 17 20261008 12:00:00 SYSTEM SYSTEM LTYPES 7 I LT_CODE "" BIN
< R 18 20261008 12:00:00 SYSTEM SYSTEM LTYPES 8 I LT_CODE "" BUCKET
< R 19 20261008 12:00:00 SYSTEM SYSTEM USERS 1 I USER_ID "" 1

@NOW 20261008 120501
> HELLO CONSOLE
< +OK
> LOGIN NOBODY xxxx
< -ERR 401 bad user name or password
> LOGIN ADMIN wrong
< -ERR 401 bad user name or password
> LOGIN ADMIN admin
< +OK LEVEL=3 MUSTCHG=1
> PASSWD admin secret1
< +OK
> PASSWD wrong secret2
< -ERR 401 wrong password

# Items.
@NOW 20261009 080000
> LOC ADD LOC_NAME=Shelf LTYPE=BIN LOC_CODE=A1
< +OK ID=1
> LOC ADD LOC_NAME=B2 LTYPE=BIN LOC_CODE=B2
< +OK ID=2
> ITEM ADD CATEGORY=SYS MFR=IBM DESCR="123456789012345678901234567890123456789012345678901234567890" LOC_ID=A1
< +OK ID=1
> ITEM SET 1 MFR=Compaq QTY=2 DESCR=short
< +OK
> ITEM SET 1 MFR=Compaq
< +OK
> ITEM SET 1 LOC_ID=B2
< +OK
> ITEM SET 1 COND=gd WORKS=n TAGS="Retro isa retro network modern abcdefghijkl,mnopqrstuvwx"
< +OK
> ITEM SET 1 TAGS="Retro, isa network,modern abcdefghijkl,mnopqrstuvwx"
< +OK
> ITEM SET 1 QTY=-1
< -ERR 102 negative value FIELD=QTY
> ITEM NOTES 1 ADD="a note"
< +OK
> ITEM SET 1 NOTES="replaced"
< +OK
> ITEM DEL 1
< +OK
> ITEM UNDEL 1
< +OK
> ITEM COPY 1
< +OK ID=2
> ITEM ADD CATEGORY=NONE
< -ERR 202 unknown category FIELD=CATEGORY
@TABLE AUDIT FIELDS=AUD_ID,ADATE,ATIME,STATION,USERNAME,TBL,REC_ID,ACTION,FLD,OLDVAL,NEWVAL
< F AUD_ID ADATE ATIME STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< R 1 20261008 12:00:00 SYSTEM SYSTEM CATS 1 I CAT_CODE "" SYS
< R 2 20261008 12:00:00 SYSTEM SYSTEM CATS 2 I CAT_CODE "" MOBO
< R 3 20261008 12:00:00 SYSTEM SYSTEM CATS 3 I CAT_CODE "" CPU
< R 4 20261008 12:00:00 SYSTEM SYSTEM CATS 4 I CAT_CODE "" CARD
< R 5 20261008 12:00:00 SYSTEM SYSTEM CATS 5 I CAT_CODE "" DRV
< R 6 20261008 12:00:00 SYSTEM SYSTEM CATS 6 I CAT_CODE "" PERI
< R 7 20261008 12:00:00 SYSTEM SYSTEM CATS 7 I CAT_CODE "" SW
< R 8 20261008 12:00:00 SYSTEM SYSTEM CATS 8 I CAT_CODE "" MAN
< R 9 20261008 12:00:00 SYSTEM SYSTEM CATS 9 I CAT_CODE "" CBL
< R 10 20261008 12:00:00 SYSTEM SYSTEM CATS 10 I CAT_CODE "" PART
< R 11 20261008 12:00:00 SYSTEM SYSTEM LTYPES 1 I LT_CODE "" ROOM
< R 12 20261008 12:00:00 SYSTEM SYSTEM LTYPES 2 I LT_CODE "" SHELF
< R 13 20261008 12:00:00 SYSTEM SYSTEM LTYPES 3 I LT_CODE "" RACK
< R 14 20261008 12:00:00 SYSTEM SYSTEM LTYPES 4 I LT_CODE "" CABINET
< R 15 20261008 12:00:00 SYSTEM SYSTEM LTYPES 5 I LT_CODE "" DRAWER
< R 16 20261008 12:00:00 SYSTEM SYSTEM LTYPES 6 I LT_CODE "" BOX
< R 17 20261008 12:00:00 SYSTEM SYSTEM LTYPES 7 I LT_CODE "" BIN
< R 18 20261008 12:00:00 SYSTEM SYSTEM LTYPES 8 I LT_CODE "" BUCKET
< R 19 20261008 12:00:00 SYSTEM SYSTEM USERS 1 I USER_ID "" 1
< R 20 20261008 12:05:01 CONSOLE "" USERS 0 F USERNAME "" ?
< R 21 20261008 12:05:01 CONSOLE "" USERS 1 F USERNAME "" ADMIN
< R 22 20261008 12:05:01 CONSOLE ADMIN USERS 1 L "" "" ""
< R 23 20261008 12:05:01 CONSOLE ADMIN USERS 1 W PWHASH "" ""
< R 24 20261009 08:00:00 CONSOLE ADMIN LOCS 1 I LOC_ID "" 1
< R 25 20261009 08:00:00 CONSOLE ADMIN LOCS 2 I LOC_ID "" 2
< R 26 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 I ITEM_ID "" 1
< R 27 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 U MFR IBM Compaq
< R 28 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 U DESCR 1234567890123456789012345678901234567890 short
< R 29 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 U QTY 1 2
< R 30 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 M LOC_ID 1 2
< R 31 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 U COND "" GD
< R 32 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 U WORKS ? N
< R 33 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 U TAGS "" Retro,isa,network,modern,abcdefghijkl,mn
< R 34 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 U NOTES "" MEMO
< R 35 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 U NOTES MEMO MEMO
< R 36 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 D "" "" DELETED
< R 37 20261009 08:00:00 CONSOLE ADMIN ITEMS 1 D "" DELETED ""
< R 38 20261009 08:00:00 CONSOLE ADMIN ITEMS 2 I ITEM_ID "" 2

# Locations: REC_ID is the LOC_ID, and a move is a U row of PARENT_ID.
# Categories and location types: REC_ID is the record number.
> LOC SET B2 LTYPE=SHELF CAPACITY=5
< +OK
> LOC SET B2 PARENT_ID=A1
< +OK
> LOC NOTES B2 ADD=x
< +OK
> ITEM SET 1 LOC_ID=A1
< +OK
> LOC DEL B2
< -ERR 202 location holds items: move or delete them
> CAT ADD TAPE CAT_NAME=Tapes
< +OK
> CAT SET TAPE SORTORD=7
< +OK
> CAT DEL TAPE
< +OK
> CAT ADD TAPE CAT_NAME=Again
< +OK
> LTYPE ADD TRAY LT_NAME=Tray
< +OK
> LTYPE SET TRAY SORTORD=9
< +OK
> LTYPE DEL TRAY
< +OK
@TABLE AUDIT FIELDS=STATION,USERNAME,TBL,REC_ID,ACTION,FLD,OLDVAL,NEWVAL
< F STATION USERNAME TBL REC_ID ACTION FLD OLDVAL NEWVAL
< R SYSTEM SYSTEM CATS 1 I CAT_CODE "" SYS
< R SYSTEM SYSTEM CATS 2 I CAT_CODE "" MOBO
< R SYSTEM SYSTEM CATS 3 I CAT_CODE "" CPU
< R SYSTEM SYSTEM CATS 4 I CAT_CODE "" CARD
< R SYSTEM SYSTEM CATS 5 I CAT_CODE "" DRV
