< R CONSOLE ADMIN LTYPES 9 U SORTORD 50 9
< R CONSOLE ADMIN LTYPES 9 D "" "" DELETED

# Users, from another station; the user name is recorded with each row.
@SESSION
> HELLO OFFICE
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=3 NAME="System Administrator"
> USER ADD BOB LEVEL=2 PASSWORD=bobpw1 FULLNAME=Bob
< +OK
> USER SET BOB LEVEL=1 GROUP=OPS STATUS=D
< +OK
> USER SET BOB STATUS=A
< +OK
> USER RESET BOB PASSWORD=bobpw2
< +OK
> USER ADD BOB LEVEL=2 PASSWORD=bobpw1
< -ERR 201 user already exists FIELD=USERNAME
@SESSION
> HELLO BOBPC
< +OK
> LOGIN BOB bobpw2
< +OK LEVEL=1 MUSTCHG=1
> PASSWD bobpw2 bobpw3
< +OK
> ITEM GET 1
< +DATA
< K ITEM_ID=1
< K CATEGORY=SYS
< K ITEMTYPE=""
< K MFR=Compaq
< K MODEL=""
< K SERIALNO=""
< K DESCR=short
< K COND=GD
< K WORKS=N
< K QTY=2
< K ON_LOAN=0
< K RESERVED=0
< K IN_USE=0
< K ATTACHED=0
< K LOC_ID=1
< K PARENT_ID=0
< K ACQ_DATE=""
< K ACQ_SRC=""
< K ACQ_PRICE=""
< K CUR_VALUE=""
< K TAGS=Retro,isa,network,modern,abcdefghijkl,mnopqrstuvwx
< K STATUS=A
< K CREATED=20261009
< K UPDATED=20261009
< .
> ITEM SET 1 MFR=X
< -ERR 203 permission denied
@SESSION
> HELLO OFFICE
< +OK
> LOGIN ADMIN secret1
< +OK LEVEL=3 NAME="System Administrator"
> USER DEL BOB
< +OK
