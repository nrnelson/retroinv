# Editing a password field: undo, copy and paste do nothing, and the
# caret goes where BS and DEL leave it.
T ADMIN
K TAB
T aRetro1986b
S E0
# undo restores nothing
K ALT-BS
S E1
# copy from the password, paste into the user name
K SHIFT-HOME CTRL-INS
K STAB END SHIFT-INS
S E2
# copy from the user name, paste into the password
K SHIFT-HOME CTRL-INS
K TAB END SHIFT-INS
S E3
# DEL before the first, DEL before the last, BS after the first
K HOME DEL
K END LEFT DEL
K HOME RIGHT BS
S E4
# the caret is at the start: the password is Retro1986 again
T R
S E5
K ENTER
S E6
K ALT-F X
