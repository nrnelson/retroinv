# Login dialog: empty fields only move the focus, a refusal keeps the
# user name, and a good login follows.
S L0
# both empty: nothing is sent
K ENTER
S L1
# a user name, no password: the focus goes to the password
T READER
K ENTER
S L2
# a wrong password: refused, the user name stays, the password is wiped
T nosuchpw9
K ENTER
S L3
# the user name cleared, a password typed: the focus goes to the user
K STAB BS BS BS BS BS BS BS
K TAB
T nosuchpw9
K ENTER
S L4
# an unknown user is refused too
T NOBODY
K TAB
T Retro1986
K ENTER
S L5
# the right one: the focus is on the password after a refusal
K STAB BS BS BS BS BS BS BS
T ADMIN
K TAB
T Retro1986
K ENTER
S L6
K ALT-F X
