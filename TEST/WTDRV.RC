/*
 * WTDRV.RC - the resources of the Windows test driver's test,
 * TEST/WTDRV.C.
 */
#include <windows.h>
#include "WTDRV.H"

WTD_M_MAIN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Dialog...", WTD_C_DIALOG
        MENUITEM "&Work\tF5", WTD_C_WORK
        MENUITEM SEPARATOR
        MENUITEM "E&xit", WTD_C_EXIT
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Marked\tCtrl+K", WTD_C_MARK
        MENUITEM "&Gray", WTD_C_GRAY, GRAYED
    END
END

WTD_A_MAIN ACCELERATORS
BEGIN
    VK_F5, WTD_C_WORK, VIRTKEY
    "K", WTD_C_MARK, VIRTKEY, CONTROL
END

WTD_D_MAIN DIALOG 20, 20, 180, 104
STYLE WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_VISIBLE
CAPTION "WTDRV"
MENU WTD_M_MAIN
FONT 8, "Helv"
BEGIN
    LTEXT "&Name:", -1, 8, 10, 30, 8
    EDITTEXT WTD_NAME, 40, 8, 80, 12, ES_AUTOHSCROLL
    CONTROL "&Loaned", WTD_LOANED, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 40, 24, 60, 10
    LISTBOX WTD_LIST, 8, 40, 112, 56, LBS_SORT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "&Add", WTD_ADD, 128, 8, 44, 14
    PUSHBUTTON "A&bout...", WTD_ABOUT, 128, 26, 44, 14
END

WTD_D_ABOUT DIALOG 40, 40, 140, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About WTDRV"
FONT 8, "Helv"
BEGIN
    LTEXT "&Password:", -1, 8, 10, 40, 8
    EDITTEXT WTD_PASS, 50, 8, 80, 12, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 20, 36, 40, 14
    PUSHBUTTON "Cancel", IDCANCEL, 80, 36, 40, 14
END
