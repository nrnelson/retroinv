* Every record's key of expression E, then the index KXnnn.NDX on it.
PROCEDURE KXALL
N = N + 1
? T + " " + E
GO TOP
DO WHILE .NOT. EOF()
  DO KXKEY
  SKIP
ENDDO
IX = "KX" + RIGHT(STR(1000 + N, 4), 3)
INDEX ON &E TO &IX
SET INDEX TO
? "I " + IX
RETURN

* The key of expression E for record 1.
PROCEDURE KXONE
? T + " " + E
GO TOP
DO KXKEY
RETURN

* One "K" line for the current record, unless E failed.
PROCEDURE KXKEY
BAD = .F.
K = &E
IF .NOT. BAD
  ? "K" + STR(RECNO(), 4) + STR(LEN(K), 4) + " [" + K + "]"
ENDIF
RETURN

* ON ERROR handler: note the error and go on.
PROCEDURE KXERR
? "ERR" + STR(ERROR(), 4) + " " + MESSAGE()
BAD = .T.
RETURN
