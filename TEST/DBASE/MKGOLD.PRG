* BIG: 300 records, enough for indexes with two levels.  BIG2.NDX is
* created on the empty table and kept up to date by every APPEND (page
* splits on insert, keys arriving out of order); BIG1.NDX and BIG3.NDX
* are built afterwards in one pass by INDEX ON.  BIG3 has a date key.
USE STRU
ZAP
APPEND BLANK
REPLACE FIELD_NAME WITH "ID", FIELD_TYPE WITH "N", FIELD_LEN WITH 8, FIELD_DEC WITH 0
APPEND BLANK
REPLACE FIELD_NAME WITH "NAME", FIELD_TYPE WITH "C", FIELD_LEN WITH 10, FIELD_DEC WITH 0
APPEND BLANK
REPLACE FIELD_NAME WITH "D", FIELD_TYPE WITH "D", FIELD_LEN WITH 8, FIELD_DEC WITH 0
USE
CREATE BIG FROM STRU
USE BIG
INDEX ON NAME TO BIG2
I = 1
DO WHILE I <= 300
  APPEND BLANK
  REPLACE ID WITH I, NAME WITH "N" + STR(MOD(I * 37, 301), 3)
  REPLACE D WITH CTOD("01/01/80") + I * 10
  I = I + 1
ENDDO
INDEX ON STR(ID,8) TO BIG1
INDEX ON D TO BIG3
CLOSE DATABASES
* NUM2000 and NUM993: STR(ID,8) over 2000 and 993 records.  INDEX ON
* writes pages bottom-up as they fill and folds a trailing single-child
* level into its parent, so these trees are three levels deep with
* leaves at different depths.
USE STRU
ZAP
APPEND BLANK
REPLACE FIELD_NAME WITH "ID", FIELD_TYPE WITH "N", FIELD_LEN WITH 8, FIELD_DEC WITH 0
USE
CREATE NUM2000 FROM STRU
USE NUM2000
I = 1
DO WHILE I <= 2000
  APPEND BLANK
  REPLACE ID WITH I
  I = I + 1
ENDDO
GO TOP
COPY NEXT 993 TO NUM993
INDEX ON STR(ID,8) TO NUM2000
USE NUM993
INDEX ON STR(ID,8) TO NUM993
CLOSE DATABASES
* WIDE: 60 records with a 100-character key, so a page holds only 4
* keys.  Records 30 to 37 share one key value.  WIDE1.NDX is built by
* INDEX ON.  WIDED is a copy whose index WIDED1.NDX then sees keys
* removed: records 1 to 16 (the first four leaves, all but the last
* child of their parent) and the run of equal keys get new values that
* sort last, so dBASE deletes each old key and inserts the new one.  That
* leaves emptied pages outside the tree and an inner page with no key
* and a single child.
USE STRU
ZAP
APPEND BLANK
REPLACE FIELD_NAME WITH "NAME", FIELD_TYPE WITH "C", FIELD_LEN WITH 100, FIELD_DEC WITH 0
USE
CREATE WIDE FROM STRU
USE WIDE
I = 1
DO WHILE I <= 60
  APPEND BLANK
  IF I >= 30 .AND. I <= 37
    REPLACE NAME WITH "N DUP"
  ELSE
    REPLACE NAME WITH "N" + STR(I, 3)
  ENDIF
  I = I + 1
ENDDO
COPY TO WIDED
INDEX ON NAME TO WIDE1
USE WIDED
INDEX ON NAME TO WIDED1
I = 1
DO WHILE I <= 16
  GO I
  REPLACE NAME WITH "Z" + STR(I, 3)
  I = I + 1
ENDDO
I = 30
DO WHILE I <= 37
  GO I
  REPLACE NAME WITH "Z" + STR(I, 3)
  I = I + 1
ENDDO
CLOSE DATABASES
ERASE STRU.DBF
SET ALTERNATE TO OUT
