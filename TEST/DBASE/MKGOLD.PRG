USE ITEMS
APPEND BLANK
REPLACE ITEM_ID WITH 1, CATEGORY WITH "SYS", ITEMTYPE WITH "DESKTOP"
REPLACE MFR WITH "IBM", MODEL WITH "5160 PC XT", SERIALNO WITH "0123456"
